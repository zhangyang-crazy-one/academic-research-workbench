#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: arw <command> [options]

Commands:
  health --json  Verify the installed Python package and runtime.
  route --json   Emit the installed read-only ARS workflow route.
  version --json Report the installed packaged build identity.
  files          Administer registered roots and immutable file generations.
  writing        Prepare and record source-bound manuscript revisions.
  narrative      Register and select a fixed project paper argument strategy.
  semantic       Query an explicitly built, optional semantic projection.
  learn          Evaluate and explicitly promote evidence-bound research lessons.
  memory         Save, recall, and hand off canonical project context.
  provenance     Operate the opt-in Semantica-compatible Lite sidecar.
  orchestration-prepare/orchestration-dispatch
                 Prepare or dispatch parent-owned Phase 4 assignments.
  orchestration-panel/orchestration-gate/orchestration-hook/orchestration-recover
                 Record Phase 4 panel, gate, hook, and recovery evidence.
  storm          Run the opt-in STORM deep-research pipeline (needs the
                 optional knowledge-storm dependency group).
  init/append/replay/status and Phase 2 runtime commands are forwarded to arw.cli.
  help           Show this help text.
EOF
}

fail() {
  local error_type="$1"
  local message="$2"
  local status="${3:-70}"
  if [[ "${ARW_JSON_DIAGNOSTIC:-0}" == "1" ]]; then
    local action
    case "$error_type" in
      bootstrap-config) action="set HOME or CODEX_HOME before running ARW" ;;
      runtime-artifact-missing) action="install a qualified plugin stage containing the ARW wheel" ;;
      interpreter-*|incompatible-interpreter) action="select an executable Python >=3.13 interpreter" ;;
      bootstrap-install-failed) action="check the configured package index and retry runtime installation" ;;
      *) action="repair the installed ARW runtime and retry" ;;
    esac
    printf '{"schema_version":"arw.files-opt-in.v1","status":"rejected","reason_code":"%s","action":"%s"}\n' \
      "${error_type//-/_}" "$action"
    exit "$status"
  fi
  printf 'arw: %s: %s\n' "$error_type" "$message" >&2
  exit "$status"
}

if [[ $# -eq 0 || "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
  health|route|version|files|writing|narrative|semantic|learn|memory|submission|_memory-mcp|artifact|citation|pdf|provenance|_files-mcp|_files-store-mcp|_graph-mcp|storm|init|append|replay|status|transition|decision-request|decision-resolve|attempt-start|attempt-close|artifact-accept|checkpoint|resume|recover|passport-pointer-rebuild|orchestration-prepare|orchestration-dispatch|orchestration-panel|orchestration-gate|orchestration-hook|orchestration-recover|execution-context|execution-metadata|execution-bind|execution-provenance) ;;
  *)
    fail "unknown-command" "unsupported command: $COMMAND" 64
    ;;
esac

SCRIPT_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd -P -- "$SCRIPT_DIR/.." && pwd)"

# Runtime mode is an explicit gate. Unset / plugin / codex stay fail-closed on
# the staged first-party wheel. agent / local-dev may use an editable checkout
# interpreter; they never qualify a Codex release and do not invent host canary
# evidence. bin/arw-agent is a checkout-only wrapper that sets ARW_RUNTIME=agent.
ARW_RUNTIME_MODE="plugin"
REQUESTED_RUNTIME="${ARW_RUNTIME:-}"
if [[ "$(basename -- "${BASH_SOURCE[0]}")" == "arw-agent" ]]; then
  REQUESTED_RUNTIME="${REQUESTED_RUNTIME:-agent}"
fi
case "$REQUESTED_RUNTIME" in
  ""|plugin|codex)
    ARW_RUNTIME_MODE="plugin"
    ;;
  agent|local-dev)
    ARW_RUNTIME_MODE="agent"
    ;;
  *)
    printf 'arw: bootstrap-config: ARW_RUNTIME must be unset, plugin, agent, or local-dev\n' >&2
    exit 78
    ;;
esac
export ARW_RUNTIME_MODE
if [[ "$ARW_RUNTIME_MODE" == "agent" ]]; then
  export ARW_RUNTIME="${ARW_RUNTIME:-agent}"
fi

ARW_JSON_DIAGNOSTIC=0
if [[ "$ARW_RUNTIME_MODE" != "agent" && ( ( "$COMMAND" == "health" && "${1:-}" == "--json" ) || ( "$COMMAND" == "files" && "${1:-}" == "enable" ) ) ]]; then
  ARW_JSON_DIAGNOSTIC=1
fi
if [[ "$ARW_RUNTIME_MODE" == "plugin" && -n "${ARW_PLUGIN_ROOT:-}" && "$ARW_PLUGIN_ROOT" != "$PLUGIN_ROOT" ]]; then
  fail "plugin-root-mismatch" "installed plugin root differs from launcher root" 65
fi
if [[ "$ARW_RUNTIME_MODE" == "agent" && -d "$PLUGIN_ROOT/share/arw/wheels" ]]; then
  fail "agent-runtime-invalid" "agent mode requires an editable source checkout" 65
fi

# A source checkout in plugin mode has no staged wheel. Keep the opt-in preflight and health
# available there so a missing native binary is reported as JSON before any
# runtime bootstrap attempt. The installed package continues below.
if [[ "$ARW_RUNTIME_MODE" != "agent" && -f "$PLUGIN_ROOT/src/arw/files_opt_in.py" && ! -d "$PLUGIN_ROOT/share/arw/wheels" ]]; then
  if [[ "$COMMAND" == "health" || ( "$COMMAND" == "files" && "${1:-}" == "enable" ) ]]; then
    SOURCE_PYTHON=""
    if [[ -n "${ARW_PYTHON:-}" ]]; then
      source_candidates=("$ARW_PYTHON")
    else
      source_candidates=("$PLUGIN_ROOT/.venv/bin/python" python3.15 python3.14 python3.13 python3 python)
    fi
    for candidate in "${source_candidates[@]}"; do
      resolved="$(command -v -- "$candidate" 2>/dev/null || true)"
      if [[ -n "$resolved" ]] && "$resolved" -I -S -c 'import sys; raise SystemExit(0 if sys.version_info[:2] >= (3, 13) else 1)' 2>/dev/null; then
        SOURCE_PYTHON="$resolved"
        break
      fi
    done
    if [[ -z "$SOURCE_PYTHON" ]]; then
      printf '{"schema_version":"arw.files-opt-in.v1","status":"rejected","reason_code":"runtime_unsupported","message":"Python 3.13 or newer is required"}\n'
      exit 65
    fi
    unset PYTHONHOME
    export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
    export PYTHONPATH="$PLUGIN_ROOT/src"
    export PYTHONNOUSERSITE=1
    if [[ "$COMMAND" == "health" ]]; then
      exec "$SOURCE_PYTHON" -m arw.files_opt_in health "$@"
    fi
    shift
    exec "$SOURCE_PYTHON" -m arw.files_opt_in enable "$@"
  fi
fi

python_is_supported() {
  local candidate="$1"
  [[ -n "$candidate" && -x "$candidate" ]] || return 1
  "$candidate" -I -S -c 'import sys; raise SystemExit(0 if sys.version_info[:2] >= (3, 13) else 1)' 2>/dev/null
}

python_has_arw() {
  local candidate="$1"
  python_is_supported "$candidate" || return 1
  "$candidate" -I -c 'import importlib.metadata as m; raise SystemExit(0 if m.version("academic-research-workbench") else 1)' 2>/dev/null
}

select_python() {
  local candidate resolved
  if [[ -n "${ARW_PYTHON:-}" ]]; then
    candidate="$(command -v -- "$ARW_PYTHON" 2>/dev/null || true)"
    [[ -n "$candidate" ]] || fail "interpreter-not-found" "ARW_PYTHON is not executable" 78
    if ! python_is_supported "$candidate"; then
      fail "incompatible-interpreter" "ARW_PYTHON must be Python >=3.13" 78
    fi
    printf '%s\n' "$candidate"
    return
  fi

  for candidate in python3 python; do
    resolved="$(command -v -- "$candidate" 2>/dev/null || true)"
    if python_is_supported "$resolved"; then
      printf '%s\n' "$resolved"
      return
    fi
  done

  # Some hosts expose only versioned commands (for example python3.14) while
  # generic python/python3 shims still point below the supported floor. Scan
  # discovered names instead of maintaining a Python-version allowlist.
  while IFS= read -r candidate; do
    resolved="$(command -v -- "$candidate" 2>/dev/null || true)"
    if python_is_supported "$resolved"; then
      printf '%s\n' "$resolved"
      return
    fi
  done < <(compgen -c | awk '/^python3\.[0-9]+$/ { print }' | sort -u -r)

  fail "interpreter-not-found" "Python >=3.13 is required" 78
}

select_agent_python() {
  local candidate resolved
  if [[ -n "${ARW_PYTHON:-}" ]]; then
    candidate="$(command -v -- "$ARW_PYTHON" 2>/dev/null || true)"
    [[ -n "$candidate" ]] || fail "interpreter-not-found" "ARW_PYTHON is not executable" 78
    if ! python_is_supported "$candidate"; then
      fail "incompatible-interpreter" "ARW_PYTHON must be Python >=3.13" 78
    fi
    if ! python_has_arw "$candidate"; then
      fail "agent-runtime-missing" "ARW_PYTHON does not provide the academic-research-workbench package" 66
    fi
    printf '%s\n' "$candidate"
    return 0
  fi

  candidate="$PLUGIN_ROOT/.venv/bin/python"
  if python_has_arw "$candidate"; then
    printf '%s\n' "$candidate"
    return 0
  fi

  for candidate in python3 python; do
    resolved="$(command -v -- "$candidate" 2>/dev/null || true)"
    if python_has_arw "$resolved"; then
      printf '%s\n' "$resolved"
      return 0
    fi
  done

  while IFS= read -r candidate; do
    resolved="$(command -v -- "$candidate" 2>/dev/null || true)"
    if python_has_arw "$resolved"; then
      printf '%s\n' "$resolved"
      return 0
    fi
  done < <(compgen -c | awk '/^python3\.[0-9]+$/ { print }' | sort -u -r)

  return 1
}

locate_staged_wheel() {
  local wheel_dir="$PLUGIN_ROOT/share/arw/wheels"
  local wheel
  [[ -d "$wheel_dir" && ! -L "$wheel_dir" ]] || return 1
  wheel="$(find "$wheel_dir" -maxdepth 1 -type f -name 'academic_research_workbench-*.whl' -print -quit)"
  [[ -n "$wheel" && ! -L "$wheel" ]] || return 1
  printf '%s\n' "$wheel"
}

resolve_codex_home() {
  local home="${CODEX_HOME:-}"
  if [[ -z "$home" ]]; then
    [[ -n "${HOME:-}" ]] \
      || fail "bootstrap-config" "CODEX_HOME is unset and HOME is unavailable to resolve the default Codex directory" 78
    home="$HOME/.codex"
  fi
  printf '%s\n' "$home"
}

bootstrap_wheel_runtime() {
  local wheel_path arw_codex_home
  wheel_path="${1:-}"
  [[ -n "$wheel_path" ]] || fail "runtime-artifact-missing" "staged ARW wheel is missing or unsafe" 66
  arw_codex_home="$(resolve_codex_home)"
  WHEEL_PATH="$(cd -P -- "$(dirname -- "$wheel_path")" && pwd)"
  ARW_WHEEL="$wheel_path"

  if PYTHON="$(select_python)"; then
    :
  else
    status=$?
    if [[ "${ARW_JSON_DIAGNOSTIC:-0}" == "1" && "$PYTHON" == \{* ]]; then
      printf '%s\n' "$PYTHON"
    fi
    exit "$status"
  fi
  PYTHON_VERSION="$("$PYTHON" -I -S -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')" \
    || fail "interpreter-failed" "selected Python could not report its version" 78
  if ! python_is_supported "$PYTHON"; then
    fail "incompatible-interpreter" "requires Python >=3.13; got $PYTHON_VERSION" 78
  fi

  unset PYTHONPATH PYTHONHOME
  export PYTHONNOUSERSITE=1
  export PIP_DISABLE_PIP_VERSION_CHECK=1

  RUNTIME_IDENTITY="$("$PYTHON" -I -S - "$PLUGIN_ROOT" "$WHEEL_PATH" <<'PY'
from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path


plugin_root = Path(sys.argv[1]).resolve()
wheel_dir = Path(sys.argv[2]).resolve()
def sha(path):
    value = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            value.update(block)
    return value.hexdigest()

def object_at(relative):
    path = plugin_root / relative
    if path.is_symlink() or not path.is_file():
        raise SystemExit(f"staged metadata is missing or unsafe: {relative}")
    value = json.loads(path.read_bytes())
    if not isinstance(value, dict):
        raise SystemExit(f"staged metadata is malformed: {relative}")
    return value

inventory = object_at("supply-chain/stage-inventory.json")
identity = object_at("share/arw/build-identity.json")
actual = set()
for path in plugin_root.rglob("*"):
    if path.is_symlink():
        raise SystemExit("staged tree contains a symlink")
    if path.is_file():
        actual.add(path.relative_to(plugin_root).as_posix())
    elif not path.is_dir():
        raise SystemExit("staged tree contains a special file")
if inventory.get("files") != sorted(actual) or inventory.get("symlinks") != []:
    raise SystemExit("staged closed inventory differs from live files")
covered = inventory.get("covered_files")
if not isinstance(covered, list) or {row.get("path") for row in covered if isinstance(row, dict)} != actual - {"supply-chain/stage-inventory.json"}:
    raise SystemExit("staged coverage inventory is incomplete")
for row in covered:
    if not isinstance(row, dict) or row.get("sha256") != sha(plugin_root / row["path"]):
        raise SystemExit("staged coverage digest differs")
payloads = identity.get("staged_payloads")
if not isinstance(payloads, list) or {row.get("path") for row in payloads if isinstance(row, dict)} != actual - {"share/arw/build-identity.json", "supply-chain/stage-inventory.json"}:
    raise SystemExit("build identity payload coverage is incomplete")
for row in payloads:
    if not isinstance(row, dict) or row.get("sha256") != sha(plugin_root / row["path"]):
        raise SystemExit("build identity payload digest differs")
wheels = tuple(sorted(wheel_dir.glob("academic_research_workbench-*.whl")))
if len(wheels) != 1 or wheels[0].is_symlink() or not wheels[0].is_file():
    raise SystemExit("staged first-party ARW wheel is missing or ambiguous")
if not wheels[0].resolve().is_relative_to(plugin_root):
    raise SystemExit("staged ARW wheel escapes the plugin root")
digest = hashlib.sha256()
with wheels[0].open("rb") as stream:
    for block in iter(lambda: stream.read(1024 * 1024), b""):
        digest.update(block)
observed = digest.hexdigest()
identity_path = plugin_root / "share/arw/build-identity.json"
try:
    binding = identity["runtime_artifact"]["first_party_wheel"]
    if binding["path"] != wheels[0].relative_to(plugin_root).as_posix() or binding["sha256"] != observed:
        raise ValueError("staged wheel differs from declared build identity")
except (OSError, ValueError, KeyError, TypeError) as error:
    raise SystemExit(f"staged wheel binding is invalid: {error}") from error
candidate = object_at("share/arw/evidence/candidate-build.json")
license_inventory = object_at("share/arw/evidence/license-inventory.json")
sbom = object_at("SBOM.cdx.json")
if license_inventory.get("build_evidence", {}).get("sha256") != sha(plugin_root / "share/arw/evidence/candidate-build.json"):
    raise SystemExit("staged license inventory does not bind candidate build")
if license_inventory.get("build_observation") != candidate.get("build") or license_inventory.get("runtime_resolution_environment") != candidate.get("runtime_resolution_environment"):
    raise SystemExit("staged license inventory build observation differs")
candidate_wheels = [row for row in candidate.get("artifacts", []) if row.get("kind") == "wheel"]
if len(candidate_wheels) != 1 or candidate_wheels[0].get("sha256") != observed or Path(candidate_wheels[0].get("path", "")).name != wheels[0].name:
    raise SystemExit("staged candidate wheel identity differs")
if license_inventory.get("first_party_wheel", {}).get("sha256") != observed:
    raise SystemExit("staged license inventory wheel identity differs")
components = sbom.get("components", [])
if not isinstance(components, list) or not all(isinstance(row, dict) for row in components):
    raise SystemExit("staged SBOM components are malformed")
lock_path = plugin_root / "supply-chain/integration-lock.json"
lock_rows = [row for row in components if row.get("bom-ref") == "artifact:supply-chain/integration-lock.json"]
if lock_path.is_file() and (len(lock_rows) != 1 or lock_rows[0].get("hashes") != [{"alg": "SHA-256", "content": sha(lock_path)}]):
    raise SystemExit("staged SBOM does not bind integration lock")
print(observed)
PY
)" || fail "runtime-artifact-invalid" "staged ARW wheel could not be verified" 65

  local runtime_parent runtime_root complete_marker lock_dir acquired temp_root
  runtime_parent="$arw_codex_home/arw/runtime"
  runtime_root="$runtime_parent/$RUNTIME_IDENTITY"
  RUNTIME_PYTHON="$runtime_root/venv/bin/python"
  complete_marker="$runtime_root/completed"
  lock_dir="$runtime_root.lock"
  INTERPRETER_SOURCE="staged-wheel"

  mkdir -p "$runtime_parent"

  runtime_ready() {
    [[ -x "$RUNTIME_PYTHON" && -f "$complete_marker" ]] \
      && [[ "$(tr -d '\n' < "$complete_marker")" == "$RUNTIME_IDENTITY" ]]
  }

  if ! runtime_ready; then
    acquired=0
    for _ in $(seq 1 120); do
      if mkdir "$lock_dir" 2>/dev/null; then
        acquired=1
        break
      fi
      sleep 0.25
    done
    [[ "$acquired" -eq 1 ]] || fail "bootstrap-lock-timeout" "timed out waiting for runtime lock" 75

    temp_root="$runtime_parent/$RUNTIME_IDENTITY.tmp.$$"
    cleanup() {
      rm -rf -- "$temp_root"
      rmdir "$lock_dir" 2>/dev/null || true
    }
    trap cleanup EXIT INT TERM

    if ! runtime_ready; then
      rm -rf -- "$runtime_root" "$temp_root"
      "$PYTHON" -I -m venv "$temp_root/venv" \
        || fail "bootstrap-venv-failed" "could not create the cache-local runtime" 70
      "$temp_root/venv/bin/python" -I -m pip install \
        --quiet \
        "$ARW_WHEEL" \
        || fail "bootstrap-install-failed" "could not resolve ARW dependencies from the configured package index" 70
      printf '%s\n' "$RUNTIME_IDENTITY" > "$temp_root/completed.tmp"
      mv "$temp_root/completed.tmp" "$temp_root/completed"
      mv "$temp_root" "$runtime_root"
    fi

    trap - EXIT INT TERM
    rmdir "$lock_dir"
  fi
}

bind_agent_python() {
  local candidate
  candidate="$(select_agent_python)" || return 1
  unset PYTHONPATH PYTHONHOME
  export PYTHONNOUSERSITE=1
  export PIP_DISABLE_PIP_VERSION_CHECK=1
  RUNTIME_PYTHON="$candidate"
  INTERPRETER_SOURCE="checkout-venv"
  if [[ -n "${ARW_PYTHON:-}" ]]; then
    INTERPRETER_SOURCE="arw-python"
  elif [[ "$candidate" != "$PLUGIN_ROOT/.venv/bin/python" ]]; then
    INTERPRETER_SOURCE="path-python"
  fi
  RUNTIME_IDENTITY="$($RUNTIME_PYTHON - "$PLUGIN_ROOT" "$INTERPRETER_SOURCE" <<'PY'
from __future__ import annotations

import hashlib
import importlib.metadata
import sys
from pathlib import Path

plugin_root = Path(sys.argv[1]).resolve()
source = sys.argv[2]
version = importlib.metadata.version("academic-research-workbench")
digest = hashlib.sha256()
digest.update(b"arw-agent-runtime\n")
digest.update(str(plugin_root).encode())
digest.update(b"\n")
digest.update(source.encode())
digest.update(b"\n")
digest.update(version.encode())
digest.update(b"\n")
digest.update(sys.executable.encode())
print(digest.hexdigest())
PY
)" || fail "agent-runtime-missing" "agent interpreter could not report a runtime identity" 66
}

STAGED_WHEEL=""
if STAGED_WHEEL="$(locate_staged_wheel)"; then
  :
else
  STAGED_WHEEL=""
fi

INTERPRETER_SOURCE=""
if [[ "$ARW_RUNTIME_MODE" == "plugin" ]]; then
  # Production / staged plugin: fail closed unless the first-party wheel is
  # present. An editable checkout .venv is never a substitute here.
  ARW_CODEX_HOME="$(resolve_codex_home)"
  WHEEL_PATH="$PLUGIN_ROOT/share/arw/wheels"
  [[ -d "$WHEEL_PATH" && ! -L "$WHEEL_PATH" ]] \
    || fail "runtime-artifact-missing" "staged ARW wheel directory is missing or unsafe" 66
  [[ -n "$STAGED_WHEEL" ]] \
    || fail "runtime-artifact-missing" "staged ARW wheel is missing or unsafe" 66
  bootstrap_wheel_runtime "$STAGED_WHEEL"
elif ! bind_agent_python; then
  if [[ -n "$STAGED_WHEEL" ]]; then
    bootstrap_wheel_runtime "$STAGED_WHEEL"
  else
    fail "agent-runtime-missing" "agent mode needs checkout .venv with academic-research-workbench installed, ARW_PYTHON pointing at that interpreter, or a staged first-party wheel" 66
  fi
fi
if [[ "$ARW_RUNTIME_MODE" == "agent" && -d "$PLUGIN_ROOT/src/arw" ]]; then
  # Editable checkout self-use imports this checkout's code, so its
  # UNVERIFIED state cannot be borrowed by an unrelated installed wheel.
  export PYTHONPATH="$PLUGIN_ROOT/src:$PLUGIN_ROOT/extensions/ars/src:$PLUGIN_ROOT/extensions/local-store/src:$PLUGIN_ROOT/extensions/semantica/src:$PLUGIN_ROOT/extensions/artifact-integrity/src:$PLUGIN_ROOT/extensions/research-artifact/src:$PLUGIN_ROOT/extensions/research-memory/src:$PLUGIN_ROOT/extensions/research-learning/src:$PLUGIN_ROOT/extensions/academic-humanization/src:$PLUGIN_ROOT/extensions/submission-workflow/src"
fi

SCHEMA_ROOT="$PLUGIN_ROOT/share/arw/schemas"
if [[ "$ARW_RUNTIME_MODE" == "plugin" ]]; then
  export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
  export PYTHONDONTWRITEBYTECODE=1
  # Use a fresh bytecode lookup namespace so cached package .pyc files cannot
  # run before the wheel-content check. No bytecode is written in this mode.
  ARW_FRESH_PYCACHE_PREFIX="${TMPDIR:-/tmp}/arw-pycache-$$-$RANDOM-$RANDOM"
  "$PYTHON" -I -S - "$RUNTIME_PYTHON" "$STAGED_WHEEL" "$PYTHON" <<'PY' || fail "core-integrity-invalid" "cached interpreter, configuration, or first-party runtime differs from the selected Python and staged wheel; clear the ARW runtime cache and retry" 65
import hashlib
import os
import sys
import zipfile
from pathlib import Path

cached_python = Path(sys.argv[1]).absolute()
venv_root = cached_python.parent.parent
selected_python = Path(sys.argv[3]).absolute()
if venv_root.is_symlink() or cached_python.parent.is_symlink() or venv_root.parent.is_symlink():
    raise SystemExit("cached runtime path contains a symlinked directory")
try:
    selected_real = selected_python.resolve(strict=True)
    cached_real = cached_python.resolve(strict=True)
except (OSError, RuntimeError) as error:
    raise SystemExit("cached or selected interpreter cannot be resolved") from error
if not selected_real.is_file() or not os.access(selected_real, os.X_OK):
    raise SystemExit("selected interpreter is not executable")
if cached_python.is_symlink():
    if cached_real != selected_real:
        raise SystemExit("cached interpreter symlink targets a different executable")
elif not cached_python.is_file() or hashlib.sha256(cached_python.read_bytes()).digest() != hashlib.sha256(selected_real.read_bytes()).digest():
    raise SystemExit("cached interpreter differs from selected executable")
cfg_path = venv_root / "pyvenv.cfg"
if cfg_path.is_symlink() or not cfg_path.is_file():
    raise SystemExit("cached runtime configuration is missing or unsafe")
cfg = {}
for line in cfg_path.read_text(encoding="utf-8").splitlines():
    if "=" in line:
        key, value = (part.strip() for part in line.split("=", 1))
        if key in cfg:
            raise SystemExit("cached runtime configuration repeats a key")
        cfg[key] = value
if cfg.get("include-system-site-packages", "").lower() != "false":
    raise SystemExit("cached runtime enables system site packages")
if not cfg.get("executable") or Path(cfg["executable"]).resolve() != selected_real:
    raise SystemExit("cached runtime declares a different base executable")
if not cfg.get("home") or Path(cfg["home"]).resolve() != Path(sys._base_executable).resolve().parent:
    raise SystemExit("cached runtime declares a different base home")
site_dirs = sorted((venv_root / "lib").glob("python*/site-packages"))
if len(site_dirs) != 1 or not site_dirs[0].is_dir() or site_dirs[0].is_symlink():
    raise SystemExit("cached runtime site-packages directory is missing")
purelib = site_dirs[0]
for pth in purelib.glob("*.pth"):
    if pth.is_symlink() or any(line.lstrip().startswith(("import ", "import\t")) for line in pth.read_text(encoding="utf-8").splitlines()):
        raise SystemExit("cached runtime contains executable path startup code")
expected = set()
with zipfile.ZipFile(sys.argv[2]) as wheel:
    for member in wheel.infolist():
        if member.is_dir() or member.filename.endswith(".dist-info/RECORD"):
            continue
        relative = Path(member.filename)
        target = purelib / relative
        if relative.is_absolute() or ".." in relative.parts or any(part.is_symlink() for part in (target, *target.parents) if part.is_relative_to(purelib)) or not target.is_file() or target.read_bytes() != wheel.read(member):
            raise SystemExit("cached first-party package differs from staged wheel")
        expected.add(relative.as_posix())
    for top in {name.split("/", 1)[0] for name in expected if "/" in name}:
        if top.endswith(".dist-info"):
            continue
        if (purelib / top).is_symlink():
            raise SystemExit("cached first-party package root is a symlink")
        for path in (purelib / top).rglob("*"):
            if "__pycache__" in path.parts:
                if path.is_symlink():
                    raise SystemExit("cached bytecode path is a symlink")
                continue
            if path.is_symlink() or (path.is_file() and path.relative_to(purelib).as_posix() not in expected):
                raise SystemExit("cached first-party package has an undeclared file")
PY
  if [[ "$COMMAND" != "route" && "$COMMAND" != "version" ]]; then
  "$RUNTIME_PYTHON" -I -B -X "pycache_prefix=$ARW_FRESH_PYCACHE_PREFIX" - "$RUNTIME_PYTHON" <<'PY' || fail "core-integrity-invalid" "staged core integrity or runtime origin check failed" 65
import sys
from pathlib import Path
import arw
from arw.kernel.policy.core_integrity import installed_core_preflight
runtime = Path(sys.argv[1]).absolute().parents[2]
if not Path(arw.__file__).resolve().is_relative_to(runtime):
    raise SystemExit("ARW module did not load from the staged-wheel runtime")
status, _ = installed_core_preflight()
if status != "PASS":
    raise SystemExit("staged core integrity is not PASS")
PY
  fi
fi
PYTHON_FLAGS=()
if [[ "$ARW_RUNTIME_MODE" == "plugin" ]]; then
  PYTHON_FLAGS=(-I -B -X "pycache_prefix=$ARW_FRESH_PYCACHE_PREFIX")
fi
FILES_CONTRACT_HEADER="$PLUGIN_ROOT/share/arw/file-contracts.h"
BUILD_IDENTITY="$PLUGIN_ROOT/share/arw/build-identity.json"
if [[ "$ARW_RUNTIME_MODE" == "agent" ]]; then
  if [[ ! -d "$SCHEMA_ROOT" || -L "$SCHEMA_ROOT" ]] && [[ -d "$PLUGIN_ROOT/schemas/v1" && ! -L "$PLUGIN_ROOT/schemas/v1" ]]; then
    SCHEMA_ROOT="$PLUGIN_ROOT/schemas/v1"
  fi
  if [[ ! -f "$FILES_CONTRACT_HEADER" || -L "$FILES_CONTRACT_HEADER" ]] && [[ -f "$PLUGIN_ROOT/generated/file-contracts.h" && ! -L "$PLUGIN_ROOT/generated/file-contracts.h" ]]; then
    FILES_CONTRACT_HEADER="$PLUGIN_ROOT/generated/file-contracts.h"
  fi
fi

case "$COMMAND" in
  health)
    [[ "${1:-}" == "--json" && $# -eq 1 ]] || fail "usage" "health requires --json" 64
    if [[ "$ARW_RUNTIME_MODE" == "agent" ]]; then
      exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" - "$RUNTIME_IDENTITY" "$INTERPRETER_SOURCE" <<'PY'
import importlib.metadata
import json
import platform
import sys

if importlib.metadata.version("academic-research-workbench") != "0.1.0":
    raise SystemExit("installed package version mismatch")

json.dump(
    {
        "command": "health",
        "interpreter_source": sys.argv[2],
        "python": platform.python_version(),
        "runtime_identity": sys.argv[1],
        "runtime_mode": "agent",
        "status": "ok",
    },
    sys.stdout,
    sort_keys=True,
    separators=(",", ":"),
)
sys.stdout.write("\n")
PY
    fi
    # The installed wheel cannot infer its plugin bundle from __file__. Bind
    # the launcher root while leaving explicit roots to files_opt_in validation.
    export ARW_PLUGIN_ROOT="${ARW_PLUGIN_ROOT:-$PLUGIN_ROOT}"
    exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" - "$RUNTIME_IDENTITY" <<'PY'
import importlib.metadata
import json
import platform
import sys
from arw.files_opt_in import health
from arw.platform_support import platform_support


if importlib.metadata.version("academic-research-workbench") != "0.1.0":
    raise SystemExit("installed package version mismatch")

json.dump(
    {
        "command": "health",
        "python": platform.python_version(),
        "runtime_identity": sys.argv[1],
        "status": "ok",
        "file_base": health(),
        "platform": platform_support(),
    },
    sys.stdout,
    sort_keys=True,
    separators=(",", ":"),
)
sys.stdout.write("\n")
PY
    ;;
  route)
    # Keep the staged lock discoverable while remaining fail-closed. Host
    # canary evidence is intentionally not fabricated or inferred here; the
    # Python verifier requires the retained exact evidence and rejects drift.
    export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
    exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" -m arw.cli route "$@"
    ;;
  version)
    export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
    export ARW_BUILD_IDENTITY="$PLUGIN_ROOT/share/arw/build-identity.json"
    export ARW_SCHEMA_ROOT="$PLUGIN_ROOT/share/arw/schemas"
    if [[ "$ARW_RUNTIME_MODE" == "agent" && ( ! -f "$BUILD_IDENTITY" || -L "$BUILD_IDENTITY" ) ]]; then
      [[ "${1:-}" == "--json" && $# -eq 1 ]] || fail "usage" "version requires --json" 64
      exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" - <<'PY'
import importlib.metadata
import json
import sys

json.dump(
    {
        "command": "version",
        "identity_source": "editable-checkout",
        "package_version": importlib.metadata.version("academic-research-workbench"),
        "runtime_mode": "agent",
        "schema_version": "1.0.0",
        "status": "ok",
    },
    sys.stdout,
    sort_keys=True,
    separators=(",", ":"),
)
sys.stdout.write("\n")
PY
    fi
    exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" -m arw.cli version "$@"
    ;;
  _memory-mcp)
    [[ -f "$PLUGIN_ROOT/.codex-plugin/plugin.json" ]] || fail "plugin-manifest-missing" "installed plugin manifest is missing" 66
    export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
    export ARW_PLUGIN_MANIFEST="$PLUGIN_ROOT/.codex-plugin/plugin.json"
    exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" -m arw.memory_mcp "$@"
    ;;
  _files-mcp)
    export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
    exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" -m arw.files_mcp "$@"
    ;;
  _files-store-mcp)
    # The store-backed files MCP server inherits the same installed-mode
    # manifest posture as _graph-mcp: refuse to start the server when the
    # bundled manifest is absent so a tampered install cannot silently
    # bypass file capability gating (PR15 follow-up, store-MCP symmetry).
    [[ -f "$PLUGIN_ROOT/.codex-plugin/plugin.json" ]] \
      || fail "plugin-manifest-missing" "installed plugin manifest is missing" 66
    export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
    export ARW_PLUGIN_MANIFEST="$PLUGIN_ROOT/.codex-plugin/plugin.json"
    exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" -m arw.files_store_mcp "$@"
    ;;
  _graph-mcp)
    # The graph MCP server only stays fail-closed when the installed
    # manifest is bound explicitly: in wheel mode the cli.py source-tree
    # fallback would miss and default_router would skip capability gating
    # (PR15 follow-up).  Refuse to start the server if the bundled manifest
    # is missing; a tampered install must not silently gain graph access.
    [[ -f "$PLUGIN_ROOT/.codex-plugin/plugin.json" ]] \
      || fail "plugin-manifest-missing" "installed plugin manifest is missing" 66
    export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
    export ARW_PLUGIN_MANIFEST="$PLUGIN_ROOT/.codex-plugin/plugin.json"
    exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" -m arw.cli _graph-mcp "$@"
    ;;
  writing|semantic|learn|memory|artifact|submission)
    [[ -f "$PLUGIN_ROOT/.codex-plugin/plugin.json" ]] \
      || fail "plugin-manifest-missing" "installed plugin manifest is missing" 66
    export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
    export ARW_PLUGIN_MANIFEST="$PLUGIN_ROOT/.codex-plugin/plugin.json"
    exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" -m arw.cli "$COMMAND" "$@"
    ;;
  files)
    export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
    export ARW_SCHEMA_ROOT="$PLUGIN_ROOT/share/arw/schemas"
    export ARW_FILES_CONTRACT_HEADER="$PLUGIN_ROOT/share/arw/file-contracts.h"
    if [[ "$ARW_RUNTIME_MODE" == "agent" ]]; then
      export ARW_SCHEMA_ROOT="$SCHEMA_ROOT"
      export ARW_FILES_CONTRACT_HEADER="$FILES_CONTRACT_HEADER"
    fi
    exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" -m arw.cli files "$@"
    ;;
  *)
    export ARW_PLUGIN_ROOT="$PLUGIN_ROOT"
    export ARW_SCHEMA_ROOT="$PLUGIN_ROOT/share/arw/schemas"
    if [[ "$ARW_RUNTIME_MODE" == "agent" ]]; then
      export ARW_SCHEMA_ROOT="$SCHEMA_ROOT"
    fi
    exec "$RUNTIME_PYTHON" "${PYTHON_FLAGS[@]}" -m arw.cli "$COMMAND" "$@"
    ;;
esac
