{
  "$id": "https://academic-research-workbench.local/schemas/v1/research-memory-query.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cross_project": {
      "default": false,
      "title": "Cross Project",
      "type": "boolean"
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "context",
            "handoff",
            "decision_note",
            "lesson",
            "blocker",
            "experiment_note",
            "source_note",
            "reproduction_note"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kind"
    },
    "max_items": {
      "default": 10,
      "maximum": 50,
      "minimum": 1,
      "title": "Max Items",
      "type": "integer"
    },
    "max_tokens": {
      "default": 4096,
      "maximum": 16384,
      "minimum": 256,
      "title": "Max Tokens",
      "type": "integer"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "query": {
      "default": "",
      "maxLength": 256,
      "title": "Query",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "scope": {
      "default": "project",
      "enum": [
        "run",
        "project",
        "team",
        "user"
      ],
      "title": "Scope",
      "type": "string"
    },
    "since": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Since"
    }
  },
  "title": "MemoryQuery",
  "type": "object"
}
