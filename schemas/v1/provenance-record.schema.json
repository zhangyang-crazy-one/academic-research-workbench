{
  "$id": "https://academic-research-workbench.local/schemas/v1/provenance-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One Lite-profile provenance assertion.",
  "properties": {
    "activity_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Activity Id",
      "type": "string"
    },
    "agent_id": {
      "pattern": "^[a-z][a-z0-9.-]{2,63}$",
      "title": "Agent Id",
      "type": "string"
    },
    "artifact_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "attributes": {
      "additionalProperties": true,
      "title": "Attributes",
      "type": "object"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At",
      "type": "string"
    },
    "derived_from": {
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,95}$",
        "type": "string"
      },
      "maxItems": 500,
      "title": "Derived From",
      "type": "array"
    },
    "entity_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Entity Id",
      "type": "string"
    },
    "entity_type": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Entity Type",
      "type": "string"
    },
    "record_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "entity_id",
    "entity_type",
    "artifact_id",
    "activity_id",
    "agent_id",
    "created_at"
  ],
  "title": "Semantica-compatible Lite provenance record",
  "type": "object"
}
