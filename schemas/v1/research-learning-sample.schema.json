{
  "$id": "https://academic-research-workbench.local/schemas/v1/research-learning-sample.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_action": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Actual Action",
      "type": "string"
    },
    "approved": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved"
    },
    "baseline": {
      "title": "Baseline",
      "type": "number"
    },
    "heuristic_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Heuristic Id",
      "type": "string"
    },
    "metric": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Metric",
      "type": "string"
    },
    "mode": {
      "enum": [
        "replay",
        "held-out",
        "shadow",
        "A-B",
        "human-review",
        "benchmark"
      ],
      "title": "Mode",
      "type": "string"
    },
    "outcome": {
      "title": "Outcome",
      "type": "number"
    },
    "policy_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "proposed_action": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Proposed Action",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "arw.learning-sample.v1",
      "default": "arw.learning-sample.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "heuristic_id",
    "policy_id",
    "policy_version",
    "run_id",
    "mode",
    "metric",
    "baseline",
    "outcome",
    "proposed_action",
    "actual_action"
  ],
  "title": "EvaluationSample",
  "type": "object"
}
