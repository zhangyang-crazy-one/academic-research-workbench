{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/host-identity-receipt.schema.json",
  "additionalProperties": false,
  "description": "Parent-accepted host identity/mapping/isolation evidence.",
  "properties": {
    "schema_version": {
      "const": "arw.host-identity-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "role_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Role Id",
      "type": "string"
    },
    "worker_identity_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Worker Identity Id",
      "type": "string"
    },
    "host_agent_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Host Agent Id",
      "type": "string"
    },
    "transport": {
      "enum": [
        "isolated_codex_exec",
        "native_in_session_subagent"
      ],
      "title": "Transport",
      "type": "string"
    },
    "codex_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Codex Version",
      "type": "string"
    },
    "assignment_mapping_proven": {
      "title": "Assignment Mapping Proven",
      "type": "boolean"
    },
    "isolation_proven": {
      "title": "Isolation Proven",
      "type": "boolean"
    },
    "peer_isolation_proven": {
      "title": "Peer Isolation Proven",
      "type": "boolean"
    },
    "credential_isolation_proven": {
      "title": "Credential Isolation Proven",
      "type": "boolean"
    },
    "observed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Observed At",
      "type": "string"
    },
    "evidence_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxLength": 64,
      "minLength": 1,
      "title": "Evidence Sha256",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "role_id",
    "worker_identity_id",
    "host_agent_id",
    "transport",
    "codex_version",
    "assignment_mapping_proven",
    "isolation_proven",
    "peer_isolation_proven",
    "credential_isolation_proven",
    "observed_at",
    "evidence_sha256"
  ],
  "title": "HostIdentityReceipt",
  "type": "object"
}
