{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/event.schema.json",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "run.initialized"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/run_initialized_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "baseline.probe_recorded"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/baseline_probe_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "lifecycle.transitioned"}}, "required": ["event_type"]},
      "then": {"required": ["actor_role"], "properties": {"payload": {"$ref": "#/$defs/lifecycle_transitioned_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "human_decision.requested"}}, "required": ["event_type"]},
      "then": {"required": ["actor_role"], "properties": {"payload": {"$ref": "#/$defs/human_decision_requested_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "human_decision.resolved"}}, "required": ["event_type"]},
      "then": {"required": ["actor_role"], "properties": {"payload": {"$ref": "#/$defs/human_decision_resolved_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "attempt.started"}}, "required": ["event_type"]},
      "then": {"required": ["actor_role"], "properties": {"payload": {"$ref": "#/$defs/attempt_started_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "attempt.closed"}}, "required": ["event_type"]},
      "then": {"required": ["actor_role"], "properties": {"payload": {"$ref": "#/$defs/attempt_closed_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "artifact.accepted"}}, "required": ["event_type"]},
      "then": {"required": ["actor_role"], "properties": {"payload": {"$ref": "#/$defs/artifact_accepted_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "passport.accepted"}}, "required": ["event_type"]},
      "then": {"required": ["actor_role"], "properties": {"payload": {"$ref": "#/$defs/passport_accepted_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "resume.accepted"}}, "required": ["event_type"]},
      "then": {"required": ["actor_role"], "properties": {"payload": {"$ref": "#/$defs/resume_accepted_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "recovery.completed"}}, "required": ["event_type"]},
      "then": {"required": ["actor_role"], "properties": {"payload": {"$ref": "#/$defs/recovery_completed_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"enum": ["execution.mode_selected", "assignment.prepared", "assignment.superseded", "attempt.prepared", "attempt.lifecycle", "proposal.accepted", "proposal.rejected", "review.report_accepted", "review.synthesis_accepted", "hook.observed", "gate.evaluated", "human_decision.recorded"]}}, "required": ["event_type"]},
      "then": {"required": ["actor_role"], "properties": {"actor_role": {"const": "parent_control_plane"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "execution.mode_selected"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/execution_mode_selected_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "assignment.prepared"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/assignment_prepared_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "assignment.superseded"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/assignment_superseded_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "attempt.prepared"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/attempt_prepared_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "attempt.lifecycle"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/attempt_lifecycle_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "proposal.accepted"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/proposal_accepted_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "proposal.rejected"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/proposal_rejected_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "review.report_accepted"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/review_report_accepted_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "review.synthesis_accepted"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/review_synthesis_accepted_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "hook.observed"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/hook_observed_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "gate.evaluated"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/gate_evaluated_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "human_decision.recorded"}}, "required": ["event_type"]},
      "then": {"properties": {"payload": {"$ref": "#/$defs/human_decision_recorded_payload"}}}
    }
  ],
  "description": "Strict hash-chained Phase 1 canonical event envelope.",
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "event_type": {"enum": ["run.initialized", "baseline.probe_recorded", "lifecycle.transitioned", "human_decision.requested", "human_decision.resolved", "attempt.started", "attempt.closed", "artifact.accepted", "passport.accepted", "resume.accepted", "recovery.completed", "execution.mode_selected", "assignment.prepared", "assignment.superseded", "attempt.prepared", "attempt.lifecycle", "proposal.accepted", "proposal.rejected", "review.report_accepted", "review.synthesis_accepted", "hook.observed", "gate.evaluated", "human_decision.recorded"], "type": "string"},
    "event_id": {"pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "command_id": {"pattern": "^cmd-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "run_id": {"pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "sequence": {"minimum": 1, "type": "integer"},
    "occurred_at": {"format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
    "expected_revision": {"minimum": 0, "type": "integer"},
    "resulting_revision": {"minimum": 1, "type": "integer"},
    "actor_id": {"pattern": "^[a-z][a-z0-9.-]{2,63}$", "type": "string"},
    "actor_role": {"enum": ["parent_control_plane", "operator", "worker", "hook"], "type": "string"},
    "prev_event_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "payload": {"type": "object"},
    "event_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["schema_version", "event_type", "event_id", "command_id", "run_id", "sequence", "occurred_at", "expected_revision", "resulting_revision", "actor_id", "prev_event_sha256", "payload", "event_sha256"],
  "title": "CanonicalEvent",
  "type": "object",
  "$defs": {
    "run_initialized_payload": {
      "additionalProperties": false,
      "properties": {"manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}},
      "required": ["manifest_sha256"],
      "type": "object"
    },
    "baseline_probe_payload": {
      "additionalProperties": false,
      "properties": {
        "probe_id": {"pattern": "^[a-z][a-z0-9.-]{2,63}$", "type": "string"},
        "status": {"enum": ["pass", "fail"], "type": "string"},
        "summary": {"maxLength": 256, "minLength": 1, "type": "string"}
      },
      "required": ["probe_id", "status", "summary"],
      "type": "object"
    },
    "lifecycle_transitioned_payload": {
      "additionalProperties": false,
      "properties": {
        "transition_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "from_stage": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "to_stage": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}
      },
      "required": ["transition_id", "from_stage", "to_stage"],
      "type": "object"
    },
    "human_decision_requested_payload": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "blocker_code": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "starting_revision": {"minimum": 0, "type": "integer"},
        "allowed_choices": {"items": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
        "rationale_required": {"type": "boolean"},
        "source_event_ids": {"items": {"pattern": "^evt-", "type": "string"}, "type": "array", "uniqueItems": true},
        "unlock_transitions": {"items": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}, "type": "array", "uniqueItems": true}
      },
      "required": ["decision_id", "blocker_code", "starting_revision", "allowed_choices", "rationale_required", "source_event_ids", "unlock_transitions"],
      "type": "object"
    },
    "human_decision_resolved_payload": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "choice": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "rationale": {"anyOf": [{"minLength": 1, "maxLength": 2048, "type": "string"}, {"type": "null"}]}
      },
      "required": ["decision_id", "choice"],
      "type": "object"
    },
    "attempt_started_payload": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "base_revision": {"minimum": 0, "type": "integer"},
        "consumed_sha256": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "array"}
      },
      "required": ["attempt_id", "base_revision", "consumed_sha256"],
      "type": "object"
    },
    "attempt_closed_payload": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "outcome": {"enum": ["completed", "failed", "cancelled", "superseded"], "type": "string"},
        "proposal_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]}
      },
      "required": ["attempt_id", "outcome"],
      "type": "object"
    },
    "artifact_accepted_payload": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "artifact_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "attempt_id": {"anyOf": [{"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}, {"type": "null"}]}
      },
      "required": ["artifact_id", "manifest_sha256", "artifact_sha256"],
      "type": "object"
    },
    "passport_accepted_payload": {
      "additionalProperties": false,
      "properties": {
        "passport_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "parent_passport_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
        "supersedes_passport_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
        "checkpoint_kind": {"enum": ["stage_handoff", "human_decision", "explicit", "recovery"], "type": "string"},
        "based_on_revision": {"minimum": 0, "type": "integer"},
        "stage": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "fresh_until": {"anyOf": [{"format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}, {"type": "null"}]}
      },
      "required": ["passport_sha256", "parent_passport_sha256", "supersedes_passport_sha256", "checkpoint_kind", "based_on_revision", "stage"],
      "type": "object"
    },
    "resume_accepted_payload": {
      "additionalProperties": false,
      "properties": {"passport_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}},
      "required": ["passport_sha256"],
      "type": "object"
    },
    "recovery_completed_payload": {
      "additionalProperties": false,
      "properties": {
        "recovery_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "prior_valid_revision": {"minimum": 0, "type": "integer"},
        "prior_valid_head_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "original_segment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "original_segment_byte_count": {"minimum": 1, "type": "integer"},
        "quarantine_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "quarantine_receipt_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "fault_offset": {"minimum": 0, "type": "integer"},
        "fault_class": {"enum": ["incomplete-record", "malformed-record", "truncated-utf8"], "type": "string"},
        "reason_code": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}
      },
      "required": ["recovery_id", "prior_valid_revision", "prior_valid_head_sha256", "original_segment_sha256", "original_segment_byte_count", "quarantine_sha256", "quarantine_receipt_sha256", "fault_offset", "fault_class", "reason_code"],
      "type": "object"
    },
    "execution_mode_selected_payload": {
      "properties": {
        "execution_mode": {"enum": ["native_profile", "assignment_injected_subagent", "degraded_inline", "blocked"], "type": "string"},
        "execution_provenance": {"enum": ["native_profile", "assignment_injected_subagent", "degraded_inline", "unavailable"], "type": "string"},
        "role_modes": {"items": {"type": "object"}, "type": "array"},
        "role_catalog_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
        "policy_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
        "dag_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
        "rationale": {"anyOf": [{"minLength": 1, "maxLength": 2048, "type": "string"}, {"type": "null"}]}
      },
      "required": ["execution_mode", "execution_provenance"],
      "type": "object"
    },
    "assignment_prepared_payload": {
      "properties": {"assignment": {"type": "object"}, "assignment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}},
      "required": ["assignment", "assignment_sha256"],
      "type": "object"
    },
    "assignment_superseded_payload": {
      "properties": {
        "assignment": {"type": "object"},
        "assignment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "predecessor_assignment_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "predecessor_assignment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["assignment", "assignment_sha256", "predecessor_assignment_id", "predecessor_assignment_sha256"],
      "type": "object"
    },
    "attempt_prepared_payload": {
      "properties": {
        "assignment_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "assignment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "attempt": {"type": "object"},
        "attempt_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]}
      },
      "required": ["assignment_id", "assignment_sha256", "attempt"],
      "type": "object"
    },
    "attempt_lifecycle_payload": {
      "properties": {
        "assignment_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "assignment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "attempt_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "attempt_number": {"minimum": 1, "maximum": 2, "type": "integer"},
        "status": {"enum": ["prepared", "active", "cancel_requested", "force_terminated", "interrupted", "completed", "failed", "cancelled", "rejected_stale", "superseded", "blocked"], "type": "string"},
        "proposal_nonce": {"anyOf": [{"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}, {"type": "null"}]},
        "retry_reason": {"anyOf": [{"enum": ["timeout", "process_failure", "repairable_envelope", "permission_denied", "stale_inputs", "superseded", "cancelled", "scientific_disagreement", "identity_mismatch", "policy_violation", "digest_mismatch"], "type": "string"}, {"type": "null"}]},
        "retry_eligible": {"type": "boolean"},
        "host_agent_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "cancellation_deadline_at": {"anyOf": [{"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}, {"type": "null"}]},
        "proposal_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
        "reason_code": {"anyOf": [{"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}, {"type": "null"}]}
      },
      "required": ["assignment_id", "assignment_sha256", "attempt_id", "attempt_number", "status"],
      "type": "object"
    },
    "proposal_accepted_payload": {
      "properties": {
        "assignment_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "assignment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "attempt_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "proposal": {"type": "object"},
        "proposal_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "acceptance_key": {"items": {}, "minItems": 3, "maxItems": 3, "type": "array"},
        "accepted_status": {"const": "accepted", "type": "string"}
      },
      "required": ["assignment_id", "assignment_sha256", "attempt_id", "proposal", "proposal_sha256", "acceptance_key"],
      "type": "object"
    },
    "proposal_rejected_payload": {
      "properties": {
        "assignment_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "assignment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "attempt_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "proposal_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "outcome": {"enum": ["rejected", "rejected_invalid", "rejected_stale", "rejected_cancelled", "rejected_superseded"], "type": "string"},
        "reason_code": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "acceptance_key": {"items": {}, "minItems": 3, "maxItems": 3, "type": "array"},
        "raw_bytes_retained": {"type": "boolean"}
      },
      "required": ["assignment_id", "assignment_sha256", "attempt_id", "proposal_sha256", "outcome", "reason_code", "acceptance_key"],
      "type": "object"
    },
    "review_report_accepted_payload": {
      "properties": {"report": {"type": "object"}, "report_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}},
      "required": ["report", "report_sha256"],
      "type": "object"
    },
    "review_synthesis_accepted_payload": {
      "properties": {"finding_matrix": {"type": "object"}, "finding_matrix_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}},
      "required": ["finding_matrix", "finding_matrix_sha256"],
      "type": "object"
    },
    "hook_observed_payload": {
      "properties": {"observation": {"type": "object"}, "observation_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}},
      "required": ["observation", "observation_sha256"],
      "type": "object"
    },
    "gate_evaluated_payload": {
      "properties": {"decision": {"type": "object"}, "decision_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}},
      "required": ["decision", "decision_sha256"],
      "type": "object"
    },
    "human_decision_recorded_payload": {
      "properties": {"decision": {"type": "object"}, "decision_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}},
      "required": ["decision", "decision_sha256"],
      "type": "object"
    }
  }
}
