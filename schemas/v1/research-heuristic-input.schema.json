{
  "$defs": {
    "Applicability": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "task": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "model": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "retrieval_coverage": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Retrieval Coverage",
          "type": "string"
        },
        "call_budget": {
          "minimum": 0,
          "title": "Call Budget",
          "type": "integer"
        },
        "output_budget": {
          "minimum": 0,
          "title": "Output Budget",
          "type": "integer"
        },
        "metric": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        }
      },
      "required": [
        "task",
        "model",
        "retrieval_coverage",
        "call_budget",
        "output_budget",
        "metric"
      ],
      "title": "Applicability",
      "type": "object"
    },
    "LegacyGuidanceReview": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "nonmandatory": {
          "const": true,
          "default": true,
          "title": "Nonmandatory",
          "type": "boolean"
        },
        "counterexample_needs": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Counterexample Needs",
          "type": "string"
        },
        "exception_conditions": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Exception Conditions",
          "type": "array"
        }
      },
      "required": [
        "counterexample_needs",
        "exception_conditions"
      ],
      "title": "LegacyGuidanceReview",
      "type": "object"
    },
    "UnknownEvidence": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Observation Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "rationale"
      ],
      "title": "UnknownEvidence",
      "type": "object"
    },
    "VenueApplicability": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Scientific fit of a lesson, independent of its approved sharing scope.",
      "properties": {
        "domain_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Domain Id",
          "type": "string"
        },
        "venue_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Venue Id",
          "type": "string"
        }
      },
      "required": [
        "domain_id",
        "venue_id"
      ],
      "title": "VenueApplicability",
      "type": "object"
    },
    "VenueQuantityGuidance": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A descriptive range with explicit exceptions, never an official rule.",
      "properties": {
        "minimum": {
          "minimum": 0,
          "title": "Minimum",
          "type": "integer"
        },
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "integer"
        },
        "unit": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "nonmandatory": {
          "const": true,
          "default": true,
          "title": "Nonmandatory",
          "type": "boolean"
        },
        "counterexample_needs": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Counterexample Needs",
          "type": "string"
        },
        "exception_conditions": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Exception Conditions",
          "type": "array"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "unit",
        "counterexample_needs",
        "exception_conditions"
      ],
      "title": "VenueQuantityGuidance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "heuristic_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Heuristic Id",
      "type": "string"
    },
    "scope": {
      "default": "project",
      "enum": [
        "run",
        "project",
        "domain",
        "global"
      ],
      "title": "Scope",
      "type": "string"
    },
    "domain_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain Id"
    },
    "domain": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Domain",
      "type": "string"
    },
    "trigger": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Trigger",
      "type": "string"
    },
    "proposed_action": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Proposed Action",
      "type": "string"
    },
    "applicability": {
      "$ref": "#/$defs/Applicability"
    },
    "venue_applicability": {
      "anyOf": [
        {
          "$ref": "#/$defs/VenueApplicability"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "venue_quantity_guidance": {
      "anyOf": [
        {
          "$ref": "#/$defs/VenueQuantityGuidance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "migration_status": {
      "anyOf": [
        {
          "const": "unverified_legacy",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Migration Status"
    },
    "legacy_guidance_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/LegacyGuidanceReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "supporting_observation_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,95}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Supporting Observation Ids",
      "type": "array"
    },
    "counterexample_observation_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,95}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Counterexample Observation Ids",
      "type": "array"
    },
    "unknown": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UnknownEvidence"
      },
      "maxItems": 64,
      "title": "Unknown",
      "type": "array"
    },
    "search_coverage": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Search Coverage",
      "type": "string"
    },
    "evaluation_coverage": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Evaluation Coverage",
      "type": "string"
    },
    "producer": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Producer Version",
      "type": "string"
    },
    "model_id": {
      "anyOf": [
        {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "input_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Digest"
    },
    "output_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Digest"
    },
    "supersedes": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    }
  },
  "required": [
    "heuristic_id",
    "domain",
    "trigger",
    "proposed_action",
    "applicability",
    "confidence",
    "supporting_observation_ids",
    "search_coverage",
    "evaluation_coverage",
    "producer",
    "producer_version"
  ],
  "title": "HeuristicInput",
  "type": "object",
  "$id": "https://academic-research-workbench.local/schemas/v1/research-heuristic-input.schema.json"
}
