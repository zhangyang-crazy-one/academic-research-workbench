{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arw.local/schemas/v1/file-identity-manifest.schema.json",
  "$defs": {
    "FileIdentityRecord": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,127}$",
          "title": "File Id",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "file_type": {
          "enum": [
            "text",
            "markdown",
            "latex",
            "bibtex",
            "source",
            "pdf",
            "binary"
          ],
          "title": "File Type",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "descriptor_fingerprint": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Descriptor Fingerprint"
        },
        "identity_evidence": {
          "enum": [
            "created",
            "same_path",
            "os_identity",
            "unique_digest"
          ],
          "title": "Identity Evidence",
          "type": "string"
        },
        "previous_relative_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Relative Path"
        }
      },
      "required": [
        "file_id",
        "relative_path",
        "file_type",
        "size_bytes",
        "digest",
        "descriptor_fingerprint",
        "identity_evidence",
        "previous_relative_path"
      ],
      "title": "FileIdentityRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "root_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Root Id",
      "type": "string"
    },
    "root_instance_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Root Instance Id",
      "type": "string"
    },
    "generation_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Generation Id",
      "type": "string"
    },
    "previous_generation_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Generation Id"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/FileIdentityRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "deleted_file_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,127}$",
        "type": "string"
      },
      "title": "Deleted File Ids",
      "type": "array"
    },
    "ambiguous_digests": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Ambiguous Digests",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "root_id",
    "root_instance_id",
    "generation_id",
    "previous_generation_id",
    "created_at",
    "records",
    "deleted_file_ids",
    "ambiguous_digests"
  ],
  "title": "FileIdentityManifest",
  "type": "object"
}
