{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arw.local/schemas/v1/file-admin-receipt.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "operation": {
      "enum": [
        "sync",
        "rebuild",
        "repair"
      ],
      "title": "Operation",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "degraded",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "root_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Root Id",
      "type": "string"
    },
    "attempt_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "previous_generation_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Generation Id"
    },
    "candidate_generation_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Candidate Generation Id",
      "type": "string"
    },
    "selected_generation_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Generation Id"
    },
    "generation_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Generation Manifest Sha256"
    },
    "identity_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Identity Manifest Sha256"
    },
    "degraded_file_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,127}$",
        "type": "string"
      },
      "title": "Degraded File Ids",
      "type": "array"
    },
    "blocking_reasons": {
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,127}$",
        "type": "string"
      },
      "title": "Blocking Reasons",
      "type": "array"
    },
    "started_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "operation",
    "status",
    "root_id",
    "attempt_id",
    "previous_generation_id",
    "candidate_generation_id",
    "selected_generation_id",
    "generation_manifest_sha256",
    "identity_manifest_sha256",
    "degraded_file_ids",
    "blocking_reasons",
    "started_at",
    "completed_at"
  ],
  "title": "FileAdminReceipt",
  "type": "object"
}
