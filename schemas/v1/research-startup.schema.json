{
  "$defs": {
    "ImmutableInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Digest-bound repository-relative input identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ImmutableInput",
      "type": "object"
    },
    "InitRunRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Strict operator request used to construct manifest and initial event.",
      "properties": {
        "actor_id": {
          "pattern": "^[a-z][a-z0-9.-]{2,63}$",
          "title": "Actor Id",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "enum": [
              "canonical-journal",
              "forced-stop-replay"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "command_id": {
          "pattern": "^cmd-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Command Id",
          "type": "string"
        },
        "event_id": {
          "pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Event Id",
          "type": "string"
        },
        "immutable_input": {
          "$ref": "#/$defs/ImmutableInput"
        },
        "journal_layout": {
          "anyOf": [
            {
              "const": "segmented-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journal Layout"
        },
        "narrative_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrativeRunBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occurred_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Occurred At",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_kind": {
          "anyOf": [
            {
              "enum": [
                "paper",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Kind"
        },
        "workflow_definition_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Definition Id"
        },
        "workflow_definition_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Definition Sha256"
        },
        "workflow_family": {
          "const": "academic-pipeline",
          "title": "Workflow Family",
          "type": "string"
        },
        "workflow_mode": {
          "const": "inline-role-prompts",
          "title": "Workflow Mode",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "occurred_at",
        "immutable_input",
        "workflow_family",
        "workflow_mode",
        "capabilities",
        "event_id",
        "command_id",
        "actor_id"
      ],
      "title": "InitRunRequest",
      "type": "object"
    },
    "NarrativeRunBinding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Immutable project association established at paper-run initialization.",
      "properties": {
        "initial_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Initial Sha256",
          "type": "string"
        },
        "initial_version": {
          "minimum": 1,
          "title": "Initial Version",
          "type": "integer"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Project Id",
          "type": "string"
        },
        "project_relative_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Project Relative Path",
          "type": "string"
        },
        "schema_version": {
          "const": "arw.narrative-run-binding.v1",
          "default": "arw.narrative-run-binding.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "project_relative_path",
        "project_id",
        "initial_version",
        "initial_sha256"
      ],
      "title": "NarrativeRunBinding",
      "type": "object"
    }
  },
  "$id": "https://academic-research-workbench.local/schemas/v1/research-startup.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ars_project_ref": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Ars Project Ref",
      "type": "string"
    },
    "direction": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Direction",
      "type": "string"
    },
    "phase": {
      "enum": [
        "scoping",
        "literature",
        "experiment",
        "writing"
      ],
      "title": "Phase",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Project Id",
      "type": "string"
    },
    "project_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Identity Sha256",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/InitRunRequest"
    },
    "run_relative": {
      "maxLength": 256,
      "title": "Run Relative",
      "type": "string"
    },
    "schema_version": {
      "const": "arw.research-start.v1",
      "default": "arw.research-start.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "project_identity_sha256",
    "ars_project_ref",
    "direction",
    "phase",
    "run_relative",
    "request"
  ],
  "title": "ResearchStartPlan",
  "type": "object"
}
