{
  "$defs": {
    "SubmissionArtifactReference": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A reference to an already accepted parent artifact.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "accepting_event_id": {
          "pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Accepting Event Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "manifest_sha256",
        "content_sha256",
        "accepting_event_id"
      ],
      "title": "SubmissionArtifactReference",
      "type": "object"
    },
    "SubmissionCheck": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Check Id",
          "type": "string"
        },
        "check_kind": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Check Kind",
          "type": "string"
        },
        "applicability": {
          "enum": [
            "REQUIRED",
            "OPTIONAL",
            "NOT_APPLICABLE"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "REVIEW",
            "BLOCK",
            "STALE",
            "UNSUPPORTED",
            "NOT_CHECKED"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Reason Codes",
          "type": "array"
        },
        "source_identity": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Identity",
          "type": "string"
        },
        "source_version": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "output_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Sha256"
        },
        "coverage": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Coverage",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Limitations",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SubmissionArtifactReference"
          },
          "maxItems": 128,
          "title": "Evidence",
          "type": "array"
        },
        "evaluated_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Evaluated At",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "check_id",
        "check_kind",
        "applicability",
        "status",
        "source_identity",
        "source_version",
        "input_sha256",
        "coverage",
        "evaluated_at"
      ],
      "title": "SubmissionCheck",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "arw.submission-check-report.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Report Id",
      "type": "string"
    },
    "submission_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Submission Id",
      "type": "string"
    },
    "packet_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Packet Manifest Sha256",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "evaluated_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Evaluated At",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/SubmissionCheck"
      },
      "maxItems": 256,
      "title": "Checks",
      "type": "array"
    },
    "readiness": {
      "enum": [
        "INCOMPLETE",
        "BLOCKED",
        "REVIEW_REQUIRED",
        "STALE",
        "READY_FOR_HUMAN_SUBMIT"
      ],
      "title": "Readiness",
      "type": "string"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "submission_id",
    "packet_manifest_sha256",
    "input_fingerprint",
    "evaluated_at",
    "checks",
    "readiness"
  ],
  "title": "SubmissionCheckReport",
  "type": "object",
  "$id": "https://academic-research-workbench.local/schemas/v1/submission-check-report.schema.json"
}
