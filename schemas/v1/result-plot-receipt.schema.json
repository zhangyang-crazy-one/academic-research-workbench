    "revision",
    "ir_sha256",
    "renderer",
    "inputs",
    "rendered_from",
    "outputs",
    "plot_values",
    "checks",
    "metadata",
    "validation_policy",
    "validation",
    "qualification",
    "purpose",
    "visual_reviewer",
    "reason_codes"
