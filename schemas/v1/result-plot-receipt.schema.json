  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "receipt_version": {
      "const": "arw.result-plot-receipt.v1",
      "default": "arw.result-plot-receipt.v1",
      "title": "Receipt Version",
      "type": "string"
    },
    "artifact_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_kind": {
      "const": "result_plot",
      "default": "result_plot",
      "title": "Artifact Kind",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "ir_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Ir Sha256",
      "type": "string"
    },
    "renderer": {
      "$ref": "#/$defs/RendererIdentity"
    },
    "inputs": {
      "items": {
        "discriminator": {
          "mapping": {
            "parent-artifact": "#/$defs/ParentArtifactRef",
            "project-journal": "#/$defs/JournalEventRef"
          },
          "propertyName": "scope"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ParentArtifactRef"
          },
          {
            "$ref": "#/$defs/JournalEventRef"
          }
        ]
      },
      "title": "Inputs",
      "type": "array"
    },
    "rendered_from": {
      "$ref": "#/$defs/FigureRenderedFrom"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/OutputDigest"
      },
      "title": "Outputs",
      "type": "array"
    },
    "plot_values": {
      "items": {
        "$ref": "#/$defs/PlotValue"
      },
      "title": "Plot Values",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/PlotCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/RationalExact"
      },
      "title": "Metadata",
      "type": "object"
    },
    "validation_policy": {
      "$ref": "#/$defs/ValidationPolicy"
    },
    "validation": {
      "$ref": "#/$defs/ValidationResults"
    },
    "qualification": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "Qualification",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "publication-critical",
        "exploratory"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "visual_reviewer": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisualReviewer"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "source_determinism": {
      "const": "byte_deterministic",
      "default": "byte_deterministic",
      "title": "Source Determinism",
      "type": "string"
    },
    "fixed_environment_render": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Fixed Environment Render",
      "type": "string"
    },
    "publication_quality": {
      "default": "not_verified",
      "enum": [
        "reviewed",
        "not_verified"
      ],
      "title": "Publication Quality",
      "type": "string"
    }
  },
  "required": [
