{
  "$defs": {
    "AllRows": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "all",
          "default": "all",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "AllRows",
      "type": "object"
    },
    "ByteChunk": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "byte_chunk",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "title": "ByteChunk",
      "type": "object"
    },
    "ComparisonContext": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Everything that must agree before two values may be compared.",
      "properties": {
        "metric_definition": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "dataset": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Dataset",
          "type": "string"
        },
        "split": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Split",
          "type": "string"
        },
        "evaluation_condition": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evaluation Condition",
          "type": "string"
        }
      },
      "required": [
        "metric_definition",
        "unit",
        "dataset",
        "split",
        "evaluation_condition"
      ],
      "title": "ComparisonContext",
      "type": "object"
    },
    "CsvSelection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "csv_selection",
          "default": "csv_selection",
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/ParentArtifactRef"
        },
        "columns": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "row_id_column": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Row Id Column",
          "type": "string"
        },
        "row_set": {
          "default": {
            "kind": "all"
          },
          "discriminator": {
            "mapping": {
              "all": "#/$defs/AllRows",
              "ids": "#/$defs/RowIds",
              "predicate": "#/$defs/RowPredicate"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AllRows"
            },
            {
              "$ref": "#/$defs/RowIds"
            },
            {
              "$ref": "#/$defs/RowPredicate"
            }
          ],
          "title": "Row Set"
        },
        "group_by": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Group By",
          "type": "array"
        },
        "missing_policy": {
          "default": "reject",
          "enum": [
            "reject",
            "exclude"
          ],
          "title": "Missing Policy",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ComparisonContext"
        },
        "unit": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "scale": {
          "$ref": "#/$defs/RationalExact",
          "default": {
            "numerator": 1,
            "denominator": 1
          }
        }
      },
      "required": [
        "ref",
        "columns",
        "row_id_column",
        "context",
        "unit"
      ],
      "title": "CsvSelection",
      "type": "object"
    },
    "DerivationRef": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "derivation_ref",
          "default": "derivation_ref",
          "title": "Kind",
          "type": "string"
        },
        "derivation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivation Id",
          "type": "string"
        }
      },
      "required": [
        "derivation_id"
      ],
      "title": "DerivationRef",
      "type": "object"
    },
    "FigureRenderedFrom": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "source_refs": {
          "items": {
            "discriminator": {
              "mapping": {
                "parent-artifact": "#/$defs/ParentArtifactRef",
                "project-journal": "#/$defs/JournalEventRef"
              },
              "propertyName": "scope"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ParentArtifactRef"
              },
              {
                "$ref": "#/$defs/JournalEventRef"
              }
            ]
          },
          "title": "Source Refs",
          "type": "array"
        },
        "ir_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ir Sha256",
          "type": "string"
        },
        "renderer": {
          "$ref": "#/$defs/RendererIdentity"
        }
      },
      "required": [
        "source_refs",
        "ir_sha256",
        "renderer"
      ],
      "title": "FigureRenderedFrom",
      "type": "object"
    },
    "JournalEventRef": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "project-journal",
          "default": "project-journal",
          "title": "Scope",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Project Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "event_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Sha256",
          "type": "string"
        },
        "payload_selector": {
          "default": "",
          "maxLength": 2048,
          "title": "Payload Selector",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "sequence",
        "event_sha256"
      ],
      "title": "JournalEventRef",
      "type": "object"
    },
    "LineRange": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "lines",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "title": "LineRange",
      "type": "object"
    },
    "MarkdownSection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "markdown_section",
          "title": "Kind",
          "type": "string"
        },
        "heading": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "occurrence": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "heading",
        "occurrence"
      ],
      "title": "MarkdownSection",
      "type": "object"
    },
    "NumericExpression": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "arw.numeric-expression.v1",
          "default": "arw.numeric-expression.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "op": {
          "enum": [
            "value",
            "diff",
            "ratio",
            "pct_point_diff",
            "relative_change",
            "count",
            "sum",
            "mean",
            "median",
            "min",
            "max"
          ],
          "title": "Op",
          "type": "string"
        },
        "args": {
          "items": {
            "discriminator": {
              "mapping": {
                "csv_selection": "#/$defs/CsvSelection",
                "derivation_ref": "#/$defs/DerivationRef",
                "scalar_json": "#/$defs/ScalarJson"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ScalarJson"
              },
              {
                "$ref": "#/$defs/CsvSelection"
              },
              {
                "$ref": "#/$defs/DerivationRef"
              }
            ]
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Args",
          "type": "array"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "title": "NumericExpression",
      "type": "object"
    },
    "NumericPresentation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "derivation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivation Id",
          "type": "string"
        },
        "decimals": {
          "maximum": 18,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "rounding_mode": {
          "enum": [
            "ROUND_HALF_EVEN",
            "ROUND_HALF_UP",
            "ROUND_DOWN"
          ],
          "title": "Rounding Mode",
          "type": "string"
        },
        "unit_suffix": {
          "default": "",
          "maxLength": 64,
          "title": "Unit Suffix",
          "type": "string"
        },
        "scale": {
          "$ref": "#/$defs/RationalExact",
          "default": {
            "numerator": 1,
            "denominator": 1
          }
        }
      },
      "required": [
        "derivation_id",
        "decimals",
        "rounding_mode"
      ],
      "title": "NumericPresentation",
      "type": "object"
    },
    "OutputDigest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "OutputDigest",
      "type": "object"
    },
    "ParentArtifactRef": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "parent-artifact",
          "default": "parent-artifact",
          "title": "Scope",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Project Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Run Id",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "accepting_event_id": {
          "pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Accepting Event Id",
          "type": "string"
        },
        "accepting_event_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Accepting Event Sha256",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "selector": {
          "default": "",
          "maxLength": 2048,
          "title": "Selector",
          "type": "string"
        },
        "selected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Sha256"
        },
        "producing_activity_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producing Activity Id"
        },
        "source_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "project_id",
        "run_id",
        "run_manifest_sha256",
        "artifact_id",
        "accepting_event_id",
        "accepting_event_sha256",
        "content_sha256"
      ],
      "title": "ParentArtifactRef",
      "type": "object"
    },
    "PdfLocation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "arw.pdf-location.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pdf_page",
            "pdf_paragraph",
            "pdf_section",
            "pdf_region",
            "reference_entry"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "pdf_source_path": {
          "minLength": 1,
          "title": "Pdf Source Path",
          "type": "string"
        },
        "pdf_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pdf Sha256",
          "type": "string"
        },
        "extraction_manifest_path": {
          "minLength": 1,
          "title": "Extraction Manifest Path",
          "type": "string"
        },
        "extraction_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Extraction Manifest Sha256",
          "type": "string"
        },
        "extractor_name": {
          "enum": [
            "pypdf",
            "grobid",
            "docling"
          ],
          "title": "Extractor Name",
          "type": "string"
        },
        "extractor_version": {
          "minLength": 1,
          "title": "Extractor Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "page",
        "start",
        "end",
        "pdf_source_path",
        "pdf_sha256",
        "extraction_manifest_path",
        "extraction_manifest_sha256",
        "extractor_name",
        "extractor_version"
      ],
      "title": "PdfLocation",
      "type": "object"
    },
    "PlotCheck": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "category": {
          "enum": [
            "integrity",
            "caption",
            "heuristic",
            "statistics"
          ],
          "title": "Category",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "advisory",
            "unknown",
            "unsupported",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "binding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Id"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "category",
        "status"
      ],
      "title": "PlotCheck",
      "type": "object"
    },
    "PlotValue": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "plot_value_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Plot Value Id",
          "type": "string"
        },
        "derivation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivation Id",
          "type": "string"
        },
        "exact": {
          "$ref": "#/$defs/RationalExact"
        },
        "layer": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Layer",
          "type": "string"
        },
        "datum_id": {
          "title": "Datum Id",
          "type": "string"
        },
        "series": {
          "title": "Series",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "channel": {
          "enum": [
            "x",
            "y",
            "lower",
            "upper"
          ],
          "title": "Channel",
          "type": "string"
        },
        "statistic": {
          "title": "Statistic",
          "type": "string"
        },
        "expr": {
          "$ref": "#/$defs/NumericExpression"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "scale": {
          "$ref": "#/$defs/RationalExact",
          "default": {
            "numerator": 1,
            "denominator": 1
          }
        },
        "display": {
          "$ref": "#/$defs/NumericPresentation"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "stable_row_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stable Row Id"
        }
      },
      "required": [
        "plot_value_id",
        "derivation_id",
        "exact",
        "layer",
        "datum_id",
        "series",
        "category",
        "channel",
        "statistic",
        "expr",
        "unit",
        "display",
        "revision"
      ],
      "title": "PlotValue",
      "type": "object"
    },
    "RationalExact": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "maximum": 99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999,
          "minimum": -99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "maximum": 99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999,
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalExact",
      "type": "object"
    },
    "RendererIdentity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "identity_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Digest",
          "type": "string"
        },
        "normalization_policy": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Normalization Policy",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "identity_digest",
        "normalization_policy"
      ],
      "title": "RendererIdentity",
      "type": "object"
    },
    "RowIds": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ids",
          "default": "ids",
          "title": "Kind",
          "type": "string"
        },
        "ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        }
      },
      "required": [
        "ids"
      ],
      "title": "RowIds",
      "type": "object"
    },
    "RowPredicate": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "predicate",
          "default": "predicate",
          "title": "Kind",
          "type": "string"
        },
        "column": {
          "maxLength": 128,
