{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/assignment.schema.json",
  "$defs": {
    "AssignmentKey": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A frozen parent-owned acceptance key, never a completion-order key.",
      "properties": {
        "topological_layer": {
          "minimum": 0,
          "title": "Topological Layer",
          "type": "integer"
        },
        "task_ordinal": {
          "minimum": 0,
          "title": "Task Ordinal",
          "type": "integer"
        },
        "assignment_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Assignment Id",
          "type": "string"
        }
      },
      "required": [
        "topological_layer",
        "task_ordinal",
        "assignment_id"
      ],
      "title": "AssignmentKey",
      "type": "object"
    },
    "BlindReviewConstraints": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "subject_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Sha256"
        },
        "rubric_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rubric Sha256"
        },
        "forbidden_peer_role_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9._-]{2,95}$",
            "type": "string"
          },
          "maxLength": 32,
          "title": "Forbidden Peer Role Ids",
          "type": "array"
        }
      },
      "required": [
        "required",
        "subject_sha256",
        "rubric_sha256",
        "forbidden_peer_role_ids"
      ],
      "title": "BlindReviewConstraints",
      "type": "object"
    },
    "CompletionContract": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "requires_completed_proposal": {
          "title": "Requires Completed Proposal",
          "type": "boolean"
        },
        "required_artifact_kinds": {
          "items": {
            "pattern": "^[a-z][a-z0-9._-]{2,95}$",
            "type": "string"
          },
          "maxLength": 32,
          "title": "Required Artifact Kinds",
          "type": "array"
        },
        "requires_human_gate": {
          "title": "Requires Human Gate",
          "type": "boolean"
        }
      },
      "required": [
        "requires_completed_proposal",
        "required_artifact_kinds",
        "requires_human_gate"
      ],
      "title": "CompletionContract",
      "type": "object"
    },
    "OutputPolicy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schema Sha256",
          "type": "string"
        },
        "max_bytes": {
          "maximum": 8388608,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_artifacts": {
          "maximum": 32,
          "minimum": 0,
          "title": "Max Artifacts",
          "type": "integer"
        }
      },
      "required": [
        "schema_id",
        "schema_sha256",
        "max_bytes",
        "max_artifacts"
      ],
      "title": "OutputPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The content-addressed worker contract that a retry may not mutate.",
  "properties": {
    "schema_version": {
      "const": "arw.assignment.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "assignment_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Assignment Id",
      "type": "string"
    },
    "supersedes_assignment_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedes Assignment Id"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "stage_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Stage Id",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Task Id",
      "type": "string"
    },
    "role_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Role Id",
      "type": "string"
    },
    "worker_identity_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Worker Identity Id",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "native_formal",
        "degraded_inline",
        "blocked"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "execution_provenance": {
      "enum": [
        "native_profile",
        "assignment_injected_subagent",
        "degraded_inline",
        "unavailable"
      ],
      "title": "Execution Provenance",
      "type": "string"
    },
    "independence_eligible": {
      "title": "Independence Eligible",
      "type": "boolean"
    },
    "base_revision": {
      "minimum": 0,
      "title": "Base Revision",
      "type": "integer"
    },
    "input_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxLength": 128,
      "minLength": 1,
      "title": "Input Sha256",
      "type": "array"
    },
    "capability_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,95}$",
        "type": "string"
      },
      "maxLength": 32,
      "title": "Capability Ids",
      "type": "array"
    },
    "allowed_read_root_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,95}$",
        "type": "string"
      },
      "maxLength": 32,
      "title": "Allowed Read Root Ids",
      "type": "array"
    },
    "scratch_path_template": {
      "title": "Scratch Path Template",
      "type": "string"
    },
    "result_path_template": {
      "title": "Result Path Template",
      "type": "string"
    },
    "output_policy": {
      "$ref": "#/$defs/OutputPolicy"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "context_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Manifest Sha256",
      "type": "string"
    },
    "blind_review": {
      "$ref": "#/$defs/BlindReviewConstraints"
    },
    "deadline_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Deadline At",
      "type": "string"
    },
    "completion_contract": {
      "$ref": "#/$defs/CompletionContract"
    },
    "acceptance_key": {
      "$ref": "#/$defs/AssignmentKey"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "assignment_id",
    "supersedes_assignment_id",
    "run_id",
    "stage_id",
    "task_id",
    "role_id",
    "worker_identity_id",
    "execution_mode",
    "execution_provenance",
    "independence_eligible",
    "base_revision",
    "input_sha256",
    "capability_ids",
    "allowed_read_root_ids",
    "scratch_path_template",
    "result_path_template",
    "output_policy",
    "policy_sha256",
    "context_manifest_sha256",
    "blind_review",
    "deadline_at",
    "completion_contract",
    "acceptance_key"
  ],
  "title": "ImmutableAssignment",
  "type": "object"
}
