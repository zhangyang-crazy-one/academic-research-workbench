{
  "$defs": {
    "Handoff": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Blockers",
          "type": "array"
        },
        "commands_evaluations_run": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Commands Evaluations Run",
          "type": "array"
        },
        "completed_work": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Completed Work",
          "type": "array"
        },
        "current_state": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Current State",
          "type": "string"
        },
        "evidence_gathered": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Evidence Gathered",
          "type": "array"
        },
        "intended_target_harness": {
          "enum": [
            "codex",
            "claude",
            "cursor",
            "other"
          ],
          "title": "Intended Target Harness",
          "type": "string"
        },
        "next_concrete_action": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Next Concrete Action",
          "type": "string"
        },
        "objective": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "open_questions": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Open Questions",
          "type": "array"
        },
        "relevant_artifacts_issues_files": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Relevant Artifacts Issues Files",
          "type": "array"
        },
        "risks": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Risks",
          "type": "array"
        },
        "source_run_harness": {
          "$ref": "#/$defs/SourceRunHarness"
        }
      },
      "required": [
        "objective",
        "current_state",
        "completed_work",
        "evidence_gathered",
        "commands_evaluations_run",
        "relevant_artifacts_issues_files",
        "open_questions",
        "blockers",
        "risks",
        "next_concrete_action",
        "source_run_harness",
        "intended_target_harness"
      ],
      "title": "Handoff",
      "type": "object"
    },
    "MemoryLink": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "anyOf": [
            {
              "pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "kind": {
          "enum": [
            "memory",
            "artifact",
            "decision",
            "author_target",
            "issue",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "target_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target_id"
      ],
      "title": "MemoryLink",
      "type": "object"
    },
    "SourceRunHarness": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "harness": {
          "enum": [
            "codex",
            "claude",
            "cursor",
            "other"
          ],
          "title": "Harness",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "harness"
      ],
      "title": "SourceRunHarness",
      "type": "object"
    }
  },
  "$id": "https://academic-research-workbench.local/schemas/v1/research-memory-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "body": {
      "maxLength": 16384,
      "minLength": 1,
      "title": "Body",
      "type": "string"
    },
    "handoff": {
      "anyOf": [
        {
          "$ref": "#/$defs/Handoff"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "enum": [
        "context",
        "handoff",
        "decision_note",
        "lesson",
        "blocker",
        "experiment_note",
        "source_note",
        "reproduction_note"
      ],
      "title": "Kind",
      "type": "string"
    },
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MemoryLink"
      },
      "maxItems": 64,
      "title": "Links",
      "type": "array"
    },
    "memory_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Id"
    },
    "privacy_classification": {
      "default": "project_private",
      "enum": [
        "project_private",
        "shareable",
        "sensitive"
      ],
      "title": "Privacy Classification",
      "type": "string"
    },
    "scope": {
      "default": "project",
      "enum": [
        "run",
        "project",
        "team",
        "user"
      ],
      "title": "Scope",
      "type": "string"
    },
    "source_artifact_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,95}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Source Artifact Ids",
      "type": "array"
    },
    "source_ledger_event_ids": {
      "default": [],
      "items": {
        "pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Source Ledger Event Ids",
      "type": "array"
    },
    "supersedes": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,95}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Supersedes",
      "type": "array"
    },
    "tags": {
      "default": [],
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "title",
    "body"
  ],
  "title": "MemoryInput",
  "type": "object"
}
