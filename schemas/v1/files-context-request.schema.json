{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arw.local/schemas/v1/files-context-request.schema.json",
  "$defs": {
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "start_byte": {
          "minimum": 0,
          "title": "Start Byte",
          "type": "integer"
        },
        "end_byte": {
          "minimum": 0,
          "title": "End Byte",
          "type": "integer"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        }
      },
      "required": [
        "start_byte",
        "end_byte"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "root_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Root Id",
      "type": "string"
    },
    "generation_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Generation Id",
      "type": "string"
    },
    "file_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "File Id",
      "type": "string"
    },
    "expected_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Digest",
      "type": "string"
    },
    "hit_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Hit Id"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceLocation"
        },
        {
          "type": "null"
        }
      ]
    },
    "before_lines": {
      "maximum": 200,
      "minimum": 0,
      "title": "Before Lines",
      "type": "integer"
    },
    "after_lines": {
      "maximum": 200,
      "minimum": 0,
      "title": "After Lines",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "root_id",
    "generation_id",
    "file_id",
    "expected_digest",
    "hit_id",
    "location",
    "before_lines",
    "after_lines"
  ],
  "title": "FilesContextRequest",
  "type": "object"
}
