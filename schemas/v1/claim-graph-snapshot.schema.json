{
  "$defs": {
    "JournalPrefix": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "head_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Head Sha256",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "head_sha256"
      ],
      "title": "JournalPrefix",
      "type": "object"
    },
    "RunPrefix": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Run Id",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "head_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Head Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "run_manifest_sha256",
        "revision",
        "head_sha256"
      ],
      "title": "RunPrefix",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "arw.claim-graph-snapshot.v1",
      "default": "arw.claim-graph-snapshot.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Project Id",
      "type": "string"
    },
    "journal": {
      "$ref": "#/$defs/JournalPrefix"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunPrefix"
      },
      "maxItems": 32,
      "title": "Runs",
      "type": "array"
    },
    "projection_version": {
      "const": "arw.claim-graph.v1",
      "default": "arw.claim-graph.v1",
      "title": "Projection Version",
      "type": "string"
    },
    "adapter_matrix_version": {
      "const": "arw.accepted-ref-adapters.v1",
      "default": "arw.accepted-ref-adapters.v1",
      "title": "Adapter Matrix Version",
      "type": "string"
    },
    "canonicalization_version": {
      "const": "arw.canonical-json.v1",
      "default": "arw.canonical-json.v1",
      "title": "Canonicalization Version",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "journal",
    "runs"
  ],
  "title": "SnapshotManifest",
  "type": "object",
  "$id": "https://academic-research-workbench.local/schemas/v1/claim-graph-snapshot.schema.json"
}
