{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/lifecycle-evidence.schema.json",
  "additionalProperties": false,
  "description": "Typed, digest-bound lifecycle evidence used by claim capabilities.",
  "properties": {
    "schema_version": {
      "const": "arw.lifecycle-evidence.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "record_kind": {
      "maxLength": 64,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Record Kind",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "subject_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Subject Sha256",
      "type": "string"
    },
    "input_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Input Sha256",
      "type": "array"
    },
    "observed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Observed At",
      "type": "string"
    },
    "fresh_until": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Fresh Until",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_kind",
    "receipt_id",
    "subject_sha256",
    "input_sha256",
    "observed_at",
    "fresh_until",
    "verdict",
    "receipt_sha256"
  ],
  "title": "LifecycleEvidenceRecord",
  "type": "object"
}
