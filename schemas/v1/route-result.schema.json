{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/route-result.schema.json",
  "additionalProperties": false,
  "description": "Read-only routing decision exposed by the installed skill.\n\nHost integration evidence is advisory: a missing, incomplete, or drifted\nintegration lock yields ``UNVERIFIED`` with a reason code, never a blocked\nroute. Release qualification and experiment execution are reported by\ntheir own commands, not by ``route``.",
  "properties": {
    "schema_version": {
      "const": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workflow_family": {
      "const": "academic-pipeline",
      "title": "Workflow Family",
      "type": "string"
    },
    "execution_mode": {
      "const": "inline-role-prompts",
      "title": "Execution Mode",
      "type": "string"
    },
    "source_adapter_version": {
      "const": "0.1.27",
      "title": "Source Adapter Version",
      "type": "string"
    },
    "source_dependency_model": {
      "const": "bundled-pinned-adapter",
      "title": "Source Dependency Model",
      "type": "string"
    },
    "source_bundled": {
      "const": true,
      "title": "Source Bundled",
      "type": "boolean"
    },
    "integration_status": {
      "enum": [
        "PASS",
        "UNVERIFIED"
      ],
      "title": "Integration Status",
      "type": "string"
    },
    "integration_lock_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Integration Lock Sha256"
    },
    "reason_codes": {
      "items": {
        "enum": [
          "integration_lock_not_verified",
          "integration_inputs_incomplete",
          "integration_lock_invalid_or_drifted"
        ],
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "paper_ast_export": {
      "const": "deferred-v2",
      "title": "Paper Ast Export",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "workflow_family",
    "execution_mode",
    "source_adapter_version",
    "source_dependency_model",
    "source_bundled",
    "integration_status",
    "integration_lock_sha256",
    "reason_codes",
    "paper_ast_export"
  ],
  "title": "RouteResult",
  "type": "object"
}
