{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/build-identity.schema.json",
  "title": "Academic Research Workbench packaged build identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform_claim",
    "plugin",
    "runtime",
    "components",
    "patches",
    "native",
    "projection",
    "file_contract",
    "wheelhouse",
    "schemas",
    "evidence",
    "staged_payloads"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "platform_claim": {"const": "linux"},
    "plugin": {"$ref": "#/$defs/plugin"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/component"}
    },
    "patches": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/patch"}
    },
    "native": {"$ref": "#/$defs/native"},
    "projection": {"$ref": "#/$defs/projection"},
    "file_contract": {"$ref": "#/$defs/fileContract"},
    "wheelhouse": {"$ref": "#/$defs/wheelhouse"},
    "schemas": {"$ref": "#/$defs/schemaSet"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "staged_payloads": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/digestPath"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "digestPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "academic-research-workbench"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\+[a-z0-9.-]+)?$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_requires", "build_interpreter"],
      "properties": {
        "python_requires": {"const": ">=3.13"},
        "build_interpreter": {"type": "string", "pattern": "^3\\.(13|14)\\.[0-9]+$"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "revision", "tree_sha256"],
      "properties": {
        "id": {"enum": ["academic-research-skills", "experiment-agent", "file-base"]},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "path", "sha256"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary",
        "build_evidence",
        "compile_profile",
        "patched_source_tree_sha256",
        "upstream_test_tree_sha256"
      ],
      "properties": {
        "binary": {"$ref": "#/$defs/digestPath"},
        "build_evidence": {"$ref": "#/$defs/digestPath"},
        "compile_profile": {"const": "release-o2"},
        "patched_source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "upstream_test_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "oracle",
        "native_profile",
        "patch_set_sha256",
        "profile_patch_sha256",
        "query_profile",
        "query_launcher"
      ],
      "properties": {
        "algorithm": {"const": "research-graph-projection-v1"},
        "oracle": {"const": "research-graph-normalization-v1"},
        "native_profile": {"const": "research-graph-builder-v1"},
        "patch_set_sha256": {"$ref": "#/$defs/sha256"},
        "profile_patch_sha256": {"$ref": "#/$defs/sha256"},
        "query_profile": {"const": "arw-graph-mcp-v1"},
        "query_launcher": {"$ref": "#/$defs/digestPath"}
      }
    },
    "fileContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "contract_sha256",
        "tokenizer_id",
        "ranking_version",
        "outline_versions"
      ],
      "properties": {
        "header": {"$ref": "#/$defs/digestPath"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "tokenizer_id": {"const": "unicode61-cjk-v1"},
        "ranking_version": {"const": "files-rank-v1"},
        "outline_versions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bibtex-outline-v1",
              "latex-outline-v1",
              "markdown-outline-v1",
              "source-outline-v1"
            ]
          }
        }
      }
    },
    "wheelhouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock", "requirements", "first_party"],
      "properties": {
        "lock": {"$ref": "#/$defs/digestPath"},
        "requirements": {"$ref": "#/$defs/digestPath"},
        "first_party": {"$ref": "#/$defs/digestPath"}
      }
    },
    "schemaSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_sha256", "files"],
      "properties": {
        "aggregate_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 8,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/digestPath"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_vendor", "legal", "upstream", "asan_ubsan", "tsan"],
      "properties": {
        "pre_vendor": {"$ref": "#/$defs/digestPath"},
        "legal": {"$ref": "#/$defs/digestPath"},
        "upstream": {"$ref": "#/$defs/digestPath"},
        "asan_ubsan": {"$ref": "#/$defs/digestPath"},
        "tsan": {"$ref": "#/$defs/digestPath"}
      }
    }
  }
}
