{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arw.local/schemas/v1/files-outline-result.schema.json",
  "$defs": {
    "OutlineNode": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "maximum": 16,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9._-]{2,127}$",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        }
      },
      "required": [
        "level",
        "kind",
        "title",
        "location"
      ],
      "title": "OutlineNode",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "start_byte": {
          "minimum": 0,
          "title": "Start Byte",
          "type": "integer"
        },
        "end_byte": {
          "minimum": 0,
          "title": "End Byte",
          "type": "integer"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        }
      },
      "required": [
        "start_byte",
        "end_byte"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "no_structure",
        "stale_conflict",
        "degraded"
      ],
      "title": "Status",
      "type": "string"
    },
    "root_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Root Id",
      "type": "string"
    },
    "generation_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Generation Id",
      "type": "string"
    },
    "file_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "File Id",
      "type": "string"
    },
    "indexed_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Indexed Digest",
      "type": "string"
    },
    "current_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Digest"
    },
    "extraction_registration_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Extraction Registration Sha256"
    },
    "parser_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parser Version"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/OutlineNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    }
  },
  "required": [
    "schema_version",
    "status",
    "root_id",
    "generation_id",
    "file_id",
    "indexed_digest",
    "current_digest",
    "extraction_registration_sha256",
    "parser_version",
    "nodes",
    "next_cursor"
  ],
  "title": "FilesOutlineResult",
  "type": "object"
}
