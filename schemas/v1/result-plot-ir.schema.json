{
  "$defs": {
    "AllRows": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "all",
          "default": "all",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "AllRows",
      "type": "object"
    },
    "ByteChunk": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "byte_chunk",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "title": "ByteChunk",
      "type": "object"
    },
    "CaptionBinding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Binding Id",
          "type": "string"
        },
        "start_byte": {
          "minimum": 0,
          "title": "Start Byte",
          "type": "integer"
        },
        "end_byte": {
          "minimum": 1,
          "title": "End Byte",
          "type": "integer"
        },
        "number_kind": {
          "enum": [
            "result",
            "sample_size",
            "confidence_level",
            "figure_number",
            "non_result"
          ],
          "title": "Number Kind",
          "type": "string"
        },
        "confirmation": {
          "default": "unknown",
          "enum": [
            "unknown",
            "declared",
            "authenticated"
          ],
          "title": "Confirmation",
          "type": "string"
        },
        "plot_value_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plot Value Id"
        },
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "statistic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statistic"
        },
        "expr": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericExpression"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/RationalExact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "metadata_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Key"
        },
        "confirmation_ref": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "parent-artifact": "#/$defs/ParentArtifactRef",
                  "project-journal": "#/$defs/JournalEventRef"
                },
                "propertyName": "scope"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/ParentArtifactRef"
                },
                {
                  "$ref": "#/$defs/JournalEventRef"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmation Ref"
        }
      },
      "required": [
        "binding_id",
        "start_byte",
        "end_byte",
        "number_kind",
        "revision"
      ],
      "title": "CaptionBinding",
      "type": "object"
    },
    "ComparisonContext": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Everything that must agree before two values may be compared.",
      "properties": {
        "metric_definition": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "dataset": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Dataset",
          "type": "string"
        },
        "split": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Split",
          "type": "string"
        },
        "evaluation_condition": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evaluation Condition",
          "type": "string"
        }
      },
      "required": [
        "metric_definition",
        "unit",
        "dataset",
        "split",
        "evaluation_condition"
      ],
      "title": "ComparisonContext",
      "type": "object"
    },
    "CsvSelection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "csv_selection",
          "default": "csv_selection",
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/ParentArtifactRef"
        },
        "columns": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "row_id_column": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Row Id Column",
          "type": "string"
        },
        "row_set": {
          "default": {
            "kind": "all"
          },
          "discriminator": {
            "mapping": {
              "all": "#/$defs/AllRows",
              "ids": "#/$defs/RowIds",
              "predicate": "#/$defs/RowPredicate"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AllRows"
            },
            {
              "$ref": "#/$defs/RowIds"
            },
            {
              "$ref": "#/$defs/RowPredicate"
            }
          ],
          "title": "Row Set"
        },
        "group_by": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Group By",
          "type": "array"
        },
        "missing_policy": {
          "default": "reject",
          "enum": [
            "reject",
            "exclude"
          ],
          "title": "Missing Policy",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ComparisonContext"
        },
        "unit": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "scale": {
          "$ref": "#/$defs/RationalExact",
          "default": {
            "numerator": 1,
            "denominator": 1
          }
        }
      },
      "required": [
        "ref",
        "columns",
        "row_id_column",
        "context",
        "unit"
      ],
      "title": "CsvSelection",
      "type": "object"
    },
    "DerivationRef": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "derivation_ref",
          "default": "derivation_ref",
          "title": "Kind",
          "type": "string"
        },
        "derivation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivation Id",
          "type": "string"
        }
      },
      "required": [
        "derivation_id"
      ],
      "title": "DerivationRef",
      "type": "object"
    },
    "DerivationRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "arw.numeric-request.v1",
          "default": "arw.numeric-request.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "expr": {
          "$ref": "#/$defs/NumericExpression"
        },
        "context": {
          "$ref": "#/$defs/ComparisonContext"
        },
        "evaluator_version": {
          "default": "arw.rational.v1",
          "maxLength": 64,
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        }
      },
      "required": [
        "expr",
        "context"
      ],
      "title": "DerivationRequest",
      "type": "object"
    },
    "JournalEventRef": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "project-journal",
          "default": "project-journal",
          "title": "Scope",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Project Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "event_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Sha256",
          "type": "string"
        },
        "payload_selector": {
          "default": "",
          "maxLength": 2048,
          "title": "Payload Selector",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "sequence",
        "event_sha256"
      ],
      "title": "JournalEventRef",
      "type": "object"
    },
    "LineRange": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "lines",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "title": "LineRange",
      "type": "object"
    },
    "MarkdownSection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "markdown_section",
          "title": "Kind",
          "type": "string"
        },
        "heading": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "occurrence": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "heading",
        "occurrence"
      ],
      "title": "MarkdownSection",
      "type": "object"
    },
    "NumericExpression": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "arw.numeric-expression.v1",
          "default": "arw.numeric-expression.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "op": {
          "enum": [
            "value",
            "diff",
            "ratio",
            "pct_point_diff",
            "relative_change",
            "count",
            "sum",
            "mean",
            "median",
            "min",
            "max"
          ],
          "title": "Op",
          "type": "string"
        },
        "args": {
          "items": {
            "discriminator": {
              "mapping": {
                "csv_selection": "#/$defs/CsvSelection",
                "derivation_ref": "#/$defs/DerivationRef",
                "scalar_json": "#/$defs/ScalarJson"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ScalarJson"
              },
              {
                "$ref": "#/$defs/CsvSelection"
              },
              {
                "$ref": "#/$defs/DerivationRef"
              }
            ]
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Args",
          "type": "array"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "title": "NumericExpression",
      "type": "object"
    },
    "ParentArtifactRef": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "parent-artifact",
          "default": "parent-artifact",
          "title": "Scope",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Project Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Run Id",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "accepting_event_id": {
          "pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Accepting Event Id",
          "type": "string"
        },
        "accepting_event_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Accepting Event Sha256",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "selector": {
          "default": "",
          "maxLength": 2048,
          "title": "Selector",
          "type": "string"
        },
        "selected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Sha256"
        },
        "producing_activity_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producing Activity Id"
        },
        "source_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "project_id",
        "run_id",
        "run_manifest_sha256",
        "artifact_id",
        "accepting_event_id",
        "accepting_event_sha256",
        "content_sha256"
      ],
      "title": "ParentArtifactRef",
      "type": "object"
    },
    "PdfLocation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "arw.pdf-location.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "pdf_page",
            "pdf_paragraph",
            "pdf_section",
            "pdf_region",
            "reference_entry"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "pdf_source_path": {
          "minLength": 1,
          "title": "Pdf Source Path",
          "type": "string"
        },
        "pdf_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pdf Sha256",
          "type": "string"
        },
        "extraction_manifest_path": {
          "minLength": 1,
          "title": "Extraction Manifest Path",
          "type": "string"
        },
        "extraction_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Extraction Manifest Sha256",
          "type": "string"
        },
        "extractor_name": {
          "enum": [
            "pypdf",
            "grobid",
            "docling"
          ],
          "title": "Extractor Name",
          "type": "string"
        },
        "extractor_version": {
          "minLength": 1,
          "title": "Extractor Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "page",
        "start",
        "end",
        "pdf_source_path",
        "pdf_sha256",
        "extraction_manifest_path",
        "extraction_manifest_sha256",
        "extractor_name",
        "extractor_version"
      ],
      "title": "PdfLocation",
      "type": "object"
    },
    "PlotDatum": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "datum_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Datum Id",
          "type": "string"
        },
        "category": {
          "default": "",
          "maxLength": 128,
          "title": "Category",
          "type": "string"
        },
        "series": {
          "default": "",
          "maxLength": 128,
          "title": "Series",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "$ref": "#/$defs/RationalExact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pair_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Id"
        },
        "x": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "y": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lower": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upper": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivationRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "datum_id"
      ],
      "title": "PlotDatum",
      "type": "object"
    },
    "PlotDisplay": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scale": {
          "$ref": "#/$defs/RationalExact",
          "default": {
            "numerator": 1,
            "denominator": 1
          }
        },
        "unit_suffix": {
          "default": "",
          "maxLength": 64,
          "title": "Unit Suffix",
          "type": "string"
        },
        "decimals": {
          "default": 3,
          "maximum": 18,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "rounding_mode": {
          "default": "ROUND_HALF_EVEN",
          "enum": [
            "ROUND_HALF_EVEN",
            "ROUND_HALF_UP",
            "ROUND_DOWN"
          ],
          "title": "Rounding Mode",
          "type": "string"
        }
      },
      "title": "PlotDisplay",
      "type": "object"
    },
    "PlotEncoding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "x": {
          "maxLength": 128,
          "minLength": 1,
          "title": "X",
          "type": "string"
        },
        "y": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Y",
          "type": "string"
        },
        "series": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "order": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "pair_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Id"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "PlotEncoding",
      "type": "object"
    },
    "PlotHeuristics": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "arw.plot-heuristics.v1",
