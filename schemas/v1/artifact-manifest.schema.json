{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/artifact-manifest.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "run_id": {"pattern": "^run-[0-9a-f-]{36}$", "type": "string"},
    "artifact_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
    "artifact_kind": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
    "media_type": {"minLength": 3, "maxLength": 127, "type": "string"},
    "content_path": {"minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\u0000\\\\]+$", "type": "string"},
    "content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "producer_id": {"pattern": "^[a-z][a-z0-9.-]{2,63}$", "type": "string"},
    "attempt_id": {"anyOf": [{"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}, {"type": "null"}]},
    "base_revision": {"minimum": 0, "type": "integer"},
    "consumed_sha256": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "array"},
    "created_at": {"format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}
  },
  "required": ["schema_version", "run_id", "artifact_id", "artifact_kind", "media_type", "content_path", "content_sha256", "producer_id", "base_revision", "consumed_sha256", "created_at"],
  "title": "ArtifactManifest",
  "type": "object"
}
