{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/recovery-receipt.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "run_id": {"pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "recovery_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
    "segment_relative_path": {"minLength": 1, "type": "string"},
    "original_segment_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "original_segment_byte_count": {"minimum": 1, "type": "integer"},
    "accepted_byte_end": {"minimum": 0, "type": "integer"},
    "fault_offset": {"minimum": 0, "type": "integer"},
    "fault_class": {"enum": ["incomplete-record", "malformed-record", "truncated-utf8"], "type": "string"},
    "quarantine_raw_path": {"minLength": 1, "type": "string"},
    "quarantine_raw_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "prior_valid_revision": {"minimum": 1, "type": "integer"},
    "prior_valid_head_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "operator_id": {"pattern": "^[a-z][a-z0-9.-]{2,63}$", "type": "string"},
    "reason_code": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
    "reason_text": {"minLength": 1, "maxLength": 2048, "type": "string"},
    "command_id": {"pattern": "^cmd-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "event_id": {"pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "occurred_at": {"format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}
  },
  "required": ["schema_version", "run_id", "recovery_id", "segment_relative_path", "original_segment_sha256", "original_segment_byte_count", "accepted_byte_end", "fault_offset", "fault_class", "quarantine_raw_path", "quarantine_raw_sha256", "prior_valid_revision", "prior_valid_head_sha256", "operator_id", "reason_code", "reason_text", "command_id", "event_id", "occurred_at"],
  "title": "RecoveryReceipt",
  "type": "object"
}
