{
  "$id": "https://academic-research-workbench.local/schemas/v1/research-learning-observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At",
      "type": "string"
    },
    "dedup_policy": {
      "const": "ledger-event-and-source-digest-v1",
      "default": "ledger-event-and-source-digest-v1",
      "title": "Dedup Policy",
      "type": "string"
    },
    "duplicate_of": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duplicate Of"
    },
    "human_signal": {
      "anyOf": [
        {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Signal"
    },
    "ledger_event_id": {
      "pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Ledger Event Id",
      "type": "string"
    },
    "observation_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Observation Id",
      "type": "string"
    },
    "observation_kind": {
      "enum": [
        "artifact_receipt",
        "transition",
        "validation",
        "human_signal",
        "experiment",
        "tool_receipt"
      ],
      "title": "Observation Kind",
      "type": "string"
    },
    "outcome": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Outcome",
      "type": "string"
    },
    "privacy_classification": {
      "default": "project_private",
      "enum": [
        "project_private",
        "shareable"
      ],
      "title": "Privacy Classification",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "arw.learning-observation.v1",
      "default": "arw.learning-observation.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_activity_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Activity Id"
    },
    "source_artifact_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,95}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Source Artifact Ids",
      "type": "array"
    },
    "source_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "source_tool_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Tool Id"
    },
    "trigger": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Trigger",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "project_id",
    "run_id",
    "ledger_event_id",
    "observation_kind",
    "trigger",
    "outcome",
    "created_at",
    "source_digest"
  ],
  "title": "LearningObservation",
  "type": "object"
}
