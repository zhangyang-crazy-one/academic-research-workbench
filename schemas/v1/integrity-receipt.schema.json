{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/integrity-receipt.schema.json",
  "$defs": {
    "IntegrityFreshnessPolicy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Explicit receipt freshness and bounded future-clock tolerance.",
      "properties": {
        "valid_until": {
          "title": "Valid Until",
          "type": "string"
        },
        "clock_skew_seconds": {
          "maximum": 300,
          "minimum": 0,
          "title": "Clock Skew Seconds",
          "type": "integer"
        }
      },
      "required": [
        "valid_until",
        "clock_skew_seconds"
      ],
      "title": "IntegrityFreshnessPolicy",
      "type": "object"
    },
    "IntegrityToolIdentity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Identity of the exact validator implementation that produced a receipt.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:-]*$",
          "title": "Version",
          "type": "string"
        },
        "build_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Build Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "build_sha256"
      ],
      "title": "IntegrityToolIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Content-addressed scientific integrity observation.",
  "properties": {
    "schema_version": {
      "const": "arw.integrity-receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "subject_kind": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Subject Kind",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "subject_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Subject Sha256",
      "type": "string"
    },
    "input_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Input Sha256",
      "type": "array"
    },
    "method_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9._:-]*$",
      "title": "Method Id",
      "type": "string"
    },
    "method_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:-]*$",
      "title": "Method Version",
      "type": "string"
    },
    "tool_identity": {
      "$ref": "#/$defs/IntegrityToolIdentity"
    },
    "observed_at": {
      "title": "Observed At",
      "type": "string"
    },
    "freshness_policy": {
      "$ref": "#/$defs/IntegrityFreshnessPolicy"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9._:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "reason_text": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Reason Text",
      "type": "string"
    },
    "source_manifest_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Manifest Sha256",
      "type": "array"
    },
    "created_by": {
      "pattern": "^[a-z][a-z0-9.-]{2,63}$",
      "title": "Created By",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "subject_kind",
    "subject_id",
    "subject_sha256",
    "input_sha256",
    "method_id",
    "method_version",
    "tool_identity",
    "observed_at",
    "freshness_policy",
    "verdict",
    "reason_codes",
    "reason_text",
    "source_manifest_sha256",
    "created_by",
    "receipt_sha256"
  ],
  "title": "IntegrityReceipt",
  "type": "object"
}
