{
  "$defs": {
    "Applicability": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "call_budget": {
          "minimum": 0,
          "title": "Call Budget",
          "type": "integer"
        },
        "metric": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "model": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "output_budget": {
          "minimum": 0,
          "title": "Output Budget",
          "type": "integer"
        },
        "retrieval_coverage": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Retrieval Coverage",
          "type": "string"
        },
        "task": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task",
        "model",
        "retrieval_coverage",
        "call_budget",
        "output_budget",
        "metric"
      ],
      "title": "Applicability",
      "type": "object"
    },
    "UnknownEvidence": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Observation Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "rationale"
      ],
      "title": "UnknownEvidence",
      "type": "object"
    }
  },
  "$id": "https://academic-research-workbench.local/schemas/v1/research-heuristic.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_ledger_event_id": {
      "anyOf": [
        {
          "pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Ledger Event Id"
    },
    "applicability": {
      "$ref": "#/$defs/Applicability"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "counterexample_observation_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,95}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Counterexample Observation Ids",
      "type": "array"
    },
    "counterexample_run_ids": {
      "items": {
        "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "title": "Counterexample Run Ids",
      "type": "array"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At",
      "type": "string"
    },
    "domain": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Domain",
      "type": "string"
    },
    "domain_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain Id"
    },
    "evaluation_coverage": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Evaluation Coverage",
      "type": "string"
    },
    "heuristic_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Heuristic Id",
      "type": "string"
    },
    "input_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Digest"
    },
    "model_id": {
      "anyOf": [
        {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "output_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Digest"
    },
    "producer": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Producer",
      "type": "string"
    },
    "producer_version": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Producer Version",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Project Id",
      "type": "string"
    },
    "proposed_action": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Proposed Action",
      "type": "string"
    },
    "qualification_receipt_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qualification Receipt Id"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "arw.research-heuristic.v1",
      "default": "arw.research-heuristic.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": "project",
      "enum": [
        "run",
        "project",
        "domain",
        "global"
      ],
      "title": "Scope",
      "type": "string"
    },
    "search_coverage": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Search Coverage",
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate",
        "evaluated",
        "qualified",
        "rejected",
        "superseded",
        "promoted"
      ],
      "title": "Status",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "supporting_observation_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9._-]{2,95}$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Supporting Observation Ids",
      "type": "array"
    },
    "supporting_run_ids": {
      "items": {
        "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "title": "Supporting Run Ids",
      "type": "array"
    },
    "trigger": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Trigger",
      "type": "string"
    },
    "trust": {
      "enum": [
        "unreviewed",
        "advisory"
      ],
      "title": "Trust",
      "type": "string"
    },
    "unknown": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UnknownEvidence"
      },
      "maxItems": 64,
      "title": "Unknown",
      "type": "array"
    },
    "updated_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "heuristic_id",
    "domain",
    "trigger",
    "proposed_action",
    "applicability",
    "confidence",
    "supporting_observation_ids",
    "search_coverage",
    "evaluation_coverage",
    "producer",
    "producer_version",
    "project_id",
    "run_id",
    "supporting_run_ids",
    "counterexample_run_ids",
    "created_at",
    "updated_at",
    "status",
    "trust"
  ],
  "title": "ResearchHeuristic",
  "type": "object"
}
