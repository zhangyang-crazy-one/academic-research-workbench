{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/passport-pointer.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "run_id": {"pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "passport_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "accepted_revision": {"minimum": 1, "type": "integer"},
    "ledger_head_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["schema_version", "run_id", "passport_sha256", "accepted_revision", "ledger_head_sha256"],
  "title": "PassportPointer",
  "type": "object"
}
