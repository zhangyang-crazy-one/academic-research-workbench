{
  "$defs": {
    "ClaimRevisionTarget": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "claim-revision",
          "default": "claim-revision",
          "title": "Kind",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Claim Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "claim_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Claim Sha256",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "revision",
        "claim_sha256"
      ],
      "title": "ClaimRevisionTarget",
      "type": "object"
    },
    "JournalPrefix": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "head_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Head Sha256",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "head_sha256"
      ],
      "title": "JournalPrefix",
      "type": "object"
    },
    "NumericPresentation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "derivation_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Derivation Id",
          "type": "string"
        },
        "decimals": {
          "maximum": 18,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "rounding_mode": {
          "enum": [
            "ROUND_HALF_EVEN",
            "ROUND_HALF_UP",
            "ROUND_DOWN"
          ],
          "title": "Rounding Mode",
          "type": "string"
        },
        "unit_suffix": {
          "default": "",
          "maxLength": 64,
          "title": "Unit Suffix",
          "type": "string"
        },
        "scale": {
          "$ref": "#/$defs/RationalExact",
          "default": {
            "numerator": 1,
            "denominator": 1
          }
        }
      },
      "required": [
        "derivation_id",
        "decimals",
        "rounding_mode"
      ],
      "title": "NumericPresentation",
      "type": "object"
    },
    "Occurrence": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "numeric_token",
            "figure_caption",
            "citation_sentence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "manuscript_ref": {
          "additionalProperties": true,
          "title": "Manuscript Ref",
          "type": "object"
        },
        "manuscript_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manuscript Sha256",
          "type": "string"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "length": {
          "exclusiveMinimum": 0,
          "maximum": 1048576,
          "title": "Length",
          "type": "integer"
        },
        "selected_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selected Sha256",
          "type": "string"
        },
        "locator_version": {
          "default": "arw.utf8-byte-span.v1",
          "enum": [
            "arw.utf8-byte-span.v1",
            "arw.writing-citation-bindings.v2"
          ],
          "title": "Locator Version",
          "type": "string"
        },
        "numeric_class": {
          "anyOf": [
            {
              "enum": [
                "own_result",
                "literature_reported",
                "method_parameter",
                "count",
                "sample_size",
                "identifier",
                "year",
                "figure_number",
                "confidence_level",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Class"
        },
        "derivation_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derivation Id"
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericPresentation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "figure_ref": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Figure Ref"
        },
        "plot_value_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plot Value Id"
        },
        "plot_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plot Revision"
        }
      },
      "required": [
        "kind",
        "manuscript_ref",
        "manuscript_sha256",
        "offset",
        "length",
        "selected_sha256"
      ],
      "title": "Occurrence",
      "type": "object"
    },
    "OccurrenceTarget": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "occurrence",
          "default": "occurrence",
          "title": "Kind",
          "type": "string"
        },
        "occurrence": {
          "$ref": "#/$defs/Occurrence"
        }
      },
      "required": [
        "occurrence"
      ],
      "title": "OccurrenceTarget",
      "type": "object"
    },
    "RationalExact": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "maximum": 99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999,
          "minimum": -99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "maximum": 99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999,
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalExact",
      "type": "object"
    },
    "ReviewConcern": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "arw.review-concern.v1",
          "default": "arw.review-concern.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "concern_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Concern Id",
          "type": "string"
        },
        "snapshot_manifest": {
          "$ref": "#/$defs/SnapshotManifest"
        },
        "target": {
          "discriminator": {
            "mapping": {
              "claim-revision": "#/$defs/ClaimRevisionTarget",
              "occurrence": "#/$defs/OccurrenceTarget"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ClaimRevisionTarget"
            },
            {
              "$ref": "#/$defs/OccurrenceTarget"
            }
          ],
          "title": "Target"
        },
        "proposition_type": {
          "default": "REQUEST",
          "enum": [
            "EVALUATION",
            "REQUEST",
            "FACT",
            "REFERENCE",
            "QUOTE",
            "NON-ARG"
          ],
          "title": "Proposition Type",
          "type": "string"
        },
        "argumentative_zone": {
          "anyOf": [
            {
              "enum": [
                "BKG",
                "OTH",
                "OWN",
                "AIM",
                "TXT",
                "CTR",
                "BAS"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Argumentative Zone"
        },
        "message": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "source": {
          "default": "author",
          "enum": [
            "rule",
            "author"
          ],
          "title": "Source",
          "type": "string"
        },
        "advisory": {
          "const": true,
          "default": true,
          "title": "Advisory",
          "type": "boolean"
        }
      },
      "required": [
        "concern_id",
        "snapshot_manifest",
        "target",
        "message"
      ],
      "title": "ReviewConcern",
      "type": "object"
    },
    "RunPrefix": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Run Id",
          "type": "string"
        },
        "run_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Manifest Sha256",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "head_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Head Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "run_manifest_sha256",
        "revision",
        "head_sha256"
      ],
      "title": "RunPrefix",
      "type": "object"
    },
    "SnapshotManifest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "arw.claim-graph-snapshot.v1",
          "default": "arw.claim-graph-snapshot.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Project Id",
          "type": "string"
        },
        "journal": {
          "$ref": "#/$defs/JournalPrefix"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/RunPrefix"
          },
          "maxItems": 32,
          "title": "Runs",
          "type": "array"
        },
        "projection_version": {
          "const": "arw.claim-graph.v1",
          "default": "arw.claim-graph.v1",
          "title": "Projection Version",
          "type": "string"
        },
        "adapter_matrix_version": {
          "const": "arw.accepted-ref-adapters.v1",
          "default": "arw.accepted-ref-adapters.v1",
          "title": "Adapter Matrix Version",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "arw.canonical-json.v1",
          "default": "arw.canonical-json.v1",
          "title": "Canonicalization Version",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "journal",
        "runs"
      ],
      "title": "SnapshotManifest",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "arw.review-concerns.v1",
      "default": "arw.review-concerns.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "generator_version": {
      "const": "arw.review-diagnostics.v1",
      "default": "arw.review-diagnostics.v1",
      "title": "Generator Version",
      "type": "string"
    },
    "snapshot_manifest": {
      "$ref": "#/$defs/SnapshotManifest"
    },
    "concerns": {
      "items": {
        "$ref": "#/$defs/ReviewConcern"
      },
      "maxItems": 1000,
      "title": "Concerns",
      "type": "array"
    },
    "omitted_concern_count": {
      "default": 0,
      "minimum": 0,
      "title": "Omitted Concern Count",
      "type": "integer"
    },
    "interpretation": {
      "const": "advisory_only; not a score, scientific gate or predictor accuracy claim",
      "default": "advisory_only; not a score, scientific gate or predictor accuracy claim",
      "title": "Interpretation",
      "type": "string"
    },
    "corpus_redistribution": {
      "const": "not_performed; separate license review required",
      "default": "not_performed; separate license review required",
      "title": "Corpus Redistribution",
      "type": "string"
    }
  },
  "required": [
    "snapshot_manifest",
    "concerns"
  ],
  "title": "ReviewConcernReport",
  "type": "object",
  "$id": "https://academic-research-workbench.local/schemas/v1/review-concerns.schema.json"
}
