{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/material-passport.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "run_id": {"pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "workflow_definition_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
    "workflow_definition_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "based_on_revision": {"minimum": 0, "type": "integer"},
    "ledger_head_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "stage": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
    "checkpoint_kind": {"enum": ["stage_handoff", "human_decision", "explicit", "recovery"], "type": "string"},
    "parent_passport_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
    "supersedes_passport_sha256": {"anyOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
    "accepted_artifact_manifest_sha256": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "array"},
    "pending_human_decisions": {"items": {"$ref": "#/$defs/decision"}, "type": "array"},
    "active_attempts": {"items": {"$ref": "#/$defs/attempt"}, "type": "array"},
    "fresh_until": {"anyOf": [{"format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}, {"type": "null"}]},
    "created_at": {"format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
    "created_by": {"pattern": "^[a-z][a-z0-9.-]{2,63}$", "type": "string"}
  },
  "required": ["schema_version", "run_id", "workflow_definition_id", "workflow_definition_sha256", "based_on_revision", "ledger_head_sha256", "stage", "checkpoint_kind", "accepted_artifact_manifest_sha256", "pending_human_decisions", "active_attempts", "created_at", "created_by"],
  "title": "MaterialPassport",
  "type": "object",
  "$defs": {
    "decision": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "blocker_code": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "source_event_ids": {"items": {"pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"}, "type": "array"},
        "starting_revision": {"minimum": 0, "type": "integer"},
        "allowed_choices": {"items": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}, "type": "array"},
        "rationale_required": {"type": "boolean"},
        "unlock_transitions": {"items": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}, "type": "array"}
      },
      "required": ["decision_id", "blocker_code", "source_event_ids", "starting_revision", "allowed_choices", "rationale_required", "unlock_transitions"],
      "type": "object"
    },
    "attempt": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
        "base_revision": {"minimum": 0, "type": "integer"},
        "consumed_sha256": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "array"}
      },
      "required": ["attempt_id", "base_revision", "consumed_sha256"],
      "type": "object"
    }
  }
}
