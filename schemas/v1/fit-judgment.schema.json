{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "arw.fit-judgment.v1",
      "default": "arw.fit-judgment.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "reviewer": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "assessment": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Assessment",
      "type": "string"
    },
    "model_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "provider": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "prompt_version": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    }
  },
  "required": [
    "reviewer",
    "assessment",
    "input_sha256"
  ],
  "title": "FitJudgment",
  "type": "object",
  "$id": "https://academic-research-workbench.local/schemas/v1/fit-judgment.schema.json"
}
