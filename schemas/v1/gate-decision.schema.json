{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/gate-decision.schema.json",
  "$defs": {
    "HumanDecisionRecord": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "An append-only scoped human action; it never rewrites a prior verdict.",
      "properties": {
        "schema_version": {
          "const": "arw.human-decision.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "decision_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Decision Id",
          "type": "string"
        },
        "decision_kind": {
          "enum": [
            "waiver",
            "correction",
            "access_decision",
            "capability_escalation",
            "root_escalation",
            "replacement",
            "approval"
          ],
          "title": "Decision Kind",
          "type": "string"
        },
        "gate_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Gate Id",
          "type": "string"
        },
        "subject_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Sha256",
          "type": "string"
        },
        "evidence_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Sha256",
          "type": "array"
        },
        "applicable_transition": {
          "pattern": "^[a-z][a-z0-9._-]{2,95}$",
          "title": "Applicable Transition",
          "type": "string"
        },
        "accountable_actor_id": {
          "pattern": "^[a-z][a-z0-9.-]{2,63}$",
          "title": "Accountable Actor Id",
          "type": "string"
        },
        "accountable_role": {
          "enum": [
            "operator",
            "review_authority",
            "access_authority",
            "parent_control_plane"
          ],
          "title": "Accountable Role",
          "type": "string"
        },
        "scope": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "prior_verdict_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior Verdict Sha256",
          "type": "string"
        },
        "supersedes_decision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._-]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes Decision Id"
        },
        "verdict_rewrite": {
          "const": false,
          "default": false,
          "title": "Verdict Rewrite",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "decision_id",
        "decision_kind",
        "gate_id",
        "subject_sha256",
        "evidence_sha256",
        "applicable_transition",
        "accountable_actor_id",
        "accountable_role",
        "scope",
        "rationale",
        "prior_verdict_sha256",
        "supersedes_decision_id"
      ],
      "title": "HumanDecisionRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "arw.gate-decision.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "gate_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,95}$",
      "title": "Gate Id",
      "type": "string"
    },
    "subject_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Subject Sha256",
      "type": "string"
    },
    "evidence_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxLength": 128,
      "minLength": 1,
      "title": "Evidence Sha256",
      "type": "array"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "fresh_until": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fresh Until"
    },
    "required": {
      "title": "Required",
      "type": "boolean"
    },
    "human_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanDecisionRecord"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "gate_id",
    "subject_sha256",
    "evidence_sha256",
    "verdict",
    "rationale",
    "fresh_until",
    "required",
    "human_decision"
  ],
  "title": "GateDecision",
  "type": "object"
}
