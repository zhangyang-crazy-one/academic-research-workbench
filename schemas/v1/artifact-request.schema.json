{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/artifact-request.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "run_id": {"pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "event_id": {"pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "command_id": {"pattern": "^cmd-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "type": "string"},
    "expected_revision": {"minimum": 0, "type": "integer"},
    "occurred_at": {"format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
    "actor_id": {"pattern": "^[a-z][a-z0-9.-]{2,63}$", "type": "string"},
    "actor_role": {"enum": ["parent_control_plane", "operator", "worker", "hook"], "type": "string"},
    "artifact_id": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
    "artifact_kind": {"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"},
    "media_type": {"minLength": 3, "maxLength": 127, "type": "string"},
    "content_path": {"minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\u0000\\\\]+$", "type": "string"},
    "content_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "attempt_id": {"anyOf": [{"pattern": "^[a-z][a-z0-9._-]{2,95}$", "type": "string"}, {"type": "null"}]},
    "base_revision": {"minimum": 0, "type": "integer"},
    "consumed_sha256": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "array"}
  },
  "required": ["schema_version", "run_id", "event_id", "command_id", "expected_revision", "occurred_at", "actor_id", "actor_role", "artifact_id", "artifact_kind", "media_type", "content_path", "content_sha256", "base_revision", "consumed_sha256"],
  "title": "ArtifactAcceptanceRequest",
  "type": "object"
}
