{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arw.local/schemas/v1/file-generation-manifest.schema.json",
  "$defs": {
    "GenerationFile": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,127}$",
          "title": "File Id",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "file_type": {
          "enum": [
            "text",
            "markdown",
            "latex",
            "bibtex",
            "source",
            "pdf",
            "binary"
          ],
          "title": "File Type",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "index_state": {
          "enum": [
            "indexed",
            "degraded",
            "metadata_only"
          ],
          "title": "Index State",
          "type": "string"
        },
        "degraded_reason": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._-]{2,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Degraded Reason"
        },
        "extraction_registration_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Extraction Registration Sha256"
        }
      },
      "required": [
        "file_id",
        "relative_path",
        "file_type",
        "size_bytes",
        "source_digest",
        "index_state",
        "degraded_reason",
        "extraction_registration_sha256"
      ],
      "title": "GenerationFile",
      "type": "object"
    },
    "GenerationIntegrityFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9._-]{2,127}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "file_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9._-]{2,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "File Id"
        },
        "relative_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relative Path"
        }
      },
      "required": [
        "code",
        "message",
        "file_id",
        "relative_path"
      ],
      "title": "GenerationIntegrityFailure",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "generation_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Generation Id",
      "type": "string"
    },
    "root_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Root Id",
      "type": "string"
    },
    "root_instance_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Root Instance Id",
      "type": "string"
    },
    "identity_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Identity Manifest Sha256",
      "type": "string"
    },
    "database_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Database Sha256",
      "type": "string"
    },
    "contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Sha256",
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At",
      "type": "string"
    },
    "closed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Closed At",
      "type": "string"
    },
    "source_count": {
      "minimum": 0,
      "title": "Source Count",
      "type": "integer"
    },
    "indexed_count": {
      "minimum": 0,
      "title": "Indexed Count",
      "type": "integer"
    },
    "degraded_count": {
      "minimum": 0,
      "title": "Degraded Count",
      "type": "integer"
    },
    "verdict": {
      "enum": [
        "complete",
        "degraded",
        "blocked"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/GenerationFile"
      },
      "title": "Files",
      "type": "array"
    },
    "integrity_failures": {
      "items": {
        "$ref": "#/$defs/GenerationIntegrityFailure"
      },
      "title": "Integrity Failures",
      "type": "array"
    },
    "extraction_registration_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Extraction Registration Sha256",
      "type": "array"
    },
    "tokenizer_id": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Tokenizer Id",
      "type": "string"
    },
    "ranking_version": {
      "pattern": "^[a-z][a-z0-9._-]{2,127}$",
      "title": "Ranking Version",
      "type": "string"
    },
    "parser_versions": {
      "patternProperties": {
        "^[a-z][a-z0-9._-]{2,127}$": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "Parser Versions",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "generation_id",
    "root_id",
    "root_instance_id",
    "identity_manifest_sha256",
    "database_sha256",
    "contract_sha256",
    "created_at",
    "closed_at",
    "source_count",
    "indexed_count",
    "degraded_count",
    "verdict",
    "files",
    "integrity_failures",
    "extraction_registration_sha256",
    "tokenizer_id",
    "ranking_version",
    "parser_versions"
  ],
  "title": "FileGenerationManifest",
  "type": "object"
}
