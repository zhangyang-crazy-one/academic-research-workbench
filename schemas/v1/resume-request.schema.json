{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/resume-request.schema.json",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "run_id": {"pattern": "^run-[0-9a-f-]{36}$", "type": "string"},
    "event_id": {"pattern": "^evt-[0-9a-f-]{36}$", "type": "string"},
    "command_id": {"pattern": "^cmd-[0-9a-f-]{36}$", "type": "string"},
    "expected_revision": {"minimum": 0, "type": "integer"},
    "occurred_at": {"format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
    "actor_id": {"pattern": "^[a-z][a-z0-9.-]{2,63}$", "type": "string"},
    "actor_role": {"const": "operator", "type": "string"},
    "passport_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["schema_version", "run_id", "event_id", "command_id", "expected_revision", "occurred_at", "actor_id", "actor_role", "passport_sha256"],
  "title": "ResumeRequest",
  "type": "object"
}
