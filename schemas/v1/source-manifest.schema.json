{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/v1/source-manifest.schema.json",
  "title": "Academic Research Workbench source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pre_vendor_receipt",
    "components",
    "patches",
    "locks",
    "declared_artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pre_vendor_receipt": {"$ref": "#/$defs/digestPath"},
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/component"}
    },
    "patches": {
      "type": "array",
      "items": {"$ref": "#/$defs/patch"}
    },
    "locks": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/digestPath"}
    },
    "declared_artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "digestPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "path", "sha256"],
      "properties": {
        "spdx": {
          "type": "string",
          "enum": ["CC-BY-NC-4.0", "MIT", "Apache-2.0", "BSD-2-Clause", "LicenseRef-Public-Domain"]
        },
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "legalInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["license", "notice", "policy", "checker", "generator", "package-lock"]
        },
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "upstream_url",
        "revision",
        "git_tree",
        "tree_sha256",
        "source_path",
        "licenses",
        "legal_inputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["academic-research-skills", "experiment-agent", "file-base"]
        },
        "version": {"type": "string", "minLength": 1},
        "upstream_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "source_path": {"$ref": "#/$defs/relativePath"},
        "licenses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/license"}
        },
        "legal_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/legalInput"}
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "order", "path", "sha256", "pre_tree_sha256", "post_tree_sha256"],
      "properties": {
        "component": {"const": "file-base"},
        "order": {"type": "integer", "minimum": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "pre_tree_sha256": {"$ref": "#/$defs/sha256"},
        "post_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "path", "required_before_staging", "sha256"],
      "properties": {
        "class": {"type": "string", "enum": ["schema", "binary", "build-evidence"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "required_before_staging": {"type": "boolean"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
