      "id": "representation",
      "facts": {
        "schema_version": "arw.mechanism-facts.v1",
        "question": "How does this fixed token sequence become a count vector?",
        "claim": "One-hot lookup then sequence summation produces the supplied count vector.",
        "data_nature": "synthetic",
        "components": [
          {
            "semantic_id": "tokens",
            "component_version": "1",
            "family": "token_representation",
