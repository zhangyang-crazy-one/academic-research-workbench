              },
              {
                "port_id": "out",
                "direction": "output",
                "value_type": "episode",
                "object_id": "episode",
                "state_id": "observed"
              }
            ],
            "steps": [
              "Synthetic lookup returns found or missing.",
              "Append observation to event history.",
              "Set answer_present=(observation == found)."
            ]
          },
          {
            "semantic_id": "decide",
            "component_version": "1",
            "family": "conditional_loop",
            "label": "Bounded return or stop",
            "status": "conceptual",
            "source_location": "Public synthetic task definition; no model experiment",
            "phase": "inference",
            "parameters": "not_applicable",
            "ports": [
              {
                "port_id": "input",
                "direction": "input",
                "value_type": "episode",
                "object_id": "episode",
                "state_id": "observed"
              },
              {
                "port_id": "again",
                "direction": "output",
                "value_type": "episode",
                "object_id": "episode",
                "state_id": "observed"
              },
              {
                "port_id": "done",
                "direction": "output",
                "value_type": "episode",
                "object_id": "episode",
                "state_id": "stopped"
              }
            ],
            "steps": [
              "Check answer_present and attempts < 2."
            ],
            "condition": "not answer_present AND attempts < 2",
            "stop_condition": "answer_present OR attempts >= 2"
          },
          {
            "semantic_id": "done",
            "component_version": "1",
            "family": "candidate_state",
            "label": "Terminal episode state",
            "status": "conceptual",
            "source_location": "Public synthetic task definition; no model experiment",
            "phase": "inference",
            "parameters": "not_applicable",
            "ports": [
