                "direction": "output",
                "value_type": "request",
                "object_id": "call",
                "state_id": "prepared"
              }
            ],
            "steps": [
              "Initial state: attempts=0 and answer_present=false.",
              "Increment attempts; request lookup(key=public-toy)."
            ]
          },
