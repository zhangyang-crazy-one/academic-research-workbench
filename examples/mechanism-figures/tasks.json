                "value_type": "episode",
                "object_id": "episode",
                "state_id": "stopped"
              }
            ],
            "steps": [
              "Return retained observation, without another request."
            ],
            "before": "No accepted answer",
            "after": "Answer found, or bounded no-answer exit"
          }
        ],
