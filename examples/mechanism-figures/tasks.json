              {
                "port_id": "out",
                "direction": "output",
                "value_type": "tokens",
                "object_id": "utterance",
                "state_id": "tokens"
              }
            ],
            "steps": [
              "Use the supplied two-token vocabulary."
            ],
            "tokens": [
              {
                "token_id": "tok0",
                "text": "red",
                "representation_id": "e_red",
                "masked": false
              },
              {
                "token_id": "tok1",
                "text": "blue",
                "representation_id": "e_blue",
                "masked": false
              }
            ],
            "axes": [
              "sequence axis: tok0,tok1",
              "embedding axis: red,blue"
            ]
          },
          {
            "semantic_id": "project",
            "component_version": "1",
            "family": "port_operation",
            "label": "Sum the supplied one-hot vectors",
            "status": "conceptual",
            "source_location": "Public synthetic task definition; no model experiment",
            "phase": "inference",
            "parameters": "frozen",
            "ports": [
              {
                "port_id": "input",
                "direction": "input",
                "value_type": "tokens",
                "object_id": "utterance",
                "state_id": "tokens"
              },
              {
                "port_id": "out",
                "direction": "output",
                "value_type": "vector2",
                "object_id": "utterance",
                "state_id": "sum"
              }
            ],
            "steps": [
              "E(red)=[1,0]; E(blue)=[0,1].",
              "Lookup X=[E(red), E(blue)].",
              "Sum sequence axis: y=[1,1]."
            ]
          },
          {
            "semantic_id": "result",
            "component_version": "1",
            "family": "candidate_state",
            "label": "Representation before and after",
            "status": "conceptual",
            "source_location": "Public synthetic task definition; no model experiment",
            "phase": "inference",
            "parameters": "not_applicable",
            "ports": [
              {
                "port_id": "input",
                "direction": "input",
                "value_type": "vector2",
                "object_id": "utterance",
                "state_id": "sum"
              }
            ],
            "steps": [
              "Retain the utterance identity; no trained attention."
            ],
            "before": "red, blue (ordered tokens)",
            "after": "y=[1,1] (two-dimensional count vector)"
          }
        ],
        "relations": [
