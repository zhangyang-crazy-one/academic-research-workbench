#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON=""
for candidate in "${ARW_PYTHON:-}" python3.15 python3.14 python3.13 python3 python; do
  [[ -n "$candidate" ]] || continue
  resolved="$(command -v -- "$candidate" 2>/dev/null || true)"
  [[ -n "$resolved" ]] || continue
  if "$resolved" -c 'import sys; raise SystemExit(0 if sys.version_info[:2] >= (3, 13) else 1)'; then
    PYTHON="$resolved"
    break
  fi
done
if [[ -z "$PYTHON" ]]; then
  printf 'smoke-staged-plugin: Python >=3.13 is required\n' >&2
  exit 78
fi

exec "$PYTHON" - "$PROJECT_ROOT" "$@" <<'PY'
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


PROJECT_ROOT = Path(sys.argv[1]).resolve()
PLUGIN_NAME = "academic-research-workbench"
MARKETPLACE_NAME = "arw-isolated"
AUTH_PATTERN = re.compile(
    r"not authenticated|not logged in|unauthorized|\b401\b|\b403\b|please run[^\n]*login",
    re.IGNORECASE,
)
PRIVATE_PATH = re.compile(
    r"(^|/)(?:\.env|\.git|\.building[^/]*|barriers?|extractions?|generations?|receipts?|"
    r"papers?|runs?|indexes?|credentials?|private)(?:/|$)|"
    r"\.(?:db|sqlite3?|pem|key)$",
    re.IGNORECASE,
)
SHA256_PATTERN = re.compile(r"^[0-9a-f]{64}$")
HOOK_EVENTS = ("SessionStart", "SubagentStop", "Stop")
HOOK_CONTROL_SURFACES = ("runtime", "mcp", "integrity", "gate", "provenance")
HOOK_RECEIPT_KEYS = {
    "agent_type_sha256",
    "authority",
    "cwd_sha256",
    "hook_definition_sha256",
    "hook_event_name",
    "input_sha256",
    "model_sha256",
    "parent_controls",
    "permission_mode",
    "plugin_root_sha256",
    "receipt_sha256",
    "redacted_error_code",
    "schema_version",
    "session_id_sha256",
    "source",
    "status",
    "stop_hook_active",
    "subject_id_sha256",
    "turn_id_sha256",
}


class CanaryDefect(RuntimeError):
    pass


class _DuplicateJsonKey(ValueError):
    pass


def reject_json_constant(token: str) -> None:
    raise ValueError(token)


def strict_json_object(raw: bytes, *, label: str) -> dict[str, object]:
    def object_pairs(pairs: list[tuple[str, object]]) -> dict[str, object]:
        result: dict[str, object] = {}
        for key, value in pairs:
            if key in result:
                raise _DuplicateJsonKey(key)
            result[key] = value
        return result

    try:
        payload = json.loads(
            raw,
            parse_constant=reject_json_constant,
            object_pairs_hook=object_pairs,
        )
    except (_DuplicateJsonKey, UnicodeDecodeError, ValueError) as error:
        raise CanaryDefect(f"{label} is not strict JSON: {error}") from error
    if not isinstance(payload, dict):
        raise CanaryDefect(f"{label} is not a JSON object")
    return payload


def canonical_json_bytes(payload: object) -> bytes:
    return (
        json.dumps(
            payload,
            allow_nan=False,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        )
        + "\n"
    ).encode("utf-8")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="smoke-staged-plugin",
        description="Qualify exact installed plugin bytes in an isolated Codex host.",
    )
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument(
        "--install-cli",
        action="store_true",
        help="Run the Plan 01 installed CLI health canary.",
    )
    modes.add_argument(
        "--route",
        action="store_true",
        help="Converge the installed skill route and compatibility canary.",
    )
    modes.add_argument(
        "--mcp",
        action="store_true",
        help="Qualify the installed file-base MCP with one bounded read.",
    )
    modes.add_argument(
        "--version",
        action="store_true",
        help="Qualify the installed packaged build-identity report.",
    )
    parser.add_argument("--fresh-home", required=True, type=Path)
    parser.add_argument("--evidence-root", required=True, type=Path)
    parser.add_argument("--max-attempts", type=int, default=1)
    parser.add_argument(
        "stage_root",
        nargs="?",
        type=Path,
        default=PROJECT_ROOT / "build/stage" / PLUGIN_NAME,
    )
    args = parser.parse_args(sys.argv[2:])
    if args.max_attempts < 1 or args.max_attempts > 9:
        parser.error("--max-attempts must be between 1 and 9")
    return args


def write_json(path: Path, payload: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(payload, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )


def file_inventory(root: Path) -> tuple[list[str], dict[str, str], str]:
    entries: list[tuple[str, str]] = []
    aggregate = hashlib.sha256()
    for path in root.rglob("*"):
        relative = path.relative_to(root).as_posix()
        if path.is_symlink():
            raise CanaryDefect(f"stage symlink rejected: {relative}")
        if path.is_file():
            if PRIVATE_PATH.search(relative):
                raise CanaryDefect(f"private path class rejected: {relative}")
            entries.append((relative, hashlib.sha256(path.read_bytes()).hexdigest()))
    entries.sort()
    for relative, digest in entries:
        aggregate.update(relative.encode() + b"\0" + digest.encode() + b"\n")
    return (
        [relative for relative, _ in entries],
        dict(entries),
        aggregate.hexdigest(),
    )


def command_environment(home: Path, codex_home: Path) -> dict[str, str]:
    # The installed Codex package may expose only its canonical Node launcher
    # (the system `codex` shim is not guaranteed to survive host cleanup).
    # Materialize a per-canary command shim so all recorded probes exercise the
    # exact installed host without mutating PATH or relying on a caller alias.
    configured = os.environ.get("ARW_CODEX_EXECUTABLE")
    discovered = configured or shutil.which("codex")
    if not discovered:
        raise CanaryDefect(
            "Codex launcher is unavailable; set ARW_CODEX_EXECUTABLE or install codex on PATH"
        )
    launcher = Path(discovered).resolve()
    if not launcher.is_file():
        raise CanaryDefect(f"Codex launcher is unavailable: {launcher}")
    shim = home.parent / "codex"
    command = (
        f"exec /usr/bin/node {launcher.as_posix()} \"$@\"\n"
        if launcher.suffix == ".js"
        else f"exec {launcher.as_posix()} \"$@\"\n"
    )
    shim.write_text("#!/bin/sh\n" + command, encoding="utf-8")
    shim.chmod(0o700)
    environment = {
        "PATH": f"{home.parent}:{os.environ.get('PATH', '')}",
        "HOME": str(home),
        "CODEX_HOME": str(codex_home),
        "TMPDIR": "/tmp",
        "PYTHONNOUSERSITE": "1",
        "PIP_NO_INDEX": "1",
    }
    for name in (
        "ALL_PROXY",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "SSL_CERT_FILE",
        "SSL_CERT_DIR",
    ):
        if value := os.environ.get(name):
            environment[name] = value
    return environment


def run_recorded(
    command: list[str],
    *,
    cwd: Path,
    environment: dict[str, str],
    evidence: Path,
    stdout_name: str = "stdout.log",
    input_text: str | None = None,
    timeout: int | None = None,
) -> subprocess.CompletedProcess[str]:
    evidence.mkdir(parents=True, exist_ok=True)
    completed = subprocess.run(
        command,
        cwd=cwd,
        env=environment,
        text=True,
        capture_output=True,
        check=False,
        input=input_text,
        timeout=timeout,
    )
    (evidence / stdout_name).write_text(completed.stdout, encoding="utf-8")
    (evidence / "stderr.log").write_text(completed.stderr, encoding="utf-8")
    write_json(evidence / "exit.json", {"status": completed.returncode})
    return completed


def write_command(
    path: Path,
    argv: list[str],
    *,
    tool_network_access: str | None = None,
) -> None:
    environment = {
        "CODEX_HOME": "<isolated-codex-home>",
        "HOME": "<isolated-home>",
        "PIP_NO_INDEX": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": "unset",
        "TMPDIR": "<isolated-temporary-directory>",
    }
    if tool_network_access is not None:
        environment["tool_network_access"] = tool_network_access
    write_json(
        path,
        {
            "argv": argv,
            "cwd": "<isolated-working-directory>",
            "environment": environment,
        },
    )


def marketplace_payload(path: Path) -> None:
    write_json(
        path,
        {
            "name": MARKETPLACE_NAME,
            "interface": {"displayName": "ARW Isolated Qualification"},
            "plugins": [
                {
                    "name": PLUGIN_NAME,
                    "source": {
                        "source": "local",
                        "path": f"./plugins/{PLUGIN_NAME}",
                    },
                    "policy": {
                        "installation": "AVAILABLE",
                        "authentication": "ON_INSTALL",
                    },
                    "category": "Productivity",
                }
            ],
        },
    )


def bwrap_prefix(fresh_root: Path, unrelated_cwd: Path, *, offline: bool) -> list[str]:
    command = [
        "bwrap",
        "--die-with-parent",
        "--ro-bind",
        "/",
        "/",
        "--dev",
        "/dev",
        "--proc",
        "/proc",
        "--tmpfs",
        str(PROJECT_ROOT),
        "--tmpfs",
        "/tmp",
        "--chmod",
        "1777",
        "/tmp",
        "--bind",
        str(fresh_root),
        str(fresh_root),
        "--chdir",
        str(unrelated_cwd),
    ]
    if offline:
        command.insert(1, "--unshare-net")
    return command


def inspect_installed_hook_definition(installed_root: Path) -> dict[str, object]:
    components: list[bytes] = []
    file_digests: dict[str, str] = {}
    for relative in ("hooks/hooks.json", "hooks/arw_hook.py"):
        path = installed_root / relative
        try:
            resolved = path.resolve(strict=True)
            resolved.relative_to(installed_root)
            raw = resolved.read_bytes()
        except (OSError, RuntimeError, ValueError) as error:
            raise CanaryDefect(f"installed hook definition is unsafe: {relative}") from error
        if path.is_symlink() or not resolved.is_file() or not raw or len(raw) > 256 * 1024:
            raise CanaryDefect(f"installed hook definition is invalid: {relative}")
        file_digests[relative] = hashlib.sha256(raw).hexdigest()
        components.extend((relative.encode("utf-8"), b"\0", raw, b"\0"))

    hooks_path = installed_root / "hooks/hooks.json"
    hooks = strict_json_object(hooks_path.read_bytes(), label="installed hooks.json")
    configured = hooks.get("hooks")
    if not isinstance(configured, dict) or set(configured) != set(HOOK_EVENTS):
        raise CanaryDefect("installed hooks.json does not configure the exact lifecycle events")
    commands: dict[str, str] = {}
    for event in HOOK_EVENTS:
        groups = configured.get(event)
        try:
            handler = groups[0]["hooks"][0]
            command = handler["command"]
        except (IndexError, KeyError, TypeError) as error:
            raise CanaryDefect(f"installed {event} hook definition is malformed") from error
        if (
            not isinstance(command, str)
            or "${PLUGIN_ROOT}/hooks/arw_hook.py" not in command
            or "CODEX_PLUGIN_ROOT" in command
        ):
            raise CanaryDefect(f"installed {event} hook does not use official PLUGIN_ROOT")
        commands[event] = command
    definition_sha256 = hashlib.sha256(b"".join(components)).hexdigest()
    return {
        "authority": "observational-only",
        "commands": commands,
        "definition_sha256": definition_sha256,
        "events": list(HOOK_EVENTS),
        "files": file_digests,
        "receipt_contract": "arw.codex-hook-observation.v1",
    }


def install_exact_stage(
    stage_root: Path,
    fresh_root: Path,
    evidence: Path,
    *,
    copy_auth: bool,
) -> dict[str, Any]:
    shutil.rmtree(fresh_root, ignore_errors=True)
    home = fresh_root / "home"
    codex_home = fresh_root / "codex-home"
    marketplace_root = fresh_root / "marketplace"
    marketplace_plugin = marketplace_root / "plugins" / PLUGIN_NAME
    unrelated_cwd = fresh_root / "unrelated-working-directory"
    for directory in (home, codex_home, marketplace_plugin.parent, unrelated_cwd):
        directory.mkdir(parents=True, exist_ok=True)
    shutil.copytree(stage_root, marketplace_plugin)
    marketplace_payload(marketplace_root / ".agents/plugins/marketplace.json")

    if copy_auth:
        caller_codex_home = Path(
            os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))
        )
        auth_file = Path(
            os.environ.get("ARW_CODEX_AUTH_FILE", str(caller_codex_home / "auth.json"))
        )
        if not auth_file.is_file():
            raise PermissionError(
                "Codex authentication is unavailable; set ARW_CODEX_AUTH_FILE to an existing auth.json"
            )
        shutil.copyfile(auth_file, codex_home / "auth.json")
        (codex_home / "auth.json").chmod(0o600)

    stage_files, stage_digests, stage_sha = file_inventory(stage_root)
    market_files, market_digests, market_sha = file_inventory(marketplace_plugin)
    if (stage_files, stage_digests, stage_sha) != (
        market_files,
        market_digests,
        market_sha,
    ):
        raise CanaryDefect("marketplace copy differs from exact stage")
    write_json(evidence / "stage/inventory.json", {"files": stage_files, "symlinks": []})
    write_json(
        evidence / "stage/digests.json",
        {"files": stage_digests, "stage_sha256": stage_sha},
    )

    environment = command_environment(home, codex_home)
    validate_dir = evidence / "plugin/validate"
    write_command(
        validate_dir / "command.json",
        ["codex", "plugin", "marketplace", "add", "./<isolated-marketplace>", "--json"],
    )
    validate = run_recorded(
        ["codex", "plugin", "marketplace", "add", "./marketplace", "--json"],
        cwd=fresh_root,
        environment=environment,
        evidence=validate_dir,
    )
    write_json(
        validate_dir / "verdict.json",
        {"status": "PASS" if validate.returncode == 0 else "FAIL"},
    )
    if validate.returncode != 0:
        raise CanaryDefect("isolated marketplace validation failed")

    install_dir = evidence / "plugin/install"
    write_command(
        install_dir / "command.json",
        ["codex", "plugin", "add", f"{PLUGIN_NAME}@{MARKETPLACE_NAME}", "--json"],
    )
    install = run_recorded(
        ["codex", "plugin", "add", f"{PLUGIN_NAME}@{MARKETPLACE_NAME}", "--json"],
        cwd=fresh_root,
        environment=environment,
        evidence=install_dir,
    )
    write_json(
        install_dir / "verdict.json",
        {"status": "PASS" if install.returncode == 0 else "FAIL"},
    )
    if install.returncode != 0:
        raise CanaryDefect("isolated plugin install failed")

    manifests = sorted(codex_home.glob("plugins/cache/**/.codex-plugin/plugin.json"))
    if len(manifests) != 1:
        raise CanaryDefect(
            f"expected exactly one installed plugin manifest, found {len(manifests)}"
        )
    installed_root = manifests[0].parent.parent
    if not os.access(installed_root / "bin/arw", os.X_OK):
        raise CanaryDefect("installed launcher is missing")
    installed_files, installed_digests, installed_sha = file_inventory(installed_root)
    if (stage_files, stage_digests, stage_sha) != (
        installed_files,
        installed_digests,
        installed_sha,
    ):
        raise CanaryDefect("installed plugin differs from exact stage")
    manifest = json.loads(manifests[0].read_text(encoding="utf-8"))
    identity = {
        "installed_manifest_version": manifest["version"],
        "installed_sha256": installed_sha,
        "stage_sha256": stage_sha,
    }
    write_json(evidence / "plugin/installed-identity.json", identity)
    hook_definition = inspect_installed_hook_definition(installed_root)
    write_json(evidence / "plugin/hook-definition.json", hook_definition)
    return {
        "home": home,
        "codex_home": codex_home,
        "environment": environment,
        "fresh_root": fresh_root,
        "identity": identity,
        "hook_definition": hook_definition,
        "installed_root": installed_root,
        "unrelated_cwd": unrelated_cwd,
    }


def offline_installed_command(
    installed: dict[str, Any],
    arguments: list[str],
    evidence: Path,
) -> subprocess.CompletedProcess[str]:
    installed_root: Path = installed["installed_root"]
    write_command(
        evidence / "command.json",
        ["<installed-plugin>/bin/arw", *arguments],
        tool_network_access="disabled",
    )
    command = [
        *bwrap_prefix(installed["fresh_root"], installed["unrelated_cwd"], offline=True),
        "--clearenv",
        "--setenv",
        "PATH",
        os.environ["PATH"],
        "--setenv",
        "HOME",
        str(installed["home"]),
        "--setenv",
        "CODEX_HOME",
        str(installed["codex_home"]),
        "--setenv",
        "PYTHONNOUSERSITE",
        "1",
        "--setenv",
        "PIP_NO_INDEX",
        "1",
        "--setenv",
        "TMPDIR",
        "/tmp",
        str(installed_root / "bin/arw"),
        *arguments,
    ]
    return run_recorded(
        command,
        cwd=installed["unrelated_cwd"],
        environment=os.environ.copy(),
        evidence=evidence,
    )


def redact_evidence(root: Path, replacements: dict[str, str]) -> None:
    for path in root.rglob("*"):
        if not path.is_file() or path.suffix not in {".log", ".jsonl"}:
            continue
        contents = path.read_text(encoding="utf-8", errors="replace")
        for original, replacement in sorted(
            replacements.items(), key=lambda item: len(item[0]), reverse=True
        ):
            if original:
                contents = contents.replace(original, replacement)
        path.write_text(contents, encoding="utf-8")
    write_json(
        root / "redactions.json",
        {
            "policy": "replace repository, operator-home, stage, installed, and isolated absolute prefixes",
            "tokens": sorted(set(replacements.values())),
        },
    )


def run_install_cli(args: argparse.Namespace) -> int:
    stage_root = args.stage_root.resolve()
    fresh_root = args.fresh_home.resolve()
    evidence_root = args.evidence_root.resolve()
    if not stage_root.is_dir():
        raise CanaryDefect("stage root is missing")
    if (stage_root / "vendor/sources").exists():
        raise CanaryDefect("vendor/sources must remain absent in Plan 01")
    shutil.rmtree(evidence_root, ignore_errors=True)
    installed = install_exact_stage(
        stage_root,
        fresh_root,
        evidence_root,
        copy_auth=False,
    )
    launcher_dir = evidence_root / "plugin/launcher"
    health = offline_installed_command(installed, ["health", "--json"], launcher_dir)
    write_json(
        launcher_dir / "verdict.json",
        {"status": "PASS" if health.returncode == 0 else "FAIL"},
    )
    if health.returncode != 0:
        raise CanaryDefect("installed offline launcher failed")
    write_json(
        evidence_root / "summary.json",
        {
            "inherited_pythonpath": False,
            "installed_from_exact_stage": True,
            "network_isolation": "linux-user-network-namespace",
            "source_imported": False,
            "stage_name": PLUGIN_NAME,
            "technical_qualification": "PASS",
        },
    )
    redact_evidence(
        evidence_root,
        {
            str(PROJECT_ROOT): "<repository-root>",
            str(Path.home()): "<operator-home>",
            str(fresh_root): "<isolated-root>",
            str(stage_root): "<stage-root>",
            str(installed["installed_root"]): "<installed-plugin>",
        },
    )
    print("installed stage smoke passed")
    return 0


def rpc_request(identifier: int, method: str, params: dict[str, object]) -> str:
    return json.dumps(
        {"jsonrpc": "2.0", "id": identifier, "method": method, "params": params},
        ensure_ascii=False,
        separators=(",", ":"),
    )


def nested_text_contains(value: object, needle: str) -> bool:
    if isinstance(value, str):
        return needle in value
    if isinstance(value, list):
        return any(nested_text_contains(item, needle) for item in value)
    if isinstance(value, dict):
        return any(
            nested_text_contains(key, needle) or nested_text_contains(item, needle)
            for key, item in value.items()
        )
    return False


def run_mcp(args: argparse.Namespace) -> int:
    stage_root = args.stage_root.resolve()
    fresh_root = args.fresh_home.resolve()
    evidence_root = args.evidence_root.resolve()
    if stage_root in {Path("/"), PROJECT_ROOT} or fresh_root == Path("/"):
        raise CanaryDefect("refusing unsafe stage or fresh-home root")

    shutil.rmtree(evidence_root, ignore_errors=True)
    shutil.rmtree(fresh_root, ignore_errors=True)
    evidence_root.mkdir(parents=True)
    cachebuster = f"mcp-{datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S')}-{os.getpid()}"
    stage_build = evidence_root / "stage-build"
    stage_evidence = stage_build / "stage-evidence"
    write_command(
        stage_build / "command.json",
        [
            "<repository-root>/scripts/stage-plugin",
            "--clean",
            "--stage-root",
            "<stage-root>",
            "--cachebuster",
            cachebuster,
        ],
    )
    staged = run_recorded(
        [
            str(PROJECT_ROOT / "scripts/stage-plugin"),
            "--clean",
            "--stage-root",
            str(stage_root),
            "--cachebuster",
            cachebuster,
            "--evidence-root",
            str(stage_evidence),
        ],
        cwd=PROJECT_ROOT,
        environment=os.environ.copy(),
        evidence=stage_build,
    )
    if staged.returncode != 0:
        raise CanaryDefect("clean MCP restage failed")

    installed = install_exact_stage(
        stage_root,
        fresh_root,
        evidence_root,
        copy_auth=False,
    )
    installed_root: Path = installed["installed_root"]
    config_path = installed_root / ".mcp.json"
    try:
        config = json.loads(config_path.read_text(encoding="utf-8"))
        server = config["mcpServers"]["file-base"]
        configured_command = server["command"]
    except (OSError, json.JSONDecodeError, KeyError, TypeError) as error:
        raise CanaryDefect(f"installed MCP config is invalid: {error}") from error
    if configured_command != "./scripts/file-base-mcp":
        raise CanaryDefect("installed MCP command is not plugin-root-relative")
    launcher = (installed_root / configured_command).resolve()
    if not launcher.is_relative_to(installed_root) or not os.access(launcher, os.X_OK):
        raise CanaryDefect("installed MCP launcher does not resolve inside the plugin")

    list_dir = evidence_root / "plugin/mcp/list"
    write_command(
        list_dir / "command.json",
        ["codex", "mcp", "list", "--json"],
        tool_network_access="disabled",
    )
    listed = run_recorded(
        ["codex", "mcp", "list", "--json"],
        cwd=installed["unrelated_cwd"],
        environment=installed["environment"],
        evidence=list_dir,
        timeout=30,
    )
    try:
        listed_payload: object = json.loads(listed.stdout)
    except json.JSONDecodeError:
        listed_payload = None
    host_listed = (
        listed.returncode == 0
        and nested_text_contains(listed_payload, "file-base")
        and nested_text_contains(listed_payload, configured_command)
    )
    if not host_listed:
        raise CanaryDefect("installed Codex host did not list the plugin MCP server")

    fixture_root = fresh_root / "mcp-fixture"
    cache_dir = fresh_root / "mcp-cache"
    shutil.copytree(
        PROJECT_ROOT / "tests/fixtures/confinement/allowed",
        fixture_root,
    )
    cache_dir.mkdir()
    read_request = {
        "schema_version": "1.0.0",
        "allowed_root": "phase1-fixture",
        "relative_path": "paper.tex",
        "max_bytes": 4096,
        "max_lines": 200,
    }
    requests = [
        rpc_request(1, "tools/list", {}),
        rpc_request(
            2,
            "tools/call",
            {"name": "read_file", "arguments": read_request},
        ),
    ]
    mcp_dir = evidence_root / "plugin/mcp"
    write_json(mcp_dir / "request.json", read_request)
    write_command(
        mcp_dir / "command.json",
        ["<installed-plugin>/scripts/file-base-mcp"],
        tool_network_access="disabled",
    )
    command = [
        *bwrap_prefix(fresh_root, installed["unrelated_cwd"], offline=True),
        "--clearenv",
        "--setenv",
        "PATH",
        os.environ["PATH"],
        "--setenv",
        "HOME",
        str(installed["home"]),
        "--setenv",
        "CODEX_HOME",
        str(installed["codex_home"]),
        "--setenv",
        "TMPDIR",
        "/tmp",
        "--setenv",
        "CBM_ALLOWED_ROOT",
        str(fixture_root),
        "--setenv",
        "CBM_ALLOWED_ROOT_ID",
        "phase1-fixture",
        "--setenv",
        "CBM_CACHE_DIR",
        str(cache_dir),
        "--setenv",
        "CBM_DISABLE_UPDATE_CHECK",
        "1",
        "--setenv",
        "CBM_LOG_LEVEL",
        "warn",
        str(launcher),
    ]
    invoked = run_recorded(
        command,
        cwd=installed["unrelated_cwd"],
        environment=os.environ.copy(),
        evidence=mcp_dir,
        input_text="\n".join(requests) + "\n",
        timeout=15,
    )
    try:
        responses = [
            json.loads(line) for line in invoked.stdout.splitlines() if line.strip()
        ]
        result = json.loads(responses[1]["result"]["content"][0]["text"])
    except (json.JSONDecodeError, IndexError, KeyError, TypeError) as error:
        raise CanaryDefect(f"installed MCP returned invalid JSON-RPC: {error}") from error
    if invoked.returncode != 0 or len(responses) != 2 or result.get("status") != "ok":
        raise CanaryDefect("installed MCP bounded read failed")

    write_json(mcp_dir / "responses.json", responses)
    write_json(mcp_dir / "result.json", result)
    write_json(
        mcp_dir / "config-probe.json",
        {
            "configured_command": configured_command,
            "host_listed": True,
            "resolved_inside_installed_plugin": True,
            "server_name": "file-base",
            "technical_qualification": "PASS",
        },
    )
    write_json(
        evidence_root / "summary.json",
        {
            "explicit_allowed_root": True,
            "explicit_cache": True,
            "inherited_pythonpath": False,
            "installed_from_exact_stage": True,
            "mcp_transport": "json-rpc-2.0-line-delimited-stdio",
            "network_isolation": "linux-user-network-namespace",
            "source_imported": False,
            "stage_name": PLUGIN_NAME,
            "technical_qualification": "PASS",
        },
    )
    redact_evidence(
        evidence_root,
        {
            str(PROJECT_ROOT): "<repository-root>",
            str(Path.home()): "<operator-home>",
            str(fresh_root): "<isolated-root>",
            str(stage_root): "<stage-root>",
            str(installed_root): "<installed-plugin>",
        },
    )
    print("installed MCP smoke passed")
    return 0


def run_version(args: argparse.Namespace) -> int:
    stage_root = args.stage_root.resolve()
    fresh_root = args.fresh_home.resolve()
    evidence_root = args.evidence_root.resolve()
    if stage_root in {Path("/"), PROJECT_ROOT} or fresh_root == Path("/"):
        raise CanaryDefect("refusing unsafe stage or fresh-home root")
    shutil.rmtree(evidence_root, ignore_errors=True)
    shutil.rmtree(fresh_root, ignore_errors=True)
    evidence_root.mkdir(parents=True)
    staged = run_recorded(
        [
            str(PROJECT_ROOT / "scripts/stage-plugin"),
            "--clean",
            "--stage-root",
            str(stage_root),
            "--evidence-root",
            str(evidence_root / "stage"),
        ],
        cwd=PROJECT_ROOT,
        environment=os.environ.copy(),
        evidence=evidence_root / "stage-build",
    )
    if staged.returncode != 0:
        raise CanaryDefect("clean version restage failed")
    installed = install_exact_stage(stage_root, fresh_root, evidence_root, copy_auth=False)
    version_dir = evidence_root / "plugin/version"
    reported = offline_installed_command(installed, ["version", "--json"], version_dir)
    try:
        payload = json.loads(reported.stdout)
    except json.JSONDecodeError as error:
        raise CanaryDefect(f"installed version output is invalid JSON: {error}") from error
    if reported.returncode != 0 or payload.get("command") != "version":
        raise CanaryDefect("installed version report failed")
    write_json(version_dir / "report.json", payload)
    redact_evidence(
        evidence_root,
        {
            str(PROJECT_ROOT): "<repository-root>",
            str(Path.home()): "<operator-home>",
            str(fresh_root): "<isolated-root>",
            str(stage_root): "<stage-root>",
            str(installed["installed_root"]): "<installed-plugin>",
        },
    )
    print("installed version smoke passed")
    return 0


def route_command_evidence(stdout: str) -> list[dict[str, object]]:
    evidence: list[dict[str, object]] = []
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") != "item.completed":
            continue
        item = event.get("item")
        if not isinstance(item, dict) or item.get("type") != "command_execution":
            continue
        command = str(item.get("command", ""))
        launcher_mentioned = "bin/arw" in command
        route_mentioned = re.search(r"route\s+--json", command) is not None
        if not launcher_mentioned or not route_mentioned:
            continue
        output = str(item.get("aggregated_output", ""))
        exit_code = item.get("exit_code")
        status = item.get("status")
        evidence.append(
            {
                "command_sha256": hashlib.sha256(command.encode("utf-8")).hexdigest(),
                "event_id": item.get("id"),
                "exit_code": exit_code,
                "output_sha256": hashlib.sha256(output.encode("utf-8")).hexdigest(),
                "route_arguments_mentioned": True,
                "route_launcher_mentioned": True,
                "status": status,
                "successful": exit_code == 0 and status == "completed",
            }
        )
    return evidence


def _is_sha256(value: object) -> bool:
    return isinstance(value, str) and SHA256_PATTERN.fullmatch(value) is not None


def _sha256_or_none(value: object) -> bool:
    return value is None or _is_sha256(value)


def validate_hook_receipt(
    path: Path,
    *,
    receipt_root: Path,
    installed_root: Path,
    expected_definition_sha256: str,
) -> dict[str, object]:
    try:
        root = receipt_root.resolve(strict=True)
        resolved = path.resolve(strict=True)
        resolved.relative_to(root)
        raw = resolved.read_bytes()
    except (OSError, RuntimeError, ValueError) as error:
        raise CanaryDefect("installed hook receipt escaped its plugin data root") from error
    if (
        receipt_root.is_symlink()
        or path.is_symlink()
        or not root.is_dir()
        or not resolved.is_file()
        or not raw
        or len(raw) > 32 * 1024
    ):
        raise CanaryDefect("installed hook receipt path or size is unsafe")
    receipt = strict_json_object(raw, label="installed Codex hook receipt")
    if set(receipt) != HOOK_RECEIPT_KEYS:
        raise CanaryDefect("installed Codex hook receipt fields drifted")
    if raw != canonical_json_bytes(receipt):
        raise CanaryDefect("installed Codex hook receipt bytes are not canonical")

    receipt_sha256 = receipt.get("receipt_sha256")
    unsigned = dict(receipt)
    unsigned.pop("receipt_sha256", None)
    expected_receipt_sha256 = hashlib.sha256(canonical_json_bytes(unsigned)).hexdigest()
    if (
        receipt_sha256 != expected_receipt_sha256
        or resolved.name != f"{expected_receipt_sha256}.json"
    ):
        raise CanaryDefect("installed Codex hook receipt is not content addressed")
    if receipt.get("schema_version") != "arw.codex-hook-observation.v1":
        raise CanaryDefect("installed Codex hook receipt contract drifted")
    if receipt.get("authority") != "observational" or receipt.get("status") != "observed":
        raise CanaryDefect("installed Codex hook receipt claimed authority")
    if receipt.get("redacted_error_code") is not None:
        raise CanaryDefect("installed Codex hook receipt reported an adapter error")
    if receipt.get("hook_event_name") not in HOOK_EVENTS:
        raise CanaryDefect("installed Codex hook receipt event is unsupported")
    if receipt.get("hook_definition_sha256") != expected_definition_sha256:
        raise CanaryDefect("installed Codex hook receipt binds another definition")
    installed_root_sha256 = hashlib.sha256(
        str(installed_root.resolve()).encode("utf-8")
    ).hexdigest()
    if receipt.get("plugin_root_sha256") != installed_root_sha256:
        raise CanaryDefect("installed Codex hook receipt binds another plugin root")
    for field in (
        "cwd_sha256",
        "input_sha256",
        "model_sha256",
        "plugin_root_sha256",
        "session_id_sha256",
    ):
        if not _is_sha256(receipt.get(field)):
            raise CanaryDefect(f"installed Codex hook receipt has an invalid {field}")
    for field in (
        "agent_type_sha256",
        "subject_id_sha256",
        "turn_id_sha256",
    ):
        if not _sha256_or_none(receipt.get(field)):
            raise CanaryDefect(f"installed Codex hook receipt has an invalid {field}")
    event = receipt["hook_event_name"]
    if event == "SessionStart":
        if (
            receipt.get("source") not in {"startup", "resume", "clear", "compact"}
            or receipt.get("turn_id_sha256") is not None
            or receipt.get("subject_id_sha256") is not None
            or receipt.get("agent_type_sha256") is not None
            or receipt.get("stop_hook_active") is not None
        ):
            raise CanaryDefect("installed SessionStart receipt fields are inconsistent")
    elif event == "SubagentStop":
        if (
            not _is_sha256(receipt.get("turn_id_sha256"))
            or not _is_sha256(receipt.get("subject_id_sha256"))
            or not _is_sha256(receipt.get("agent_type_sha256"))
            or receipt.get("source") is not None
            or type(receipt.get("stop_hook_active")) is not bool
        ):
            raise CanaryDefect("installed SubagentStop receipt fields are inconsistent")
    elif (
        not _is_sha256(receipt.get("turn_id_sha256"))
        or receipt.get("subject_id_sha256") is not None
        or receipt.get("agent_type_sha256") is not None
        or receipt.get("source") is not None
        or type(receipt.get("stop_hook_active")) is not bool
    ):
        raise CanaryDefect("installed Stop receipt fields are inconsistent")
    if receipt.get("permission_mode") not in {
        "default",
        "acceptEdits",
        "plan",
        "dontAsk",
        "bypassPermissions",
    }:
        raise CanaryDefect("installed Codex hook receipt permission mode drifted")
    controls = receipt.get("parent_controls")
    expected_controls = [
        {"surface": surface, "parent_enforced": True, "hook_bypass_safe": True}
        for surface in HOOK_CONTROL_SURFACES
    ]
    if controls != expected_controls:
        raise CanaryDefect("installed Codex hook receipt changed parent-owned controls")
    return receipt


def collect_hook_evidence(
    installed: dict[str, Any],
    evidence_dir: Path,
    *,
    trust_mode: str,
) -> dict[str, object]:
    definition = installed["hook_definition"]
    definition_sha256 = str(definition["definition_sha256"])
    data_root: Path = installed["codex_home"] / "plugins/data"
    receipt_roots = sorted(data_root.glob("*/hook-observations/v1"))
    summary: dict[str, object] = {
        "authority": "none",
        "definition_sha256": definition_sha256,
        "receipt_contract": definition["receipt_contract"],
        "receipt_count": 0,
        "receipt_events": [],
        "receipt_sha256": [],
        "trust_mode": trust_mode,
        "valid": True,
    }
    try:
        if len(receipt_roots) > 1:
            raise CanaryDefect("multiple plugin hook receipt roots were discovered")
        receipts: list[dict[str, object]] = []
        if receipt_roots:
            receipt_root = receipt_roots[0]
            paths = sorted(receipt_root.glob("*.json"))
            if len(paths) > 16:
                raise CanaryDefect("installed hook emitted too many receipts")
            retained = evidence_dir / "receipts"
            retained.mkdir(parents=True, exist_ok=True)
            for path in paths:
                receipt = validate_hook_receipt(
                    path,
                    receipt_root=receipt_root,
                    installed_root=installed["installed_root"],
                    expected_definition_sha256=definition_sha256,
                )
                receipts.append(receipt)
                shutil.copyfile(path, retained / path.name)
        summary["receipt_count"] = len(receipts)
        summary["receipt_events"] = sorted(
            {str(receipt["hook_event_name"]) for receipt in receipts}
        )
        summary["receipt_sha256"] = sorted(
            str(receipt["receipt_sha256"]) for receipt in receipts
        )
    except CanaryDefect as error:
        summary["error"] = str(error)
        summary["valid"] = False
    write_json(evidence_dir / "evidence.json", summary)
    return summary


def next_attempt_number(evidence_root: Path) -> int:
    attempts = evidence_root / "plugin/route/attempts"
    existing = [
        int(path.name)
        for path in attempts.glob("[0-9][0-9][0-9]")
        if path.name.isdigit()
    ]
    return max(existing, default=0) + 1


def classify_attempt(
    attempt: str,
    installed: dict[str, Any],
    host: subprocess.CompletedProcess[str],
    direct_result: dict[str, object],
    host_result_path: Path,
    hook_evidence: dict[str, object],
    *,
    hook_trust_mode: str,
) -> dict[str, object]:
    streams = f"{host.stdout}\n{host.stderr}"
    command_evidence = route_command_evidence(host.stdout)
    invoked = any(record["successful"] for record in command_evidence)
    receipt_count = int(hook_evidence.get("receipt_count", 0))
    receipt_events = hook_evidence.get("receipt_events", [])
    if receipt_count and hook_trust_mode == "automation-bypass":
        hook_status = "automation-bypass-executed"
    elif receipt_count and hook_trust_mode == "persisted-trust":
        hook_status = "persisted-trusted-executed"
    elif hook_trust_mode == "automation-bypass":
        hook_status = "automation-bypass-no-receipt"
    else:
        hook_status = "persisted-trust-not-proven"
    if AUTH_PATTERN.search(streams):
        classification = "authentication-required"
        reason = "Codex host reported an explicit authentication failure"
        route_result = None
    else:
        try:
            route_result = json.loads(host_result_path.read_text(encoding="utf-8"))
        except (FileNotFoundError, json.JSONDecodeError):
            route_result = None
        if not hook_evidence.get("valid"):
            classification = "non-authentication-defect"
            reason = f"installed hook evidence was invalid: {hook_evidence.get('error')}"
        elif hook_trust_mode == "automation-bypass" and (
            receipt_count < 1 or "SessionStart" not in receipt_events
        ):
            classification = "non-authentication-defect"
            reason = "automation hook bypass did not retain a valid SessionStart receipt"
        elif host.returncode == 0 and route_result == direct_result and invoked:
            classification = "pass"
            reason = (
                "fresh installed host invoked the installed skill route and retained "
                "non-authoritative hook evidence"
            )
        else:
            classification = "non-authentication-defect"
            reason = (
                "host route did not return the direct installed route or lacked "
                "installed command evidence"
            )
    return {
        "attempt": attempt,
        "classification": classification,
        "hook_definition_sha256": hook_evidence.get("definition_sha256"),
        "hook_receipt_count": receipt_count,
        "hook_receipt_events": receipt_events,
        "hook_status": hook_status,
        "hook_trust_mode": hook_trust_mode,
        "host_status": host.returncode,
        "installed_command_evidence": command_evidence,
        "installed_identity_sha256": installed["identity"]["installed_sha256"],
        "installed_skill_invoked": invoked,
        "reason": reason,
        "route_result": route_result,
    }


def run_host_route(
    installed: dict[str, Any],
    attempt_dir: Path,
) -> subprocess.CompletedProcess[str]:
    host_result = installed["fresh_root"] / "host-result.json"
    command = [
        *bwrap_prefix(installed["fresh_root"], installed["unrelated_cwd"], offline=False),
        "--clearenv",
    ]
    for name, value in installed["environment"].items():
        command.extend(["--setenv", name, value])
    command.extend(
        [
            "codex",
            "exec",
            "--ephemeral",
            "--dangerously-bypass-hook-trust",
            "--ignore-rules",
            "--skip-git-repo-check",
            "--sandbox",
            "read-only",
            "-c",
            'approval_policy="never"',
            "--json",
            "--output-last-message",
            str(host_result),
            "-C",
            str(installed["unrelated_cwd"]),
            (
                "This is an execution canary. Use the shell tool: locate the installed "
                "academic-research-workbench SKILL.md under $CODEX_HOME/plugins/cache, read it, "
                "then derive the plugin root exactly two parent directories above SKILL.md "
                "(skill directory -> skills directory -> plugin root), and execute that root's "
                "bin/arw route --json command exactly once. Return the command's raw JSON "
                "unchanged. A response "
                "without a command_execution event is invalid; do not answer from memory, "
                "schema constants, or repository source."
            ),
        ]
    )
    write_command(
        attempt_dir / "command.json",
        [
            "codex",
            "exec",
            "--ephemeral",
            "--dangerously-bypass-hook-trust",
            "--sandbox",
            "read-only",
            "<installed-skill-route-prompt>",
        ],
        tool_network_access="disabled",
    )
    completed = run_recorded(
        command,
        cwd=installed["unrelated_cwd"],
        environment=os.environ.copy(),
        evidence=attempt_dir,
        stdout_name="stdout.jsonl",
    )
    if host_result.is_file():
        shutil.copyfile(host_result, attempt_dir / "host-result.json")
    return completed


def finalize_route(
    evidence_root: Path,
    attempt_dir: Path,
    installed: dict[str, Any],
    classification: dict[str, object],
) -> None:
    route_root = evidence_root / "plugin/route"
    direct_target = route_root / "direct"
    shutil.rmtree(direct_target, ignore_errors=True)
    shutil.copytree(attempt_dir / "direct", direct_target)
    shutil.copyfile(
        installed["installed_root"] / "schemas/v1/route-result.schema.json",
        route_root / "route-result.schema.json",
    )
    write_json(
        route_root / "final.json",
        {
            "attempt": classification["attempt"],
            "route_result": classification["route_result"],
        },
    )
    shutil.copyfile(
        attempt_dir / "installed/plugin/installed-identity.json",
        evidence_root / "plugin/installed-identity.json",
    )

    attempt_records = [
        json.loads(path.read_text(encoding="utf-8"))
        for path in sorted((route_root / "attempts").glob("*/classification.json"))
    ]
    compatibility = {
        "schema_version": "1.0.0",
        "technical_qualification": "PASS",
        "host": {
            "authentication_material_retained": False,
            "codex_version": subprocess.run(
                ["codex", "--version"],
                text=True,
                capture_output=True,
                check=False,
            ).stdout.strip(),
            "fresh_process": True,
            "installed_skill_invoked": True,
        },
        "hooks": {
            "authority": "none",
            "canonical_write": False,
            "contract": "default-plugin-hooks-file",
            "definition_sha256": classification["hook_definition_sha256"],
            "mode": "observational-read-only",
            "receipt_contract": "arw.codex-hook-observation.v1",
            "receipt_count": classification["hook_receipt_count"],
            "receipt_events": classification["hook_receipt_events"],
            "status": classification["hook_status"],
            "trust": (
                "automation-bypass-not-persisted"
                if classification["hook_trust_mode"] == "automation-bypass"
                else "persisted-trust"
            ),
        },
        "custom_agents": {
            "plugin_distribution": "unproven",
            "fallback": [
                "native-codex-subagents",
                "immutable-assignment-injected-roles",
            ],
        },
        "experiments": {"execution": "disabled", "ownership": "deferred"},
        "attempts": [
            {
                "attempt": record["attempt"],
                "classification": record["classification"],
                "hook_receipt_count": record.get("hook_receipt_count", 0),
                "hook_status": record["hook_status"],
                "installed_identity_sha256": record["installed_identity_sha256"],
                "successful_installed_commands": sum(
                    1
                    for command in record.get("installed_command_evidence", [])
                    if command.get("successful")
                ),
                "reason": record["reason"],
            }
            for record in attempt_records
        ],
        "unresolved_non_authentication_results": [],
    }
    write_json(evidence_root / "plugin/compatibility/result.json", compatibility)
    write_json(
        evidence_root / "summary.json",
        {
            "inherited_pythonpath": False,
            "installed_from_exact_stage": True,
            "network_isolation": "installed-command-linux-user-network-namespace",
            "route_final_attempt": classification["attempt"],
            "source_imported": False,
            "stage_name": PLUGIN_NAME,
            "technical_qualification": "PASS",
        },
    )


def run_route(args: argparse.Namespace) -> int:
    stage_root = args.stage_root.resolve()
    fresh_root = args.fresh_home.resolve()
    evidence_root = args.evidence_root.resolve()
    if stage_root in {Path("/"), PROJECT_ROOT} or fresh_root == Path("/"):
        raise CanaryDefect("refusing unsafe stage or fresh-home root")
    evidence_root.mkdir(parents=True, exist_ok=True)
    shutil.rmtree(fresh_root, ignore_errors=True)
    start = next_attempt_number(evidence_root)
    last_reason = "no attempts executed"

    for number in range(start, start + args.max_attempts):
        attempt = f"{number:03d}"
        attempt_dir = evidence_root / "plugin/route/attempts" / attempt
        attempt_fresh = fresh_root / f"attempt-{attempt}"
        cachebuster = (
            f"route-{datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S')}-{attempt}-{os.getpid()}"
        )
        stage_build = attempt_dir / "stage-build"
        write_command(
            stage_build / "command.json",
            [
                "<repository-root>/scripts/stage-plugin",
                "--clean",
                "--stage-root",
                "<stage-root>",
                "--cachebuster",
                cachebuster,
            ],
        )
        staged = run_recorded(
            [
                str(PROJECT_ROOT / "scripts/stage-plugin"),
                "--clean",
                "--stage-root",
                str(stage_root),
                "--cachebuster",
                cachebuster,
            ],
            cwd=PROJECT_ROOT,
            environment=os.environ.copy(),
            evidence=stage_build,
        )
        if staged.returncode != 0:
            classification = {
                "attempt": attempt,
                "classification": "non-authentication-defect",
                "hook_status": "not-probed",
                "host_status": None,
                "installed_identity_sha256": None,
                "installed_skill_invoked": False,
                "reason": "clean restage failed",
                "route_result": None,
            }
            write_json(attempt_dir / "classification.json", classification)
            last_reason = str(classification["reason"])
            continue

        try:
            installed = install_exact_stage(
                stage_root,
                attempt_fresh,
                attempt_dir / "installed",
                copy_auth=True,
            )
        except PermissionError as error:
            classification = {
                "attempt": attempt,
                "classification": "authentication-required",
                "hook_status": "not-probed",
                "host_status": None,
                "installed_identity_sha256": None,
                "installed_skill_invoked": False,
                "reason": str(error),
                "route_result": None,
            }
            write_json(attempt_dir / "classification.json", classification)
            redact_evidence(
                evidence_root,
                {
                    str(PROJECT_ROOT): "<repository-root>",
                    str(Path.home()): "<operator-home>",
                    str(fresh_root): "<isolated-root>",
                    str(stage_root): "<stage-root>",
                },
            )
            print(
                "smoke-staged-plugin: authentication required; run `codex login`, then retry the same route command",
                file=sys.stderr,
            )
            return 77
        except CanaryDefect as error:
            (attempt_fresh / "codex-home/auth.json").unlink(missing_ok=True)
            classification = {
                "attempt": attempt,
                "classification": "non-authentication-defect",
                "hook_status": "not-probed",
                "host_status": None,
                "installed_identity_sha256": None,
                "installed_skill_invoked": False,
                "reason": str(error),
                "route_result": None,
            }
            write_json(attempt_dir / "classification.json", classification)
            last_reason = str(error)
            continue

        health = offline_installed_command(
            installed,
            ["health", "--json"],
            attempt_dir / "health",
        )
        direct = offline_installed_command(
            installed,
            ["route", "--json"],
            attempt_dir / "direct",
        )
        if health.returncode != 0 or direct.returncode != 0:
            (installed["codex_home"] / "auth.json").unlink(missing_ok=True)
            classification = {
                "attempt": attempt,
                "classification": "non-authentication-defect",
                "hook_status": "not-probed",
                "host_status": None,
                "installed_identity_sha256": installed["identity"]["installed_sha256"],
                "installed_skill_invoked": False,
                "reason": "offline installed health or route failed",
                "route_result": None,
            }
            write_json(attempt_dir / "classification.json", classification)
            last_reason = str(classification["reason"])
            continue
        try:
            direct_result = json.loads(direct.stdout)
        except json.JSONDecodeError:
            direct_result = {}
        write_json(attempt_dir / "direct/result.json", direct_result)
        shutil.copyfile(
            installed["installed_root"] / "schemas/v1/route-result.schema.json",
            attempt_dir / "direct/route-result.schema.json",
        )
        try:
            host = run_host_route(installed, attempt_dir)
        finally:
            (installed["codex_home"] / "auth.json").unlink(missing_ok=True)
        hook_trust_mode = "automation-bypass"
        hook_evidence = collect_hook_evidence(
            installed,
            attempt_dir / "hook",
            trust_mode=hook_trust_mode,
        )
        classification = classify_attempt(
            attempt,
            installed,
            host,
            direct_result,
            attempt_dir / "host-result.json",
            hook_evidence,
            hook_trust_mode=hook_trust_mode,
        )
        write_json(attempt_dir / "classification.json", classification)
        last_reason = str(classification["reason"])
        if classification["classification"] == "authentication-required":
            redact_evidence(
                evidence_root,
                {
                    str(PROJECT_ROOT): "<repository-root>",
                    str(Path.home()): "<operator-home>",
                    str(fresh_root): "<isolated-root>",
                    str(stage_root): "<stage-root>",
                    str(installed["installed_root"]): "<installed-plugin>",
                },
            )
            print(
                "smoke-staged-plugin: authentication required; run `codex login`, then retry the same route command",
                file=sys.stderr,
            )
            return 77
        if classification["classification"] != "pass":
            continue

        finalize_route(evidence_root, attempt_dir, installed, classification)
        redact_evidence(
            evidence_root,
            {
                str(PROJECT_ROOT): "<repository-root>",
                str(Path.home()): "<operator-home>",
                str(fresh_root): "<isolated-root>",
                str(stage_root): "<stage-root>",
                str(installed["installed_root"]): "<installed-plugin>",
            },
        )
        print(f"installed route smoke passed on attempt {attempt}")
        return 0

    redact_evidence(
        evidence_root,
        {
            str(PROJECT_ROOT): "<repository-root>",
            str(Path.home()): "<operator-home>",
            str(fresh_root): "<isolated-root>",
            str(stage_root): "<stage-root>",
        },
    )
    print(
        f"smoke-staged-plugin: route convergence exhausted: {last_reason}",
        file=sys.stderr,
    )
    return 70


def main() -> int:
    args = parse_args()
    try:
        if args.version:
            return run_version(args)
        if args.mcp:
            return run_mcp(args)
        if args.route:
            return run_route(args)
        return run_install_cli(args)
    except CanaryDefect as error:
        print(f"smoke-staged-plugin: {error}", file=sys.stderr)
        return 70


raise SystemExit(main())
