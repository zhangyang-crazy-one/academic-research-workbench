#!/usr/bin/env python3
"""Read-only, bounded indicators for an external skill admission review."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
from pathlib import Path

POLICY_ID = "arw-skill-import-static-v1"
MAX_BYTES = 128 * 1024
MAX_MATCHES = 20
PATTERNS = {
    "shell_execution": re.compile(
        r"\b(?:Bash|curl|wget|shell|execute_command)\b", re.IGNORECASE
    ),
    "network_access": re.compile(
        r"https?://|\b(?:HTTP|API calls?|WebFetch)\b", re.IGNORECASE
    ),
    "credential_access": re.compile(
        r"\.env\b|\b[A-Z][A-Z0-9_]*_API_KEY\b|\b(?:credential|secret|token)\b",
        re.IGNORECASE,
    ),
    "self_citation": re.compile(
        r"\b(?:Always cite|Citing Scientific Agent Skills|add the paper to the references)\b",
        re.IGNORECASE,
    ),
    "write_instruction": re.compile(
        r"\b(?:write|save|create|modify|delete)\b", re.IGNORECASE
    ),
}


def scan(source: Path) -> dict:
    if source.is_symlink() or not source.is_file():
        raise ValueError("source must be a regular non-symlink file")
    if source.stat().st_size > MAX_BYTES:
        raise ValueError(f"source exceeds {MAX_BYTES} byte limit")
    data = source.read_bytes()
    if len(data) > MAX_BYTES:
        raise ValueError(f"source exceeds {MAX_BYTES} byte limit")
    body = data.decode("utf-8", errors="strict")
    findings = []
    for category, pattern in PATTERNS.items():
        matches = [
            number
            for number, line in enumerate(body.splitlines(), 1)
            if pattern.search(line)
        ]
        findings.append(
            {
                "category": category,
                "count": len(matches),
                "sample_lines": matches[:MAX_MATCHES],
            }
        )
    return {
        "policy_id": POLICY_ID,
        "source_sha256": hashlib.sha256(data).hexdigest(),
        "source_bytes": len(data),
        "findings": findings,
        "interpretation": "Indicators for human review only; no safety certification or execution permission.",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path)
    args = parser.parse_args()
    try:
        print(json.dumps(scan(args.source), sort_keys=True, ensure_ascii=False))
    except (OSError, UnicodeError, ValueError) as exc:
        parser.exit(1, f"scan-skill-import: {exc}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
