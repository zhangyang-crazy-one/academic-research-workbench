#!/usr/bin/env python3
"""Serial, fail-closed evidence verifier for Phase 7.

The verifier deliberately consumes retained receipts instead of treating a
projection, a test boolean, or a caller supplied identity as authority.  It
owns one evidence directory, executes commands serially, and always separates
technical qualification from the unresolved legal release gate.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


