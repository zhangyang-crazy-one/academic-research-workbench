def _expected_command_argv(name: str) -> list[str]:
    """Return the only command shapes that can establish Phase 7 evidence."""

    if name == "phase7-focused":
        return [str(PYTHON), "-m", "pytest", "-q", "tests/integration/test_phase7_installed_e2e.py", "tests/integration/test_phase7_fault_matrix.py", "tests/staged/test_phase7_qualification.py"]
    if name == "stage-validate":
        # Paths are checked structurally below because the CLI records the
        # concrete stage/lock roots used by this invocation.
        return ["./scripts/stage-plugin", "--stage-root", "<stage>", "--validate-only", "--integration-lock", "<lock>"]
    if name == "phase7-nonhost":
        return [str(PYTHON), "-m", "pytest", "-q", "-m", "not codex_host"]
    if name == "phase7-host-canary":
        return [str(PYTHON), "-m", "pytest", "-q", "tests/staged/test_phase7_qualification.py::test_exact_stage_inventory_sbmom_build_identity_and_host_lock", "tests/staged/test_phase7_qualification.py::test_official_hook_definition_is_observational_and_parity_inputs_are_present"]
    raise KeyError(name)


def _command_argv_matches(name: str, argv: object, stage_summary: ValidatedStageSummary) -> bool:
    if not isinstance(argv, list) or any(not isinstance(item, str) for item in argv):
        return False
    expected = _expected_command_argv(name)
    if name != "stage-validate":
        return argv == expected
    return (
        len(argv) == len(expected)
        and argv[0] == expected[0]
        and argv[1] == expected[1]
        and argv[3] == expected[3]
        and argv[4] == expected[4]
        and Path(argv[2]).resolve() == (PROJECT_ROOT / stage_summary.stage_relative_path).resolve()
        and Path(argv[5]).resolve() == (PROJECT_ROOT / stage_summary.lock_relative_path).resolve()
    )
STAGE_BASE = (PROJECT_ROOT / "build/stage").resolve()
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
GIT_SHA_RE = re.compile(r"^[0-9a-f]{40}$")

# The verifier is intentionally a positive-environment subprocess boundary.
# Credentials and profile discovery variables are not inherited even when a
# caller happens to export them in its shell.
