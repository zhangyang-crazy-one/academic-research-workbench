)
SECRET_MARKER_RE = re.compile(
    r"(?i)(?:openai[_-]?api[_-]?key|api[_-]?key|access[_-]?token|refresh[_-]?token|"
    r"password|passwd|authorization|bearer|private[_-]?key|client[_-]?secret|"
    r"secret[_-]?(?:key|token|value)?|\bsk-[A-Za-z0-9_-]{8,})"
)


class ValidatedReceiptSummary:
    """Receipt summary produced only by the prior-phase validators."""

    __slots__ = ("phase5_graph", "phase41_independence", "_token")

    def __init__(self, phase5_graph: dict[str, Any], phase41_independence: dict[str, Any], *, _token: object | None = None) -> None:
        self.phase5_graph = phase5_graph
        self.phase41_independence = phase41_independence
        self._token = _token

    @property
    def is_validated(self) -> bool:
        return self._token is _VALIDATION_TOKEN

    def __getitem__(self, key: str) -> dict[str, Any]:
        if key == "phase5_graph":
            return self.phase5_graph
        if key == "phase41_independence":
            return self.phase41_independence
        raise KeyError(key)

    def to_dict(self) -> dict[str, Any]:
        return {
            "phase5_graph": self.phase5_graph,
            "phase41_independence": self.phase41_independence,
        }


class ValidatedStageSummary:
    __slots__ = ("stage_sha256", "integration_lock_sha256", "host_canary_sha256", "stage_relative_path", "lock_relative_path", "canary_relative_path", "_token")

    def __init__(self, *, stage_sha256: str, integration_lock_sha256: str, host_canary_sha256: str, stage_relative_path: str, lock_relative_path: str, canary_relative_path: str, _token: object | None = None) -> None:
        self.stage_sha256 = stage_sha256
        self.integration_lock_sha256 = integration_lock_sha256
        self.host_canary_sha256 = host_canary_sha256
        self.stage_relative_path = stage_relative_path
        self.lock_relative_path = lock_relative_path
        self.canary_relative_path = canary_relative_path
        self._token = _token

    @property
    def is_validated(self) -> bool:
        return self._token is _VALIDATION_TOKEN

    def to_dict(self) -> dict[str, Any]:
        return {
            "stage_sha256": self.stage_sha256,
            "integration_lock_sha256": self.integration_lock_sha256,
            "host_canary_sha256": self.host_canary_sha256,
            "stage_relative_path": self.stage_relative_path,
            "lock_relative_path": self.lock_relative_path,
            "canary_relative_path": self.canary_relative_path,
        }


class ValidatedCommandReceipt(dict[str, Any]):
    """Opaque command receipt produced by this verifier's subprocess boundary."""

    __slots__ = ("result_path",)

    def __init__(self, record: dict[str, Any], result_path: Path, *, _token: object | None = None) -> None:
        if _token is not _COMMAND_TOKEN:
            raise TypeError("command receipts are verifier-owned")
        super().__init__(record)
        self.result_path = result_path


class VerificationError(RuntimeError):
    """A missing, stale, unsafe, or inconsistent qualification input."""

    def __init__(self, message: str, code: int = 70) -> None:
        super().__init__(message)
        self.code = code


def canonical(value: object) -> bytes:
    return (json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode("utf-8")


def digest_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def digest_file(path: Path) -> str:
    try:
        return digest_bytes(path.read_bytes())
    except OSError as error:
        raise VerificationError(f"missing evidence file: {path}") from error


def worktree_digest() -> str:
    """Bind the exact dirty source tree used by the serial verifier."""

    try:
        status = subprocess.check_output(
            ["git", "status", "--porcelain=v1", "--untracked-files=all", "--", ".", ":(exclude)build"],
            cwd=PROJECT_ROOT,
        )
        diff = subprocess.check_output(
            ["git", "diff", "--binary", "HEAD", "--", ".", ":(exclude)build"],
            cwd=PROJECT_ROOT,
        )
        paths = subprocess.check_output(
            ["git", "ls-files", "--others", "--exclude-standard", "-z", "--", ".", ":(exclude)build"],
            cwd=PROJECT_ROOT,
        ).split(b"\0")
        untracked = []
        for raw in paths:
            if not raw:
                continue
            path = PROJECT_ROOT / os.fsdecode(raw)
            if path.is_symlink():
                content = os.readlink(path).encode("utf-8")
            else:
                content = path.read_bytes()
            untracked.append((os.fsdecode(raw), digest_bytes(content)))
    except (OSError, subprocess.SubprocessError) as error:
        raise VerificationError("unable to bind verifier worktree") from error
    return digest_bytes(canonical({"status": status.decode("utf-8", "replace"), "diff_sha256": digest_bytes(diff), "untracked": sorted(untracked)}))


def read_json(path: Path) -> dict[str, Any]:
    try:
        mode = path.lstat().st_mode
    except OSError as error:
        raise VerificationError(f"missing or unsafe JSON evidence: {path}") from error
    if stat.S_ISLNK(mode) or not stat.S_ISREG(mode):
        raise VerificationError(f"missing or unsafe JSON evidence: {path}")
    try:
        def reject_duplicate_pairs(pairs: list[tuple[str, object]]) -> dict[str, object]:
            result: dict[str, object] = {}
            for key, item in pairs:
                if key in result:
                    raise ValueError(f"duplicate JSON object key: {key}")
                result[key] = item
            return result

        raw = path.read_bytes()
        value = json.loads(
            raw,
            object_pairs_hook=reject_duplicate_pairs,
            parse_constant=lambda token: (_ for _ in ()).throw(
                ValueError(f"non-finite JSON number rejected: {token}")
            ),
        )
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        raise VerificationError(f"invalid JSON evidence {path}: {error}") from error
    if not isinstance(value, dict):
        raise VerificationError(f"JSON evidence must be an object: {path}")
    return value


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(canonical(value))


def owned_root(raw: Path, *, clean: bool = False) -> Path:
    """Create an owned root below build/evidence; clean only our own root."""

    candidate = raw.expanduser()
    if not candidate.is_absolute():
        candidate = PROJECT_ROOT / candidate
    # Reject traversal lexically.  ``absolute()`` deliberately does not
    # normalize ``..`` and resolving first would allow a path to escape before
    # the ownership check runs.
    if ".." in candidate.parts:
        raise VerificationError("evidence root cannot contain '..' components", 64)
    candidate = candidate.absolute()
    if candidate == EVIDENCE_BASE or not candidate.is_relative_to(EVIDENCE_BASE):
        raise VerificationError(f"evidence root must be below {EVIDENCE_BASE}", 64)
    current = EVIDENCE_BASE
    for component in candidate.relative_to(EVIDENCE_BASE).parts:
        current /= component
        try:
            if stat.S_ISLNK(current.lstat().st_mode):
                raise VerificationError("evidence root cannot contain symlink components", 64)
        except FileNotFoundError:
            # Missing descendants are safe to create; continue checking any
            # later existing component only after its parent is created.
            pass
        except OSError as error:
            raise VerificationError("evidence root component cannot be inspected", 64) from error
    resolved_base = EVIDENCE_BASE.resolve(strict=True)
    root = candidate.resolve(strict=False)
    if root == resolved_base or not root.is_relative_to(resolved_base):
        raise VerificationError("resolved evidence root escaped owned base", 64)
    if root.exists():
        try:
            root_mode = root.lstat().st_mode
        except OSError as error:
            raise VerificationError("evidence root is unsafe", 64) from error
        if stat.S_ISLNK(root_mode) or not stat.S_ISDIR(root_mode):
            raise VerificationError("evidence root is unsafe", 64)
        marker = root / MARKER
        try:
            marker_mode = marker.lstat().st_mode
        except OSError as error:
            raise VerificationError("existing evidence root is not an owned cleanable root", 64) from error
        if not clean or stat.S_ISLNK(marker_mode) or not stat.S_ISREG(marker_mode):
            raise VerificationError("existing evidence root is not an owned cleanable root", 64)
        shutil.rmtree(root)
    root.mkdir(parents=True)
    marker = root / MARKER
    marker.write_text("phase-7 evidence\n", encoding="ascii")
    return root


def _safe_phase7_input(raw: Path, *, base: Path, label: str) -> Path:
    """Validate a lexical input before resolving it.

    Every existing component is inspected with ``lstat`` so a symlink cannot
    be hidden by ``Path.resolve``.  The returned path is the exact resolved
    object that was checked and is later recorded in the stage receipt.
    """

    candidate = raw.expanduser()
    if not candidate.is_absolute():
        candidate = PROJECT_ROOT / candidate
    if ".." in candidate.parts:
        raise VerificationError(f"{label}: path cannot contain '..' components", 64)
    lexical = candidate.absolute()
    resolved_base = base.resolve(strict=True)
    if lexical == resolved_base or not lexical.is_relative_to(resolved_base):
        raise VerificationError(f"{label}: path must remain below {resolved_base}", 64)
    try:
        relative = lexical.relative_to(resolved_base)
    except ValueError as error:
        raise VerificationError(f"{label}: path is outside expected base", 64) from error
    current = resolved_base
    try:
        if stat.S_ISLNK(current.lstat().st_mode):
            raise VerificationError(f"{label}: expected base is a symlink", 64)
    except OSError as error:
        raise VerificationError(f"{label}: expected base cannot be inspected", 64) from error
    parts = relative.parts
    for index, component in enumerate(parts):
        current /= component
        try:
            mode = current.lstat().st_mode
        except FileNotFoundError:
            if index != len(parts) - 1:
                raise VerificationError(f"{label}: missing parent component", 64)
            break
        except OSError as error:
            raise VerificationError(f"{label}: path component cannot be inspected", 64) from error
        if stat.S_ISLNK(mode):
            raise VerificationError(f"{label}: symlink path component is not allowed", 64)
        if index != len(parts) - 1 and not stat.S_ISDIR(mode):
            raise VerificationError(f"{label}: non-directory parent component", 64)
    resolved = lexical.resolve(strict=False)
    if resolved == resolved_base or not resolved.is_relative_to(resolved_base):
        raise VerificationError(f"{label}: resolved path escaped expected base", 64)
    return resolved


def _redact(text: bytes) -> bytes:
    """Keep bounded diagnostics while removing host paths and secret-like data."""

    value = text.decode("utf-8", "replace")
    if SECRET_MARKER_RE.search(value):
        # A secret-bearing stream is not safe to persist.  Do not try to
        # preserve a partially redacted transcript: fail closed before any
        # stdout/stderr evidence is written.
        raise VerificationError("verifier subprocess emitted a secret marker")
    value = value.replace(str(PROJECT_ROOT), "<project>")
    value = re.sub(r"(?:/(?:[^\s:/]+/)+[^\s:]+)", "<path>", value)
    return value[:MAX_CAPTURE].encode("utf-8")


def run_command(root: Path, name: str, argv: list[str], *, env: dict[str, str] | None = None, timeout: int = 600) -> dict[str, Any]:
    """Run one command and retain only bounded, redacted output."""

    command_root = root / "commands" / name
    command_root.mkdir(parents=True, exist_ok=True)
    environment = {key: value for key, value in os.environ.items() if key in SAFE_ENVIRONMENT}
    temporary = PROJECT_ROOT / "build/tmp/phase-07" / name
    temporary.mkdir(parents=True, exist_ok=True)
    isolated_home = temporary / "home"
    isolated_codex_home = temporary / "codex-home"
    isolated_home.mkdir(parents=True, exist_ok=True)
    isolated_codex_home.mkdir(parents=True, exist_ok=True)
    environment.update({"HOME": str(isolated_home), "CODEX_HOME": str(isolated_codex_home), "UV_OFFLINE": "1", "PYTHONNOUSERSITE": "1", "PIP_NO_INDEX": "1", "TMPDIR": str(temporary)})
    if env:
        environment.update({key: value for key, value in env.items() if key in SAFE_ENVIRONMENT})
    # These controls are verifier-owned and cannot be overridden by a caller.
    environment.update({"HOME": str(isolated_home), "CODEX_HOME": str(isolated_codex_home), "UV_OFFLINE": "1", "PYTHONNOUSERSITE": "1", "PIP_NO_INDEX": "1", "TMPDIR": str(temporary)})
    result = subprocess.run(argv, cwd=PROJECT_ROOT, env=environment, capture_output=True, check=False, timeout=timeout)
    stdout = _redact(result.stdout)
    stderr = _redact(result.stderr)
    (command_root / "stdout.log").write_bytes(stdout)
    (command_root / "stderr.log").write_bytes(stderr)
    record = {
        "name": name,
        "argv": argv,
        "cwd": "<project>",
        "returncode": result.returncode,
        "stdout_sha256": digest_bytes(stdout),
        "stderr_sha256": digest_bytes(stderr),
        "stdout_truncated": len(result.stdout) > len(stdout),
        "stderr_truncated": len(result.stderr) > len(stderr),
    }
    write_json(command_root / "result.json", record)
    if result.returncode != 0:
        raise VerificationError(f"{name} failed with exit {result.returncode}")
    return ValidatedCommandReceipt(record, command_root / "result.json", _token=_COMMAND_TOKEN)


def _require_file(path: Path, label: str) -> Path:
    try:
        mode = path.lstat().st_mode
    except OSError as error:
        raise VerificationError(f"{label}: missing or unsafe receipt {path}") from error
    if stat.S_ISLNK(mode) or not stat.S_ISREG(mode):
        raise VerificationError(f"{label}: missing or unsafe receipt {path}")
    return path


def _canonical_receipt(path: Path, label: str) -> tuple[dict[str, Any], str]:
    """Read a strict object and derive its digest from canonical JSON bytes."""

    value = read_json(path)
    try:
        payload = canonical(value)
    except (TypeError, ValueError) as error:
        raise VerificationError(f"{label}: JSON is not canonicalizable") from error
    # A digest over a re-serialized object would otherwise accept a receipt
    # whose bytes were edited after its producer wrote it.  Canonical bytes
    # are part of every retained evidence contract.
    try:
        raw = path.read_bytes()
    except OSError as error:
        raise VerificationError(f"{label}: receipt cannot be read") from error
    if raw != payload:
        raise VerificationError(f"{label}: receipt is not canonical JSON")
    return value, digest_bytes(payload)


def _require_sha(value: object, label: str) -> str:
    if not isinstance(value, str) or not SHA256_RE.fullmatch(value):
        raise VerificationError(f"{label}: expected lowercase SHA-256 digest")
    return value


def _validate_stage_tree(stage_tree: dict[str, Any]) -> tuple[str, str]:
    """Recompute every staged content digest and the build identity digest."""

    rows = stage_tree.get("files")
    if not isinstance(rows, list) or not rows:
        raise VerificationError("phase5-graph-equivalence: stage-tree files are missing")
    seen: set[str] = set()
    stage = PROJECT_ROOT / "build/stage/phase-05"
    if not stage.is_dir() or stage.is_symlink():
        raise VerificationError("phase5-graph-equivalence: retained phase5 stage is missing")
    for item in rows:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str):
            raise VerificationError("phase5-graph-equivalence: malformed stage-tree row")
        relative = item["path"]
        path = Path(relative)
        if path.is_absolute() or ".." in path.parts or relative in seen:
            raise VerificationError("phase5-graph-equivalence: unsafe or duplicate stage-tree path")
        seen.add(relative)
        expected = _require_sha(item.get("sha256"), f"phase5 stage-tree {relative}")
        staged = stage / path
        _require_file(staged, f"phase5 stage-tree {relative}")
        if digest_file(staged) != expected:
            raise VerificationError(f"phase5-graph-equivalence: staged content digest mismatch: {relative}")
    actual = {p.relative_to(stage).as_posix() for p in stage.rglob("*") if p.is_file() and not p.is_symlink()}
    if actual != seen:
        raise VerificationError("phase5-graph-equivalence: stage-tree coverage is incomplete")
    identity = _require_file(stage / "share/arw/build-identity.json", "phase5 build identity")
    # The build identity is generated by the stage builder and its raw bytes
    # are already bound by ``stage_tree.sha256``.  Older retained stages use
    # the builder's pretty JSON formatting, so validate the object strictly
    # without imposing the evidence-receipt canonical encoding on it.
    identity_value = read_json(identity)
    if digest_file(identity) != PHASE5_LOCKED_DIGESTS["stage_identity"]:
        raise VerificationError("phase5-graph-equivalence: build identity is not the qualified parent manifest")
    staged_payloads = identity_value.get("staged_payloads")
    if not isinstance(staged_payloads, list) or not staged_payloads:
        raise VerificationError("phase5-graph-equivalence: build identity parent manifest is missing")
    payload_rows = [
        {"path": item.get("path"), "sha256": item.get("sha256")}
        for item in staged_payloads
        if isinstance(item, dict)
    ]
    if len(payload_rows) != len(staged_payloads) or any(
        not isinstance(item["path"], str) or not SHA256_RE.fullmatch(str(item["sha256"]))
        for item in payload_rows
    ):
        raise VerificationError("phase5-graph-equivalence: malformed build identity parent manifest")
    tree_payload_rows = [
        {"path": row["path"], "sha256": row["sha256"]}
        for row in rows
        if row["path"] not in {"share/arw/build-identity.json", "supply-chain/stage-inventory.json"}
    ]
    if sorted(tree_payload_rows, key=lambda item: item["path"]) != sorted(payload_rows, key=lambda item: item["path"]):
        raise VerificationError("phase5-graph-equivalence: stage tree is not bound to build identity parent manifest")
    inventory_path = PROJECT_ROOT / "build/evidence/phase-05/stage-plugin/inventory.json"
    inventory = read_json(_require_file(inventory_path, "phase5 stage inventory"))
    if digest_file(inventory_path) != PHASE5_LOCKED_DIGESTS["stage_inventory"]:
        raise VerificationError("phase5-graph-equivalence: stage inventory is not the qualified parent manifest")
    inventory_files = inventory.get("files")
    inventory_covered = inventory.get("covered_files")
    if not isinstance(inventory_files, list) or not isinstance(inventory_covered, list):
        raise VerificationError("phase5-graph-equivalence: stage inventory parent manifest is malformed")
    if sorted(inventory_files) != sorted(seen):
        raise VerificationError("phase5-graph-equivalence: stage inventory does not cover stage tree")
    covered_rows = [
        {"path": item.get("path"), "sha256": item.get("sha256")}
        for item in inventory_covered
        if isinstance(item, dict)
    ]
    if sorted(covered_rows, key=lambda item: item["path"]) != sorted(
        [row for row in rows if row["path"] != "supply-chain/stage-inventory.json"],
        key=lambda item: item["path"],
    ):
        raise VerificationError("phase5-graph-equivalence: stage inventory hashes are not bound to stage tree")
    return digest_file(identity), digest_bytes(canonical(sorted((row["path"], row["sha256"]) for row in rows)))


def _validate_phase5(root: Path) -> dict[str, Any]:
    """Validate exact graph-equivalence receipts and locate file-base evidence."""

    verdict_path = _require_file(root / "verdict.json", "phase5 graph verdict")
    summary_path = _require_file(root / "summary.json", "phase5 graph summary")
    stage_tree_path = _require_file(root / "stage-tree.json", "phase5 stage tree")
    verdict, verdict_canonical_sha256 = _canonical_receipt(verdict_path, "phase5 graph verdict")
    summary, summary_canonical_sha256 = _canonical_receipt(summary_path, "phase5 graph summary")
    stage_tree, stage_tree_canonical_sha256 = _canonical_receipt(stage_tree_path, "phase5 stage tree")
    if verdict_canonical_sha256 != PHASE5_LOCKED_DIGESTS["verdict"] or stage_tree_canonical_sha256 != PHASE5_LOCKED_DIGESTS["stage_tree"]:
        raise VerificationError("phase5-graph-equivalence: retained parent evidence digest is not the qualified corpus")
    if verdict.get("technical_qualification") != "PASS" or summary.get("technical_qualification") != "PASS":
        raise VerificationError("phase5-graph-equivalence: technical receipt is not PASS")
    if verdict.get("release_qualification") != "BLOCKED":
        raise VerificationError("phase5-graph-equivalence: release boundary was silently cleared")
    graph_control = root / "graph-control/roots/research-root/selected-generation.json"
    _require_file(graph_control, "phase5 graph-control generation")
    if digest_file(graph_control) != PHASE5_LOCKED_DIGESTS["graph_control"]:
        raise VerificationError("phase5-graph-equivalence: graph-control parent receipt is not qualified")
    mcp_transcript = _require_file(root / "mcp-transcript.json", "phase5 MCP transcript")
    build_candidates = (
        root / ".file-base/build-evidence.json",
        PROJECT_ROOT / "build/stage/phase-05/.file-base/build-evidence.json",
        PROJECT_ROOT / "build/stage/phase-05/.file-base/build-evidence.json",
    )
    build_evidence = next((path for path in build_candidates if path.is_file() and not path.is_symlink()), None)
    if build_evidence is None:
        raise VerificationError("phase5-graph-equivalence: missing exact .file-base/build-evidence.json (fail-closed)")
    stage_rows = stage_tree.get("files")
    stage_identity_digest, stage_rows_digest = _validate_stage_tree(stage_tree)
    row = next((item for item in stage_rows if isinstance(item, dict) and item.get("path") == ".file-base/build-evidence.json"), None)
    if not isinstance(row, dict) or row.get("sha256") != digest_file(build_evidence):
        raise VerificationError("phase5-graph-equivalence: .file-base/build-evidence.json digest mismatch")
    if verdict.get("stage_identity_sha256") != stage_tree.get("sha256") or verdict.get("stage_identity_sha256") != stage_identity_digest:
        raise VerificationError("phase5-graph-equivalence: stage identity is stale")
    if verdict.get("stage_rows_sha256") not in (None, stage_rows_digest):
        raise VerificationError("phase5-graph-equivalence: stage rows digest is stale")
    _require_sha(stage_tree.get("sha256"), "phase5 stage identity")
    transcript_sha = _require_sha(verdict.get("mcp", {}).get("transcript_sha256"), "phase5 MCP transcript")
    if transcript_sha != digest_file(mcp_transcript) or transcript_sha != summary.get("mcp_transcript_sha256"):
        raise VerificationError("phase5-graph-equivalence: MCP transcript digest is stale")
    requirements = verdict.get("requirements")
    required = {"GRAPH-01", "GRAPH-02", "GRAPH-03", "GRAPH-04", "GRAPH-05", "GRAPH-06", "VER-05"}
    if not isinstance(requirements, dict) or any(requirements.get(req, {}).get("status") != "PASS" for req in required):
        raise VerificationError("phase5-graph-equivalence: one or more graph requirements are not PASS")
    return {
        "technical_qualification": "PASS",
        "release_qualification": "BLOCKED",
        "verdict_sha256": verdict_canonical_sha256,
        "summary_sha256": summary_canonical_sha256,
        "stage_tree_sha256": stage_tree_canonical_sha256,
        "stage_rows_sha256": stage_rows_digest,
        "stage_identity_sha256": stage_identity_digest,
        "graph_control_sha256": digest_file(graph_control),
        "mcp_transcript_sha256": digest_file(mcp_transcript),
        "file_base_build_evidence_path": str(build_evidence.relative_to(PROJECT_ROOT)),
        "file_base_build_evidence_sha256": digest_file(build_evidence),
        "requirements": sorted(required),
    }


def _validate_phase41(root: Path) -> dict[str, Any]:
    """Validate retained Phase 4.1 subagent/panel independence receipts."""

    verdict_path = _require_file(root / "verdict.json", "phase4.1 independence verdict")
    verdict, verdict_canonical_sha256 = _canonical_receipt(verdict_path, "phase4.1 independence verdict")
    if verdict_canonical_sha256 != PHASE41_LOCKED_DIGESTS["verdict"]:
        raise VerificationError("phase4.1-subagent-independence: retained verdict is not the qualified corpus")
    if verdict.get("technical_qualification") != "PASS":
        raise VerificationError("phase4.1-subagent-independence: technical receipt is not PASS")
    host_path = _require_file(root / "host/integration-verification.json", "phase4.1 host integration")
    host, host_canonical_sha256 = _canonical_receipt(host_path, "phase4.1 host integration")
    if host_canonical_sha256 != PHASE41_LOCKED_DIGESTS["host_integration"]:
        raise VerificationError("phase4.1-subagent-independence: host integration is not the qualified corpus")
    if host.get("technical_qualification") != "PASS":
        raise VerificationError("phase4.1-subagent-independence: host receipt is not PASS")
    qualification_path = _require_file(root / "host/qualification.json", "phase4.1 host qualification")
    assessment_path = _require_file(root / "host/assessment.json", "phase4.1 host assessment")
    packet_manifest_path = _require_file(root / "review-packet/manifest.json", "phase4.1 review packet")
    packet_status_path = _require_file(root / "review-packet/packet-status.json", "phase4.1 packet status")
    evaluation_path = _require_file(root / "corpus/evaluation-summary.json", "phase4.1 evaluation summary")
    qualification, qualification_canonical_sha256 = _canonical_receipt(qualification_path, "phase4.1 host qualification")
    assessment, assessment_canonical_sha256 = _canonical_receipt(assessment_path, "phase4.1 host assessment")
    if qualification_canonical_sha256 != PHASE41_LOCKED_DIGESTS["host_qualification"] or assessment_canonical_sha256 != PHASE41_LOCKED_DIGESTS["host_assessment"]:
        raise VerificationError("phase4.1-subagent-independence: host qualification is not the qualified corpus")
    packet_manifest, packet_manifest_canonical_sha256 = _canonical_receipt(packet_manifest_path, "phase4.1 review packet")
    packet_status, packet_status_canonical_sha256 = _canonical_receipt(packet_status_path, "phase4.1 packet status")
    evaluation, evaluation_canonical_sha256 = _canonical_receipt(evaluation_path, "phase4.1 evaluation summary")
    if packet_manifest_canonical_sha256 != PHASE41_LOCKED_DIGESTS["packet_manifest"] or packet_status_canonical_sha256 != PHASE41_LOCKED_DIGESTS["packet_status"] or evaluation_canonical_sha256 != PHASE41_LOCKED_DIGESTS["evaluation"]:
        raise VerificationError("phase4.1-subagent-independence: panel/corpus receipt is not the qualified corpus")
    try:
        import jsonschema
        qualification_schema = json.loads((PROJECT_ROOT / "schemas/v1/host-qualification.schema.json").read_text(encoding="utf-8"))
        jsonschema.Draft202012Validator(qualification_schema).validate(qualification)
    except (ImportError, OSError, json.JSONDecodeError, jsonschema.ValidationError) as error:
        raise VerificationError(f"phase4.1-subagent-independence: host qualification schema invalid: {error}") from error
    if assessment.get("status") != "PASS" or assessment.get("exact_tuple") is not True or not assessment.get("canary_returncodes") or any(code != 0 for code in assessment["canary_returncodes"]):
        raise VerificationError("phase4.1-subagent-independence: host assessment is incomplete")
    if packet_status.get("technical_qualification") != "PASS" or packet_status.get("human_gate") != "BLOCKED":
        raise VerificationError("phase4.1-subagent-independence: packet status is incomplete")
    if packet_manifest.get("schema_version") != "arw.phase4-review-packet.v1" or packet_manifest.get("worker_facing_labels_included") is not False:
        raise VerificationError("phase4.1-subagent-independence: review packet schema/status is invalid")
    if packet_manifest.get("technical_verdict_sha256") != verdict_canonical_sha256:
        raise VerificationError("phase4.1-subagent-independence: review packet is not bound to verdict")
    if evaluation.get("schema_version") != "arw.phase4-corpus-evaluation.v1" or evaluation.get("total_cases") != 48 or evaluation.get("sealed_parent_only_cases") != 16:
        raise VerificationError("phase4.1-subagent-independence: evaluation summary is incomplete")
    case_results = sorted((root / "corpus/case-results").glob("*.json"))
    expected_cases = {item.get("case_id") for item in evaluation.get("results", []) if isinstance(item, dict)}
    if len(case_results) != 48 or expected_cases != {path.stem for path in case_results}:
        raise VerificationError("phase4.1-subagent-independence: corpus case results missing")
    case_hashes: dict[str, str] = {}
    try:
        case_schema = json.loads((PROJECT_ROOT / "schemas/v1/phase4-evaluation-verdict.schema.json").read_text(encoding="utf-8"))
        validator = jsonschema.Draft202012Validator(case_schema)
        for path in case_results:
            case, case_digest = _canonical_receipt(path, f"phase4.1 case {path.stem}")
            validator.validate(case)
            if case.get("case_id") != path.stem or case.get("terminal_status") not in {"PASS", "FAIL", "BLOCKED"}:
                raise VerificationError(f"phase4.1-subagent-independence: malformed case {path.stem}")
            case_hashes[path.stem] = case_digest
    except (jsonschema.ValidationError, OSError, json.JSONDecodeError) as error:
        raise VerificationError(f"phase4.1-subagent-independence: case schema invalid: {error}") from error
    for item in evaluation.get("results", []):
        if isinstance(item, dict) and item.get("result_sha256") != case_hashes.get(item.get("case_id")):
            raise VerificationError(f"phase4.1-subagent-independence: case digest mismatch: {item.get('case_id')}")
    packet_cases = packet_manifest.get("cases")
    if not isinstance(packet_cases, list) or packet_manifest.get("case_count") != len(packet_cases):
        raise VerificationError("phase4.1-subagent-independence: review packet case manifest is incomplete")
    case_by_id = {item.get("case_id"): item for item in evaluation.get("results", []) if isinstance(item, dict)}
    for packet_case in packet_cases:
        if not isinstance(packet_case, dict) or packet_case.get("case_id") not in case_by_id:
            raise VerificationError("phase4.1-subagent-independence: review packet case is not in corpus")
        if not SHA256_RE.fullmatch(str(packet_case.get("case_sha256", ""))):
            raise VerificationError("phase4.1-subagent-independence: review packet case hash is malformed")
        if evaluation.get("manifest_sha256") not in packet_case.get("evidence_sha256", []):
            raise VerificationError("phase4.1-subagent-independence: review packet case is not bound to corpus manifest")
    inventory_path = _require_file(root / "raw-evidence-inventory.json", "phase4.1 raw evidence inventory")
    inventory, inventory_canonical_sha256 = _canonical_receipt(inventory_path, "phase4.1 raw evidence inventory")
    if inventory_canonical_sha256 != PHASE41_LOCKED_DIGESTS["inventory"]:
        raise VerificationError("phase4.1-subagent-independence: evidence inventory is not the qualified parent manifest")
    if verdict.get("evidence_index_sha256") != digest_file(inventory_path) or not isinstance(inventory.get("files"), list):
        raise VerificationError("phase4.1-subagent-independence: parent evidence index is stale")
    raw_manifest = verdict.get("raw_evidence_files")
    if not isinstance(raw_manifest, list) or raw_manifest != inventory["files"]:
        raise VerificationError("phase4.1-subagent-independence: verdict parent manifest is not bound to evidence inventory")
    for item in inventory["files"]:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str) or Path(item["path"]).is_absolute() or ".." in Path(item["path"]).parts:
            raise VerificationError("phase4.1-subagent-independence: unsafe inventory path")
        receipt = _require_file(root / item["path"], f"phase4.1 inventory {item['path']}")
        if item.get("sha256") != digest_file(receipt) or item.get("size") != receipt.stat().st_size:
            raise VerificationError(f"phase4.1-subagent-independence: inventory digest mismatch: {item['path']}")
    expected_host_refs = {
        "host/integration-verification.json": digest_file(host_path),
        "host/retained-canary-reference.json": digest_file(root / "host/retained-canary-reference.json"),
    }
    host_evidence = verdict.get("host_qualification", {}).get("evidence_sha256")
    if host_evidence != list(expected_host_refs.values()):
        raise VerificationError("phase4.1-subagent-independence: host evidence is not bound to parent manifest")
    corpus = verdict.get("corpus")
    if not isinstance(corpus, dict) or corpus.get("manifest_sha256") != evaluation.get("manifest_sha256") or corpus.get("fixture_sha256") != evaluation.get("fixture_sha256"):
        raise VerificationError("phase4.1-subagent-independence: corpus receipt is not bound to verdict")
    command_hashes: dict[str, str] = {}
    for task in ("P04-05-T01", "P04-05-T02"):
        path = _require_file(root / f"commands/{task}/exit.json", f"phase4.1 {task}")
        exit_record, _ = _canonical_receipt(path, f"phase4.1 {task}")
        if exit_record.get("returncode") != 0 or exit_record.get("stderr_truncated") is not False or exit_record.get("stdout_truncated") is not False:
            raise VerificationError(f"phase4.1-subagent-independence: {task} failed")
        command_hashes[task] = digest_file(path)
    if verdict.get("execution_verified") not in (False, True):
        raise VerificationError("phase4.1-subagent-independence: malformed execution status")
    return {
        "technical_qualification": "PASS",
        "verdict_sha256": verdict_canonical_sha256,
        "host_integration_sha256": host_canonical_sha256,
        "host_qualification_sha256": qualification_canonical_sha256,
        "host_assessment_sha256": assessment_canonical_sha256,
        "review_packet_sha256": packet_manifest_canonical_sha256,
        "packet_status_sha256": packet_status_canonical_sha256,
        "evaluation_summary_sha256": evaluation_canonical_sha256,
        "evidence_index_sha256": inventory_canonical_sha256,
        "case_result_count": len(case_results),
        "case_results_sha256": digest_bytes(canonical([(path.name, digest_file(path)) for path in case_results])),
        "independence_command_exit_sha256": command_hashes,
        "execution_verified": verdict.get("execution_verified"),
    }


def validate_receipts(*, project_root: Path = PROJECT_ROOT, phase5_root: Path = PHASE5_ROOT, phase41_root: Path = PHASE41_ROOT) -> ValidatedReceiptSummary:
    """Public helper used by verifier tests to validate prior-phase evidence."""

    del project_root  # roots are explicit parameters for tamper probes
    return ValidatedReceiptSummary(_validate_phase5(phase5_root), _validate_phase41(phase41_root), _token=_VALIDATION_TOKEN)


def validate_stage_and_inputs(stage: Path, lock: Path, canary: Path) -> ValidatedStageSummary:
    stage = _safe_phase7_input(stage, base=STAGE_BASE, label="stage-qualification")
    lock = _safe_phase7_input(lock, base=EVIDENCE_BASE, label="stage-qualification")
    canary = _safe_phase7_input(canary, base=EVIDENCE_BASE, label="host-qualification")
    # Callers must pass the result of _safe_phase7_input; repeat direct lstat
    # checks here so this helper remains safe when imported independently.
    for path, label in ((stage, "stage-qualification"), (lock, "stage-qualification"), (canary, "host-qualification")):
        try:
            mode = path.lstat().st_mode
        except OSError as error:
            raise VerificationError(f"{label}: missing or unsafe input {path}") from error
        if stat.S_ISLNK(mode):
            raise VerificationError(f"{label}: symlink input is not allowed {path}")
    if not stage.is_dir():
        raise VerificationError(f"stage-qualification: missing staged package {stage}")
    if not lock.is_file():
        raise VerificationError(f"stage-qualification: missing integration lock {lock}")
    if not canary.is_file():
        raise VerificationError(f"host-qualification: missing exact host canary {canary}")
    lock_data = read_json(lock)
    canary_data = read_json(canary)
    if lock_data.get("technical_qualification") != "PASS":
        raise VerificationError("stage-qualification: integration lock is not technical PASS")
    if lock_data.get("release_qualification") != "BLOCKED":
        raise VerificationError("stage-qualification: legal release boundary was cleared")
    if lock_data.get("codex_host", {}).get("cli_version") != "codex-cli 0.144.4":
        raise VerificationError("host-qualification: exact Codex CLI 0.144.4 is not bound")
    if canary_data.get("live_hook_execution") != "observed" or canary_data.get("secret_material_retained") is not False:
        raise VerificationError("host-qualification: hook/secret hygiene receipt is incomplete")
    staged_paths = {path.relative_to(stage).as_posix() for path in stage.rglob("*") if path.is_file()}
    required = (
        "hooks/arw_hook.py",
        "hooks/hooks.json",
        "SBOM.cdx.json",
        "share/arw/build-identity.json",
        "supply-chain/stage-inventory.json",
        "skills/academic-research-suite/SKILL.md",
        "skills/academic-research-suite/manifest.json",
        "skills/academic-research-suite/VERSION",
    )
    missing = [relative for relative in required if not (stage / relative).is_file()]
    if missing:
        raise VerificationError(f"stage-qualification: required artifact missing: {missing}")
    if not any(path.startswith("skills/academic-research-suite/ars/") for path in staged_paths):
        raise VerificationError("stage-qualification: bundled ARS content tree is empty")
    return ValidatedStageSummary(
        stage_sha256=digest_bytes(canonical(sorted((p.relative_to(stage).as_posix(), digest_file(p)) for p in stage.rglob("*") if p.is_file() and not p.is_symlink()))),
        integration_lock_sha256=digest_file(lock),
        host_canary_sha256=digest_file(canary),
        stage_relative_path=stage.relative_to(PROJECT_ROOT).as_posix(),
        lock_relative_path=lock.relative_to(PROJECT_ROOT).as_posix(),
        canary_relative_path=canary.relative_to(PROJECT_ROOT).as_posix(),
        _token=_VALIDATION_TOKEN,
    )


def _license_verdict() -> dict[str, Any]:
    path = PROJECT_ROOT / "supply-chain/license-verdict.json"
    verdict = read_json(path)
    if verdict.get("technical_qualification") != "PASS":
        raise VerificationError("license-qualification: technical license inventory is not PASS")
    if verdict.get("release_qualification") != "BLOCKED":
        raise VerificationError("license-qualification: unresolved legal gate was cleared")
    return {"sha256": digest_file(path), "technical_qualification": "PASS", "release_qualification": "BLOCKED", "blockers": list(verdict.get("reason_codes", LEGAL_BLOCKERS))}


def _blocked_aggregate(*, reason: str, receipt_summary: object, stage_summary: object, test_commands: list[dict[str, Any]], license_summary: object, git_head: str, git_tree: str, git_worktree: str = "") -> dict[str, Any]:
    blocked_requirements = {requirement: {"status": "BLOCKED", "evidence": [reason]} for requirement in REQUIREMENTS}
    receipts = receipt_summary.to_dict() if isinstance(receipt_summary, ValidatedReceiptSummary) else {}
    stage = stage_summary.to_dict() if isinstance(stage_summary, ValidatedStageSummary) else {}
    return {
        "schema_version": "arw.phase7-verification.v1",
        "phase": "07",
        "git_head": git_head,
        "git_tree": git_tree,
        "git_worktree_sha256": git_worktree,
        "technical_qualification": "BLOCKED",
        "release_qualification": "BLOCKED",
        "release_blockers": list(LEGAL_BLOCKERS),
        "requirements": blocked_requirements,
        "stage": stage,
        "prior_phase_receipts": receipts,
        "commands": test_commands,
        "license": license_summary,
        "evidence_bound": False,
        "technical_blockers": [reason],
    }


def aggregate_verdict(*, receipt_summary: ValidatedReceiptSummary, stage_summary: ValidatedStageSummary, test_commands: list[dict[str, Any]], license_summary: dict[str, Any], git_head: str, git_tree: str, git_worktree: str = "") -> dict[str, Any]:
    """Aggregate only typed validators and successful command receipts."""

    if not isinstance(receipt_summary, ValidatedReceiptSummary) or not receipt_summary.is_validated:
        return _blocked_aggregate(reason="unvalidated-prior-phase-receipts", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
    if not isinstance(stage_summary, ValidatedStageSummary) or not stage_summary.is_validated:
        return _blocked_aggregate(reason="unvalidated-stage-inputs", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
    # Re-read the immutable inputs at the aggregation boundary.  The typed
    # wrappers are intentionally opaque, but a Python caller could otherwise
    # mutate their fields after validation and launder a different corpus.
    try:
        fresh_receipts = validate_receipts()
        fresh_stage = validate_stage_and_inputs(STAGE_ROOT, PHASE7_LOCK, PHASE7_CANARY)
        if receipt_summary.to_dict() != fresh_receipts.to_dict() or stage_summary.to_dict() != fresh_stage.to_dict():
            raise VerificationError("validated summary changed after input qualification")
    except (OSError, VerificationError):
        return _blocked_aggregate(reason="validated-summary-drift", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
    if not isinstance(test_commands, list) or not test_commands:
        return _blocked_aggregate(reason="missing-command-receipts", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands if isinstance(test_commands, list) else [], license_summary=license_summary, git_head=git_head, git_tree=git_tree)
    names = tuple(command.get("name") if isinstance(command, dict) else None for command in test_commands)
    if names != REQUIRED_COMMAND_NAMES:
        return _blocked_aggregate(reason="command-manifest-incomplete-or-unexpected", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
    for index, command in enumerate(test_commands):
        if not isinstance(command, ValidatedCommandReceipt) or command.get("returncode") != 0:
            return _blocked_aggregate(reason=f"command-{index}-failed", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
        try:
            result_path = command.result_path
            if not result_path.is_file() or not result_path.resolve().is_relative_to(EVIDENCE_BASE) or result_path.name != "result.json" or result_path.parent.name != command.get("name") or read_json(result_path) != dict(command) or result_path.read_bytes() != canonical(dict(command)):
                raise VerificationError("command result is not bound to verifier-owned receipt")
            if digest_file(result_path.parent / "stdout.log") != command.get("stdout_sha256") or digest_file(result_path.parent / "stderr.log") != command.get("stderr_sha256"):
                raise VerificationError("command stream digest is not bound to verifier-owned receipt")
        except (OSError, VerificationError) as error:
            return _blocked_aggregate(reason=f"command-{index}-receipt-unbound", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
        for key in ("stdout_sha256", "stderr_sha256"):
            if not SHA256_RE.fullmatch(str(command.get(key, ""))):
                return _blocked_aggregate(reason=f"command-{index}-digest-invalid", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
        argv = command.get("argv")
        if not isinstance(argv, list) or not argv or any(not isinstance(item, str) or not item for item in argv):
            return _blocked_aggregate(reason=f"command-{index}-argv-invalid", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
        if not _command_argv_matches(str(command.get("name")), argv, stage_summary):
            return _blocked_aggregate(reason=f"command-{index}-argv-unexpected", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
        if command.get("cwd") != "<project>" or not isinstance(command.get("stdout_truncated"), bool) or not isinstance(command.get("stderr_truncated"), bool):
            return _blocked_aggregate(reason=f"command-{index}-receipt-invalid", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
    if receipt_summary.phase5_graph.get("technical_qualification") != "PASS" or receipt_summary.phase41_independence.get("technical_qualification") != "PASS":
        return _blocked_aggregate(reason="prior-phase-technical-receipt-not-pass", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
    if not isinstance(license_summary, dict) or license_summary.get("technical_qualification") != "PASS" or license_summary.get("release_qualification") != "BLOCKED":
        return _blocked_aggregate(reason="license-receipt-incomplete", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
    if not GIT_SHA_RE.fullmatch(git_head) or not GIT_SHA_RE.fullmatch(git_tree):
        return _blocked_aggregate(reason="git-identity-invalid", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree)
    if not SHA256_RE.fullmatch(git_worktree):
        return _blocked_aggregate(reason="git-worktree-identity-invalid", receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=test_commands, license_summary=license_summary, git_head=git_head, git_tree=git_tree, git_worktree=git_worktree)
    requirements = {
        "VER-02": {"status": "PASS", "evidence": ["installed-qualification", "stage-qualification", "host-canary"]},
        "VER-04": {"status": "PASS", "evidence": ["recovery-matrix"]},
        "VER-06": {"status": "PASS", "evidence": ["representative-dossier", "representative-dossier-replay"]},
        "VER-08": {"status": "PASS", "evidence": ["phase5-graph-equivalence", "phase41-subagent-independence", "license-verdict"]},
    }
    return {
        "schema_version": "arw.phase7-verification.v1",
        "phase": "07",
        "git_head": git_head,
        "git_tree": git_tree,
        "git_worktree_sha256": git_worktree,
        "technical_qualification": "PASS",
        "release_qualification": "BLOCKED",
        "release_blockers": list(LEGAL_BLOCKERS),
        "requirements": requirements,
        "stage": stage_summary.to_dict(),
        "prior_phase_receipts": receipt_summary.to_dict(),
        "commands": test_commands,
        "license": license_summary,
        "evidence_bound": True,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="verify-phase-7")
    parser.add_argument("--clean", action="store_true")
    parser.add_argument("--evidence-root", type=Path, default=DEFAULT_EVIDENCE_ROOT)
    args = parser.parse_args(argv)
    root: Path | None = None
    try:
        root = owned_root(args.evidence_root, clean=args.clean)
        write_json(root / "preflight.json", {"schema_version": "arw.phase7-preflight.v1", "phase": "07", "started_at": datetime.now(UTC).isoformat().replace("+00:00", "Z"), "git_head": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=PROJECT_ROOT, text=True).strip(), "git_worktree_sha256": worktree_digest()})

        # Existing Wave 1–3 receipts are immutable inputs.  Copy their hashes
        # into the owned root before running commands; never overwrite them.
        receipt_summary = validate_receipts()
        write_json(root / "prior-phase-receipts.json", receipt_summary.to_dict())
        # Validate lexical paths and parent components before resolving.  A
        # resolved target alone cannot prove that the caller did not supply a
        # symlink or escape the project-owned stage/evidence bases.
        stage = _safe_phase7_input(Path(os.environ.get("ARW_PHASE7_STAGE", str(STAGE_ROOT))), base=STAGE_BASE, label="stage-qualification")
        lock = _safe_phase7_input(Path(os.environ.get("ARW_PHASE7_LOCK", str(PHASE7_LOCK))), base=EVIDENCE_BASE, label="stage-qualification")
        canary = _safe_phase7_input(Path(os.environ.get("ARW_PHASE7_CANARY", str(PHASE7_CANARY))), base=EVIDENCE_BASE, label="host-qualification")
        stage_summary = validate_stage_and_inputs(stage, lock, canary)
        write_json(root / "stage-inputs.json", stage_summary.to_dict())
        command_records: list[dict[str, Any]] = []

        # Keep the complete qualification serial and bounded.  The retained
        # stage is validated in place; rebuilding it would invalidate its
        # lock/canary pair when the checkout is intentionally dirty.
        command_records.append(run_command(root, "phase7-focused", [str(PYTHON), "-m", "pytest", "-q", "tests/integration/test_phase7_installed_e2e.py", "tests/integration/test_phase7_fault_matrix.py", "tests/staged/test_phase7_qualification.py"]))
        command_records.append(run_command(root, "stage-validate", ["./scripts/stage-plugin", "--stage-root", str(stage), "--validate-only", "--integration-lock", str(lock)]))
        command_records.append(run_command(root, "phase7-nonhost", [str(PYTHON), "-m", "pytest", "-q", "-m", "not codex_host"]))
        # The exact host canary is retained from the prior serial qualification;
        # the staged probes re-run its schema, version, hook, and hygiene checks.
        command_records.append(run_command(root, "phase7-host-canary", [str(PYTHON), "-m", "pytest", "-q", "tests/staged/test_phase7_qualification.py::test_exact_stage_inventory_sbmom_build_identity_and_host_lock", "tests/staged/test_phase7_qualification.py::test_official_hook_definition_is_observational_and_parity_inputs_are_present"]))

        license_summary = _license_verdict()
        git_head = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=PROJECT_ROOT, text=True).strip()
        git_tree = subprocess.check_output(["git", "rev-parse", "HEAD^{tree}"], cwd=PROJECT_ROOT, text=True).strip()
        git_worktree = worktree_digest()
        verdict = aggregate_verdict(receipt_summary=receipt_summary, stage_summary=stage_summary, test_commands=command_records, license_summary=license_summary, git_head=git_head, git_tree=git_tree, git_worktree=git_worktree)
        write_json(root / "requirements.json", verdict["requirements"])
        write_json(root / "phase-7-verification.json", verdict)
        write_json(root / "verdict.json", verdict)
        write_json(root / "summary.json", {"phase": "07", "technical_qualification": verdict["technical_qualification"], "release_qualification": verdict["release_qualification"], "release_blockers": list(LEGAL_BLOCKERS), "technical_blockers": verdict.get("technical_blockers", []), "evidence_sha256": digest_file(root / "phase-7-verification.json")})
        if verdict["technical_qualification"] != "PASS":
            print(f"Phase 7 technical qualification BLOCKED: {verdict.get('technical_blockers', [])}", file=sys.stderr)
            return 70
        print("Phase 7 technical qualification PASS; release qualification BLOCKED (legal evidence)")
        return 0
    except (OSError, subprocess.SubprocessError, VerificationError, TimeoutError) as error:
        if root is not None:
            write_json(root / "verdict.json", {"schema_version": "arw.phase7-verification.v1", "phase": "07", "technical_qualification": "BLOCKED", "release_qualification": "BLOCKED", "release_blockers": list(LEGAL_BLOCKERS), "error": str(error)})
        print(f"verify-phase-7: {error}", file=sys.stderr)
        return 70


if __name__ == "__main__":
    raise SystemExit(main())
