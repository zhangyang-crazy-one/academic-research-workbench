#!/usr/bin/env bash
set -euo pipefail

# One explicit, fail-closed entry point for a technically qualified stage.
# Network materialization, the offline native build, host canary retention,
# lock creation, and final staging are deliberately separate boundaries.

PROJECT_ROOT="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${ARW_BUILD_PYTHON:-$PROJECT_ROOT/.venv/bin/python}"
[[ -x "$PYTHON" ]] || PYTHON="$(command -v python3 || command -v python || true)"
STAGE_ROOT="$PROJECT_ROOT/build/stage/phase-07-qualified"
EVIDENCE_ROOT="$PROJECT_ROOT/build/evidence/phase-07-qualified"
LOCK_PATH=""
HOST_CANARY=""
CODEX_LAUNCHER=""
CODEX_NATIVE=""
CREDENTIAL_SOURCE=""
CLEAN=0
RUN_NATIVE_TESTS=0
CANDIDATE_WHEEL=""
BUILD_EVIDENCE=""
CANDIDATE_EVIDENCE_ROOT=""

usage() {
  cat <<'EOF'
Usage: prepare-qualified-stage --candidate-wheel PATH --build-evidence PATH \
       --candidate-evidence-root PATH --host-canary-evidence PATH \
       --codex-launcher PATH --codex-native-binary PATH \
       [--credential-source PATH] [--integration-lock PATH] [--clean] \
       [--stage-root PATH] [--evidence-root PATH] [--run-native-tests]

Materialize and verify pinned sources, build the modified file-base through
offline-exec when needed, bind the retained exact Codex host canary into an
integration lock, and assemble/validate the final allowlisted plugin stage.
The command never fabricates host evidence and never turns a missing legal or
technical input into a qualified package.
EOF
}

fail() {
  printf 'prepare-qualified-stage: %s\n' "$1" >&2
  exit "${2:-1}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host-canary-evidence)
      [[ $# -ge 2 ]] || fail "--host-canary-evidence requires a path" 64
      HOST_CANARY="$2"; shift 2
      ;;
    --candidate-wheel)
      [[ $# -ge 2 ]] || fail "--candidate-wheel requires a path" 64
      CANDIDATE_WHEEL="$2"; shift 2
      ;;
    --build-evidence)
      [[ $# -ge 2 ]] || fail "--build-evidence requires a path" 64
      BUILD_EVIDENCE="$2"; shift 2
      ;;
    --candidate-evidence-root)
      [[ $# -ge 2 ]] || fail "--candidate-evidence-root requires a path" 64
      CANDIDATE_EVIDENCE_ROOT="$2"; shift 2
      ;;
    --codex-launcher)
      [[ $# -ge 2 ]] || fail "--codex-launcher requires a path" 64
      CODEX_LAUNCHER="$2"; shift 2
      ;;
    --codex-native-binary)
      [[ $# -ge 2 ]] || fail "--codex-native-binary requires a path" 64
      CODEX_NATIVE="$2"; shift 2
      ;;
    --credential-source)
      [[ $# -ge 2 ]] || fail "--credential-source requires a path" 64
      CREDENTIAL_SOURCE="$2"; shift 2
      ;;
    --integration-lock)
      [[ $# -ge 2 ]] || fail "--integration-lock requires a path" 64
      LOCK_PATH="$2"; shift 2
      ;;
    --stage-root)
      [[ $# -ge 2 ]] || fail "--stage-root requires a path" 64
      STAGE_ROOT="$2"; shift 2
      ;;
    --evidence-root)
      [[ $# -ge 2 ]] || fail "--evidence-root requires a path" 64
      EVIDENCE_ROOT="$2"; shift 2
      ;;
    --clean)
      CLEAN=1; shift
      ;;
    --run-native-tests)
      RUN_NATIVE_TESTS=1; shift
      ;;
    --help|-h)
      usage; exit 0
      ;;
    *)
      fail "unknown argument: $1" 64
      ;;
  esac
done

if ! "$PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 13) else 1)'; then
  [[ -z "${ARW_BUILD_PYTHON:-}" ]] || fail "ARW_BUILD_PYTHON must satisfy Python >=3.13" 66
  PYTHON=""
  for candidate in python3 python; do
    resolved="$(command -v "$candidate" 2>/dev/null || true)"
    if [[ -n "$resolved" ]] && "$resolved" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 13) else 1)'; then
      PYTHON="$resolved"
      break
    fi
  done
  [[ -n "$PYTHON" ]] || fail "build interpreter must satisfy Python >=3.13" 66
fi
STAGE_ROOT="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$STAGE_ROOT")"
EVIDENCE_ROOT="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$EVIDENCE_ROOT")"
for output_root in "$STAGE_ROOT" "$EVIDENCE_ROOT"; do
  [[ "$output_root" != "/" ]] || fail "refusing filesystem root as stage/evidence output" 64
  case "$PROJECT_ROOT" in
    "$output_root"|"$output_root"/*) fail "refusing a repository root or ancestor as stage/evidence output" 64 ;;
  esac
done
case "$STAGE_ROOT" in
  "$EVIDENCE_ROOT"|"$EVIDENCE_ROOT"/*) fail "stage and evidence roots must be disjoint" 64 ;;
esac
case "$EVIDENCE_ROOT" in
  "$STAGE_ROOT"|"$STAGE_ROOT"/*) fail "stage and evidence roots must be disjoint" 64 ;;
esac
for temporary_root in "${TMPDIR:-$PROJECT_ROOT/build/tmp}" "${ARW_STAGE_TMP_ROOT:-$PROJECT_ROOT/build/tmp}"; do
  temporary_root="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$temporary_root")"
  [[ "$temporary_root" != "/" ]] || fail "refusing unsafe temporary root" 64
  case "$PROJECT_ROOT" in
    "$temporary_root"|"$temporary_root"/*) fail "refusing unsafe temporary root" 64 ;;
  esac
  for output_root in "$STAGE_ROOT" "$EVIDENCE_ROOT"; do
    case "$temporary_root" in
      "$output_root"|"$output_root"/*) fail "temporary root must be disjoint from stage/evidence roots" 64 ;;
    esac
    case "$output_root" in
      "$temporary_root"|"$temporary_root"/*) fail "temporary root must be disjoint from stage/evidence roots" 64 ;;
    esac
  done
done
[[ -n "$CANDIDATE_WHEEL" && -n "$BUILD_EVIDENCE" && -n "$CANDIDATE_EVIDENCE_ROOT" ]] \
  || fail "candidate wheel, build evidence and candidate evidence root are required" 64
CANDIDATE_ARGS=(--candidate-wheel "$CANDIDATE_WHEEL" \
  --build-evidence "$BUILD_EVIDENCE" \
  --candidate-evidence-root "$CANDIDATE_EVIDENCE_ROOT")

[[ -n "$HOST_CANARY" ]] || fail "exact retained host canary is required; run scripts/qualify-codex-host first" 65
[[ -n "$CODEX_LAUNCHER" && -x "$CODEX_LAUNCHER" ]] \
  || fail "--codex-launcher must name an executable exact host launcher" 66
[[ -n "$CODEX_NATIVE" && -x "$CODEX_NATIVE" ]] \
  || fail "--codex-native-binary must name an executable exact native binary" 66
[[ -f "$HOST_CANARY" && ! -L "$HOST_CANARY" ]] \
  || fail "host canary must be a direct regular file" 66
if [[ -n "$CREDENTIAL_SOURCE" ]]; then
  [[ -d "$CREDENTIAL_SOURCE" && ! -L "$CREDENTIAL_SOURCE" ]] \
    || fail "credential source must be an existing non-symlink directory" 66
fi

if [[ ! -d "$PROJECT_ROOT/vendor/sources" ]]; then
  "$PROJECT_ROOT/scripts/materialize-sources" --clean
fi
"$PROJECT_ROOT/scripts/verify-sources" --inputs-only

if [[ ! -x "$PROJECT_ROOT/.file-base/bin/file-base" || ! -f "$PROJECT_ROOT/.file-base/build-evidence.json" ]]; then
  NATIVE_EVIDENCE="$EVIDENCE_ROOT/native-build"
  [[ ! -e "$NATIVE_EVIDENCE" ]] || fail "native evidence exists; choose a new --evidence-root or pass --clean" 73
  mkdir -p "$NATIVE_EVIDENCE"
  OFFLINE_ARGS=(--evidence-root "$NATIVE_EVIDENCE" "$PROJECT_ROOT/scripts/build-file-base" --clean)
  if [[ "$RUN_NATIVE_TESTS" -eq 1 ]]; then
    OFFLINE_ARGS+=(--run-upstream-tests)
  fi
  TMPDIR="${TMPDIR:-$PROJECT_ROOT/build/tmp}" \
    "$PROJECT_ROOT/scripts/offline-exec" "${OFFLINE_ARGS[@]}"
fi
"$PROJECT_ROOT/scripts/verify-sources" --inputs-only

if [[ -z "$LOCK_PATH" ]]; then
  LOCK_PATH="$EVIDENCE_ROOT/integration-lock.json"
fi
LOCK_PATH="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$LOCK_PATH")"
mkdir -p "$(dirname -- "$LOCK_PATH")"

BOOTSTRAP_STAGE="$EVIDENCE_ROOT/bootstrap-stage"
BOOTSTRAP_EVIDENCE="$EVIDENCE_ROOT/bootstrap-stage-evidence"
if [[ ! -f "$LOCK_PATH" ]]; then
  [[ ! -e "$BOOTSTRAP_STAGE" && ! -e "$BOOTSTRAP_EVIDENCE" ]] \
    || fail "bootstrap output exists; choose a new --evidence-root or pass --clean" 73
  "$PROJECT_ROOT/scripts/stage-plugin" --clean \
    --stage-root "$BOOTSTRAP_STAGE" --evidence-root "$BOOTSTRAP_EVIDENCE" \
    "${CANDIDATE_ARGS[@]}"
  "$PYTHON" - "$BOOTSTRAP_STAGE" "$CODEX_LAUNCHER" "$CODEX_NATIVE" "$HOST_CANARY" "$LOCK_PATH" <<'PY'
from pathlib import Path
import sys
from arw.kernel.policy.integration_lock import build_integration_lock, write_integration_lock

stage, launcher, native, canary, output = map(Path, sys.argv[1:])
lock = build_integration_lock(
    stage_root=stage,
    codex_launcher=launcher,
    codex_native_binary=native,
    host_canary_evidence=canary,
)
print(f"integration lock: {write_integration_lock(output, lock)}")
PY
else
  [[ -f "$LOCK_PATH" && ! -L "$LOCK_PATH" ]] || fail "integration lock input is unsafe" 66
fi

FINAL_EVIDENCE="$EVIDENCE_ROOT/final-stage"
STAGE_CLEAN=()
[[ "$CLEAN" -eq 0 ]] || STAGE_CLEAN=(--clean)
"$PROJECT_ROOT/scripts/stage-plugin" "${STAGE_CLEAN[@]}" \
  --stage-root "$STAGE_ROOT" --evidence-root "$FINAL_EVIDENCE" \
  --integration-lock "$LOCK_PATH" "${CANDIDATE_ARGS[@]}"
"$PROJECT_ROOT/scripts/stage-plugin" --validate-only \
  --stage-root "$STAGE_ROOT" --integration-lock "$LOCK_PATH"

printf 'qualified stage ready: %s\n' "$STAGE_ROOT"
printf 'integration lock: %s\n' "$LOCK_PATH"
