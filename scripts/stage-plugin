#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_NAME="academic-research-workbench"
STAGE_ROOT="$PROJECT_ROOT/build/stage/$PLUGIN_NAME"
CLEAN=0
CACHEBUSTER=""
VALIDATE_ONLY=0
EVIDENCE_ROOT="$PROJECT_ROOT/build/evidence/phase-01/stage"
INTEGRATION_LOCK=""
CANDIDATE_WHEEL=""
BUILD_EVIDENCE=""
CANDIDATE_EVIDENCE_ROOT=""

usage() {
  cat <<'EOF'
Usage: stage-plugin --candidate-wheel PATH --build-evidence PATH
                    --candidate-evidence-root PATH [--clean] [--stage-root PATH]
                    [--cachebuster TOKEN] [--evidence-root PATH] [--integration-lock PATH]
                    [--validate-only]

Assemble the exact positive-allowlist plugin stage from a gated candidate wheel.
EOF
}

fail() {
  printf 'stage-plugin: %s\n' "$1" >&2
  exit "${2:-1}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --clean)
      CLEAN=1
      shift
      ;;
    --stage-root)
      [[ $# -ge 2 ]] || fail "--stage-root requires a path" 64
      STAGE_ROOT="$2"
      shift 2
      ;;
    --cachebuster)
      [[ $# -ge 2 ]] || fail "--cachebuster requires a token" 64
      CACHEBUSTER="$2"
      shift 2
      ;;
    --evidence-root)
      [[ $# -ge 2 ]] || fail "--evidence-root requires a path" 64
      EVIDENCE_ROOT="$2"
      shift 2
      ;;
    --integration-lock)
      [[ $# -ge 2 ]] || fail "--integration-lock requires a path" 64
      INTEGRATION_LOCK="$2"
      shift 2
      ;;
    --candidate-wheel)
      [[ $# -ge 2 ]] || fail "--candidate-wheel requires a path" 64
      CANDIDATE_WHEEL="$2"; shift 2
      ;;
    --build-evidence)
      [[ $# -ge 2 ]] || fail "--build-evidence requires a path" 64
      BUILD_EVIDENCE="$2"; shift 2
      ;;
    --candidate-evidence-root)
      [[ $# -ge 2 ]] || fail "--candidate-evidence-root requires a path" 64
      CANDIDATE_EVIDENCE_ROOT="$2"; shift 2
      ;;
    --validate-only)
      VALIDATE_ONLY=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1" 64
      ;;
  esac
done

PYTHON="${ARW_BUILD_PYTHON:-$PROJECT_ROOT/.venv/bin/python}"
[[ -x "$PYTHON" ]] || PYTHON="$(command -v python3 || command -v python || true)"
[[ -n "$PYTHON" && -x "$PYTHON" ]] || fail "Python >=3.13 is required" 66
if ! "$PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 13) else 1)'; then
  [[ -z "${ARW_BUILD_PYTHON:-}" ]] || fail "ARW_BUILD_PYTHON must satisfy Python >=3.13" 66
  PYTHON=""
  for candidate in python3 python; do
    resolved="$(command -v "$candidate" 2>/dev/null || true)"
    if [[ -n "$resolved" ]] && "$resolved" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 13) else 1)'; then
      PYTHON="$resolved"
      break
    fi
  done
  [[ -n "$PYTHON" ]] || fail "build interpreter must satisfy Python >=3.13" 66
fi
STAGE_ROOT="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$STAGE_ROOT")"
EVIDENCE_ROOT="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$EVIDENCE_ROOT")"
[[ "$STAGE_ROOT" != "/" && "$STAGE_ROOT" != "$PROJECT_ROOT" ]] \
  || fail "refusing unsafe stage root" 64
[[ "$EVIDENCE_ROOT" != "/" && "$EVIDENCE_ROOT" != "$PROJECT_ROOT" ]] \
  || fail "refusing unsafe evidence root" 64
case "$STAGE_ROOT" in
  "$EVIDENCE_ROOT"|"$EVIDENCE_ROOT"/*) fail "stage and evidence roots must be disjoint" 64 ;;
esac
case "$EVIDENCE_ROOT" in
  "$STAGE_ROOT"|"$STAGE_ROOT"/*) fail "stage and evidence roots must be disjoint" 64 ;;
esac
STAGE_TMP_ROOT="${ARW_STAGE_TMP_ROOT:-$PROJECT_ROOT/build/tmp}"
STAGE_TMP_ROOT="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$STAGE_TMP_ROOT")"
[[ "$STAGE_TMP_ROOT" != "/" && "$STAGE_TMP_ROOT" != "$PROJECT_ROOT" ]] \
  || fail "refusing unsafe stage temporary root" 64
for accepted_root in "$STAGE_ROOT" "$EVIDENCE_ROOT"; do
  case "$STAGE_TMP_ROOT" in
    "$accepted_root"|"$accepted_root"/*) fail "stage temporary root must be disjoint from accepted roots" 64 ;;
  esac
  case "$accepted_root" in
    "$STAGE_TMP_ROOT"|"$STAGE_TMP_ROOT"/*) fail "stage temporary root must be disjoint from accepted roots" 64 ;;
  esac
done

if [[ -n "$INTEGRATION_LOCK" ]]; then
  [[ -f "$INTEGRATION_LOCK" && ! -L "$INTEGRATION_LOCK" ]] \
    || fail "integration lock must be a direct regular file" 66
  INTEGRATION_LOCK="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).absolute())' "$INTEGRATION_LOCK")"
  case "$INTEGRATION_LOCK" in
    "$STAGE_ROOT"|"$STAGE_ROOT"/*)
      fail "integration lock input must be outside the stage root" 64
      ;;
  esac
fi

if [[ "$VALIDATE_ONLY" -eq 1 ]]; then
  [[ "$CLEAN" -eq 0 ]] || fail "--clean and --validate-only are mutually exclusive" 64
  [[ -d "$STAGE_ROOT" && ! -L "$STAGE_ROOT" ]] || fail "stage root is unsafe or missing" 66
  "$PYTHON" - "$PROJECT_ROOT" "$STAGE_ROOT" "$INTEGRATION_LOCK" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path


project_root = Path(sys.argv[1]).resolve()
stage_root = Path(sys.argv[2]).resolve()
provided_lock = Path(sys.argv[3]) if sys.argv[3] else None
sys.path.insert(0, str(project_root / "src"))

from arw.kernel.policy.integration_lock import (  # noqa: E402
    CODEX_CLI_VERSION_REQUIREMENT,
    IntegrationLock,
    _validate_arw_runtime,
    _validate_bundled_ars,
    _validate_file_base,
    _validate_license,
    integration_lock_bytes,
    observe_build_identity_binding,
    is_supported_codex_cli_version,
    observe_hook_definition,
    observe_stage_identity,
    # pi-lens-ignore: jscpd:duplicate
)


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def verify_technical_provenance(
    sbom: dict[str, object], qualification_lock_ref: str | None
) -> None:
    # pi-lens-ignore: jscpd:duplicate
    sbom_path = stage_root / "SBOM.cdx.json"
    try:
        sbom_bytes = sbom_path.read_bytes()
    except OSError as error:
        raise SystemExit(f"staged SBOM is unreadable: {error}") from error
    canonical_sbom_bytes = (
        json.dumps(sbom, indent=2, sort_keys=True) + "\n"
    ).encode("utf-8")
    if sbom_bytes != canonical_sbom_bytes:
        raise SystemExit("staged SBOM bytes are not canonical")
    declaration_relative = "supply-chain/use-distribution.json"
    expected_paths = frozenset(
        {
            "vendor/source-manifest.json",
            "SBOM.cdx.json",
            "THIRD_PARTY_NOTICES.md",
        }
    )
    try:
        declaration = json.loads(
            (stage_root / declaration_relative).read_text(encoding="utf-8")
        )
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise SystemExit(
            f"technical provenance declaration is invalid: {error}"
        ) from error
    rows = declaration.get("evidence_hashes") if isinstance(declaration, dict) else None
    if not isinstance(rows, list) or not rows:
        raise SystemExit("technical provenance declaration has no evidence hashes")
    paths: list[str] = []
    for record in rows:
        if not isinstance(record, dict) or set(record) != {
            "path",
            "purpose",
            "sha256",
        }:
            raise SystemExit("technical provenance record is malformed")
        relative = record.get("path")
        declared = record.get("sha256")
        candidate = Path(relative) if isinstance(relative, str) else Path("/")
        if (
            not isinstance(relative, str)
            or not relative
            or candidate.is_absolute()
            or candidate.as_posix() != relative
            or ".." in candidate.parts
            or relative == declaration_relative
        ):
            raise SystemExit("technical provenance path is unsafe or self-referential")
        if record.get("purpose") != "technical-provenance-only":
            raise SystemExit(f"technical provenance purpose mismatch: {relative}")
        if (
            not isinstance(declared, str)
            or re.fullmatch(r"[0-9a-f]{64}", declared) is None
        ):
            raise SystemExit(f"technical provenance digest is malformed: {relative}")
        target = stage_root / candidate
        if not target.is_file() or target.is_symlink():
            raise SystemExit(f"technical provenance target is missing or unsafe: {relative}")
        observed = digest(target)
        if relative == "SBOM.cdx.json" and qualification_lock_ref is not None:
            base_sbom = dict(sbom)
            components = base_sbom.get("components")
            if not isinstance(components, list):
                raise SystemExit("staged SBOM components are malformed")
            base_sbom["components"] = [
                component
                for component in components
                if isinstance(component, dict)
                and component.get("bom-ref") != qualification_lock_ref
            ]
            base_bytes = (
                json.dumps(base_sbom, indent=2, sort_keys=True) + "\n"
            ).encode("utf-8")
            observed = hashlib.sha256(base_bytes).hexdigest()
        if declared != observed:
            raise SystemExit(f"technical provenance digest mismatch: {relative}")
        paths.append(relative)
    if len(paths) != len(set(paths)):
        raise SystemExit("technical provenance declaration contains duplicate paths")
    observed_paths = set(paths)
    if observed_paths != expected_paths:
        missing = ", ".join(sorted(expected_paths - observed_paths)) or "none"
        unexpected = ", ".join(sorted(observed_paths - expected_paths)) or "none"
        raise SystemExit(
            "technical provenance path set mismatch: "
            f"missing={missing}; unexpected={unexpected}"
        )
    components = sbom.get("components")
    if isinstance(components, list) and any(
        isinstance(component, dict)
        and (
            component.get("bom-ref") == f"artifact:{declaration_relative}"
            or component.get("name") == declaration_relative
        )
        for component in components
    ):
        raise SystemExit("technical provenance contains an SBOM self-reference cycle")


def canonical_lock(path: Path) -> tuple[bytes, IntegrationLock]:
    try:
        flags = os.O_RDONLY | os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        # pi-lens-ignore: jscpd:duplicate
        descriptor = os.open(path, flags)
        try:
            mode = os.fstat(descriptor).st_mode
            if not stat.S_ISREG(mode):
                raise OSError("input is not a regular file")
            with os.fdopen(descriptor, "rb", closefd=False) as handle:
                raw = handle.read(2 * 1024 * 1024 + 1)
        finally:
            os.close(descriptor)
        if len(raw) > 2 * 1024 * 1024:
            raise OSError("input exceeds the 2 MiB stage bound")
        lock = IntegrationLock.model_validate_json(raw, strict=True)
    except (OSError, UnicodeError, ValueError) as error:
        raise SystemExit(f"integration lock is invalid: {error}") from error
    if raw != integration_lock_bytes(lock):
        raise SystemExit("integration lock bytes are not canonical JSON")
    return raw, lock


def verify_local_lock(lock: IntegrationLock) -> None:
    if not is_supported_codex_cli_version(lock.codex_host.cli_version):
        raise SystemExit(
            "integration lock records an unsupported Codex CLI; "
            f"stable codex-cli {CODEX_CLI_VERSION_REQUIREMENT} evidence is required"
        )
    observed_arw = _validate_arw_runtime(stage_root)
    if lock.arw_runtime != observed_arw:
        raise SystemExit("integration lock does not bind the staged ARW runtime")
    source_manifest = json.loads(
        (stage_root / "vendor/source-manifest.json").read_text(encoding="utf-8")
    )
    if lock.ars != _validate_bundled_ars(stage_root, source_manifest):
        raise SystemExit("integration lock does not bind the staged ARS bundle")
    if lock.file_base != _validate_file_base(stage_root, source_manifest):
        raise SystemExit("integration lock does not bind the staged file-base runtime")
    # pi-lens-ignore: jscpd:duplicate
    if lock.license != _validate_license(stage_root):
        raise SystemExit("integration lock does not bind the staged legal blocker state")
    if lock.build_identity != observe_build_identity_binding(
        stage_root, source_manifest
    ):
        raise SystemExit(
            "integration lock does not bind the staged build-identity metadata"
        # pi-lens-ignore: jscpd:duplicate
        )
    hook_config, hook_handler, hook_definition = observe_hook_definition(stage_root)
    if lock.hook.config != hook_config or lock.hook.handler != hook_handler:
        raise SystemExit("integration lock does not bind the staged hook files")
    if lock.hook.definition_sha256 != hook_definition:
        raise SystemExit("integration lock does not bind the staged hook definition")
    if lock.hook.arw_runtime_sha256 != observed_arw.wheel.sha256:
        raise SystemExit("integration lock does not bind the staged hook runtime")
    if lock.hook.stage_sha256 != observe_stage_identity(stage_root):
        raise SystemExit("integration lock does not bind the staged content-tree identity")


inventory_path = stage_root / "supply-chain/stage-inventory.json"
try:
    inventory = json.loads(inventory_path.read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError) as error:
    raise SystemExit(f"stage allowlist inventory is missing or invalid: {error}")

actual: set[str] = set()
for path in stage_root.rglob("*"):
    relative = path.relative_to(stage_root).as_posix()
    if path.is_symlink():
        raise SystemExit(f"symlink rejected from stage: {relative}")
    if path.is_file():
        actual.add(relative)

inventory_files = inventory.get("files", [])
expected = set(inventory_files)
if inventory_files != sorted(actual) or actual != expected:
    missing = sorted(expected - actual)
    extra = sorted(actual - expected)
    raise SystemExit(f"stage allowlist mismatch; missing={missing}; extra={extra}")

private_path = re.compile(
    r"(^|/)(?:\.cache|\.git|\.building[^/]*|barriers?|extractions?|generations?|receipts?|"
    r"extracted-text|papers?|runs?|indexes?|credentials?|private|undeclared)(?:/|$)|"
    r"\.(?:db|sqlite3?|pem|key)$",
    re.IGNORECASE,
)
for relative in actual:
    if private_path.search(relative):
        raise SystemExit(f"private path class rejected from stage: {relative}")

covered_rows = inventory.get("covered_files", [])
covered_paths = [item["path"] for item in covered_rows]
if len(covered_paths) != len(set(covered_paths)):
    raise SystemExit("stage coverage inventory contains duplicate paths")
covered = {item["path"]: item for item in covered_rows}
if set(covered) != actual - {"supply-chain/stage-inventory.json"}:
    raise SystemExit("stage coverage inventory does not cover the exact allowlist")
for relative, record in covered.items():
    actual_digest = digest(stage_root / relative)
    if actual_digest != record["sha256"]:
        raise SystemExit(f"stage coverage digest mismatch: {relative}")

lock_relative = "supply-chain/integration-lock.json"
sbom_relative = "SBOM.cdx.json"
identity_relative = "share/arw/build-identity.json"
has_lock = lock_relative in actual
if provided_lock is not None:
    provided_bytes, _ = canonical_lock(provided_lock)
    if not has_lock or (stage_root / lock_relative).read_bytes() != provided_bytes:
        raise SystemExit("provided integration lock differs from the staged lock")
if has_lock:
    _, staged_lock = canonical_lock(stage_root / lock_relative)
    verify_local_lock(staged_lock)

# Always run the build-identity live recompute so digestPath and evidence
# claims are verified against the live stage bytes regardless of whether the
# stage carries an integration lock.  The staged_payloads list must be bound
# here so the audit manifest gate's existing coverage check uses the same
# closed set the live recompute just exercised.
try:
    source_manifest = json.loads(
        (stage_root / "vendor/source-manifest.json").read_text(encoding="utf-8")
    )
except (OSError, UnicodeError, json.JSONDecodeError) as error:
    raise SystemExit(f"source manifest is unreadable: {error}") from error
identity_for_payloads = json.loads(
    (stage_root / identity_relative).read_text(encoding="utf-8")
)
staged_payload_paths = frozenset(
    item["path"]
    for item in identity_for_payloads.get("staged_payloads", [])
    if isinstance(item, dict) and isinstance(item.get("path"), str)
)
observe_build_identity_binding(
    stage_root, source_manifest, staged_payloads=staged_payload_paths
)
try:
    sbom = json.loads((stage_root / sbom_relative).read_text(encoding="utf-8"))
    # pi-lens-ignore: jscpd:duplicate
    identity = json.loads((stage_root / identity_relative).read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError) as error:
    raise SystemExit(f"stage binding metadata is invalid: {error}") from error
candidate_build = json.loads(
    (stage_root / "share/arw/evidence/candidate-build.json").read_text(encoding="utf-8")
)
license_inventory = json.loads(
    (stage_root / "share/arw/evidence/license-inventory.json").read_text(encoding="utf-8")
)
if license_inventory.get("build_evidence", {}).get("sha256") != digest(
    stage_root / "share/arw/evidence/candidate-build.json"
):
    raise SystemExit("staged license inventory does not bind original candidate build evidence")
if (
    license_inventory.get("build_observation") != candidate_build.get("build")
    or license_inventory.get("runtime_resolution_environment") != candidate_build.get("runtime_resolution_environment")
):
    raise SystemExit("staged license inventory builder or runtime observation differs from candidate")
build_observation = candidate_build.get("build")
runtime_packages = candidate_build.get("resolved_runtime_inventory")
if not isinstance(build_observation, dict) or not isinstance(build_observation.get("inventory"), list) or not isinstance(runtime_packages, list):
    raise SystemExit("staged candidate package inventory is missing")
observed_packages = [*build_observation["inventory"], *runtime_packages]
if not observed_packages or any(not isinstance(row, dict) for row in observed_packages):
    raise SystemExit("staged candidate package inventory is malformed")
packages = sorted({(row["name"].lower(), row["version"]): row for row in observed_packages}.values(),
                  key=lambda row: (row["name"].lower(), row["version"]))
if license_inventory.get("python_packages_observed") != packages:
    raise SystemExit("staged license inventory package set differs from candidate")
candidate_rows = [row for row in candidate_build.get("artifacts", []) if row.get("kind") == "wheel"]
wheel_binding = identity["runtime_artifact"]["first_party_wheel"]
if (
    len(candidate_rows) != 1
    or candidate_rows[0].get("sha256") != wheel_binding["sha256"]
    or Path(candidate_rows[0].get("path", "")).name != Path(wheel_binding["path"]).name
    or identity["runtime"]["build_interpreter"] != candidate_build["build"]["python"]["version"]
):
    raise SystemExit("staged candidate build evidence does not bind builder and wheel")
first_party = license_inventory.get("first_party_wheel")
if not isinstance(first_party, dict) or first_party.get("sha256") != wheel_binding["sha256"] or first_party.get("file") != Path(wheel_binding["path"]).name:
    raise SystemExit("staged license inventory does not bind the installed wheel")
component_rows = sbom.get("components", [])
if not isinstance(component_rows, list) or not all(
    isinstance(item, dict) and isinstance(item.get("bom-ref"), str)
    for item in component_rows
):
    raise SystemExit("staged SBOM components are malformed")
component_refs = [item["bom-ref"] for item in component_rows]
if len(component_refs) != len(set(component_refs)):
    raise SystemExit("staged SBOM contains duplicate component references")
components = {item["bom-ref"]: item for item in component_rows}
observed_python = {ref: item for ref, item in components.items() if ref.startswith("python:")}
expected_python = {
    f"python:{row['name']}@{row['version']}": {
        "name": row["name"], "version": row["version"],
        "hashes": [{"alg": "SHA-256", "content": row["installed_content_sha256"]}],
        "licenses": [{"expression": row["license"]}],
    } for row in packages
}
if set(observed_python) != set(expected_python) or any(
    any(observed_python[ref].get(key) != value for key, value in expected.items())
    for ref, expected in expected_python.items()
):
    raise SystemExit("staged SBOM package inventory differs from candidate")
lock_ref = f"artifact:{lock_relative}"
# pi-lens-ignore: jscpd:duplicate
if has_lock:
    lock_sha256 = digest(stage_root / lock_relative)
    if components.get(lock_ref) != {
        "bom-ref": lock_ref,
        "hashes": [{"alg": "SHA-256", "content": lock_sha256}],
        "name": lock_relative,
        "type": "file",
        "version": "1",
    }:
        raise SystemExit("staged SBOM does not bind the exact integration lock")
elif lock_ref in components:
    raise SystemExit("base staged SBOM unexpectedly claims an integration lock")
verify_technical_provenance(sbom, lock_ref if has_lock else None)

payload_rows = identity.get("staged_payloads", [])
if not isinstance(payload_rows, list) or not all(
    isinstance(item, dict) and isinstance(item.get("path"), str)
    for item in payload_rows
):
    raise SystemExit("build identity staged payloads are malformed")
payload_paths = [item["path"] for item in payload_rows]
if len(payload_paths) != len(set(payload_paths)):
    raise SystemExit("build identity contains duplicate staged payload paths")
payloads = {item["path"]: item for item in payload_rows}
payload_expected = actual - {identity_relative, "supply-chain/stage-inventory.json"}
if set(payloads) != payload_expected:
    raise SystemExit("build identity does not bind the exact staged payload set")
for relative, record in payloads.items():
    if record.get("sha256") != digest(stage_root / relative):
        raise SystemExit(f"build identity payload digest mismatch: {relative}")
PY
  printf 'stage valid: %s\n' "$STAGE_ROOT"
  exit 0
fi

[[ -n "$CANDIDATE_WHEEL" && -n "$BUILD_EVIDENCE" && -n "$CANDIDATE_EVIDENCE_ROOT" ]] \
  || fail "--candidate-wheel, --build-evidence and --candidate-evidence-root are required" 64
[[ -f "$CANDIDATE_WHEEL" && ! -L "$CANDIDATE_WHEEL" ]] \
  || fail "candidate wheel is missing or unsafe" 66
[[ -f "$BUILD_EVIDENCE" && ! -L "$BUILD_EVIDENCE" ]] \
  || fail "build evidence is missing or unsafe" 66
[[ -d "$CANDIDATE_EVIDENCE_ROOT" && ! -L "$CANDIDATE_EVIDENCE_ROOT" ]] \
  || fail "candidate evidence root is missing or unsafe" 66
CANDIDATE_WHEEL="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$CANDIDATE_WHEEL")"
BUILD_EVIDENCE="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$BUILD_EVIDENCE")"
CANDIDATE_EVIDENCE_ROOT="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$CANDIDATE_EVIDENCE_ROOT")"
"$PYTHON" "$PROJECT_ROOT/scripts/candidate-bundle" verify-inputs \
  --wheel "$CANDIDATE_WHEEL" --build-evidence "$BUILD_EVIDENCE" \
  --candidate-evidence-root "$CANDIDATE_EVIDENCE_ROOT" \
  || fail "candidate gate inventory does not bind supplied build evidence" 66
for input in "$CANDIDATE_WHEEL" "$BUILD_EVIDENCE" "$CANDIDATE_EVIDENCE_ROOT"; do
  case "$input" in
    "$STAGE_ROOT"|"$STAGE_ROOT"/*|"$EVIDENCE_ROOT"|"$EVIDENCE_ROOT"/*)
      fail "candidate inputs must be outside stage and stage-evidence roots" 64 ;;
  esac
done

FIRST_PARTY_SHA256="$($PYTHON - "$CANDIDATE_WHEEL" "$BUILD_EVIDENCE" "$CANDIDATE_EVIDENCE_ROOT" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

wheel, evidence_path, gate = map(Path, sys.argv[1:])
def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

try:
    evidence = json.loads(evidence_path.read_text(encoding="utf-8"))
    artifacts = evidence["artifacts"]
    builder_version = evidence["build"]["python"]["version"]
    rows = [row for row in artifacts if row.get("kind") == "wheel"]
    if len(rows) != 1 or not isinstance(builder_version, str) or not re.fullmatch(r"\d+\.\d+\.\d+.*", builder_version):
        raise ValueError("candidate needs one wheel and an observed builder Python")
    row = rows[0]
    relative = Path(row["path"])
    if relative.is_absolute() or ".." in relative.parts or (evidence_path.parent / relative).resolve() != wheel:
        raise ValueError("candidate wheel path does not match build evidence")
    actual = digest(wheel)
    if row["sha256"] != actual or row["size"] != wheel.stat().st_size:
        raise ValueError("candidate wheel size or digest differs from build evidence")
    sbom_path = gate / "SBOM.cdx.json"
    sbom = json.loads(sbom_path.read_text(encoding="utf-8"))
    components = [component for component in sbom["components"] if component.get("bom-ref") == f"first-party-wheel:{wheel.name}"]
    if len(components) != 1 or components[0].get("hashes") != [{"alg": "SHA-256", "content": actual}]:
        raise ValueError("candidate SBOM does not bind the supplied wheel")
    declaration = json.loads((gate / "supply-chain/use-distribution.json").read_text(encoding="utf-8"))
    bindings = declaration["evidence_hashes"]
    sbom_bindings = [item for item in bindings if item.get("path") == "SBOM.cdx.json"]
    if len(sbom_bindings) != 1 or sbom_bindings[0].get("sha256") != digest(sbom_path):
        raise ValueError("candidate use/distribution record does not bind the SBOM")
    verdict = json.loads((gate / "supply-chain/license-verdict.json").read_text(encoding="utf-8"))
    if verdict.get("technical_qualification") != "PASS":
        raise ValueError("candidate legal gate did not pass")
    print(actual)
except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
    raise SystemExit(f"candidate input validation failed: {error}") from error
PY
)" || fail "candidate evidence does not bind supplied wheel" 66
FIRST_PARTY_NAME="$(basename -- "$CANDIDATE_WHEEL")"

