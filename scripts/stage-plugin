copy_as "schemas/v1/build-identity.schema.json" "share/arw/schemas/build-identity.schema.json"
copy_as "schemas/v1/event.schema.json" "share/arw/schemas/event.schema.json"
copy_as "schemas/v1/mcp-read-request.schema.json" "share/arw/schemas/mcp-read-request.schema.json"
copy_as "schemas/v1/mcp-read-result.schema.json" "share/arw/schemas/mcp-read-result.schema.json"
copy_as "schemas/v1/route-result.schema.json" "share/arw/schemas/route-result.schema.json"
copy_as "schemas/v1/run-manifest.schema.json" "share/arw/schemas/run-manifest.schema.json"
copy_as "schemas/v1/source-manifest.schema.json" "share/arw/schemas/source-manifest.schema.json"
copy_as "schemas/v1/version-report.schema.json" "share/arw/schemas/version-report.schema.json"
copy_as "schemas/v1/audit-dossier.schema.json" "share/arw/schemas/audit-dossier.schema.json"
copy_as "schemas/v1/lifecycle-evidence.schema.json" "share/arw/schemas/lifecycle-evidence.schema.json"
copy_file "bin/arw" 0755
copy_file "scripts/file-base-mcp" 0755
copy_file "scripts/file-base-graph-mcp" 0755
copy_as ".file-base/bin/file-base" "libexec/file-base-mcp" 0755
copy_file ".file-base/build-evidence.json"
copy_as "generated/file-contracts.h" "share/arw/file-contracts.h"
copy_file "LICENSES/academic-research-skills-CC-BY-NC-4.0.txt"
copy_file "LICENSES/experiment-agent-CC-BY-NC-4.0.txt"
copy_file "LICENSES/file-base-MIT.txt"
copy_file "THIRD_PARTY_NOTICES.md"
copy_file "MODIFICATIONS.md"
copy_file "SBOM.cdx.json"
copy_file "supply-chain/use-distribution.json"
copy_file "supply-chain/license-verdict.json"
copy_file "vendor/source-manifest.json"
copy_file "vendor/mcp-manifest.json"
copy_file "vendor/patches/file-base/0001-file-base-server-name.patch"
copy_file "vendor/patches/file-base/0002-phase1-confined-read.patch"
copy_file "vendor/patches/file-base/0003-phase3-generation-builder.patch"
copy_file "vendor/patches/file-base/0004-phase5-research-graph.patch"
copy_file "vendor/python/wheelhouse.lock.json"
copy_file "vendor/python/wheelhouse/requirements-runtime.txt"

if [[ -n "$INTEGRATION_LOCK" ]]; then
  "$PYTHON" - "$PROJECT_ROOT" "$INTEGRATION_LOCK" "$TEMP_STAGE" <<'PY'
from __future__ import annotations

import hashlib
import json
import os
import stat
import sys
from pathlib import Path


project_root = Path(sys.argv[1]).resolve()
source = Path(sys.argv[2])
stage_root = Path(sys.argv[3]).resolve()
sys.path.insert(0, str(project_root / "src"))

from arw.canonical import strict_json_loads  # noqa: E402
from arw.integration_lock import (  # noqa: E402
    CODEX_CLI_VERSION_REQUIREMENT,
    IntegrationLock,
    integration_lock_bytes,
    is_supported_codex_cli_version,
)


try:
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    # pi-lens-ignore: jscpd:duplicate
    descriptor = os.open(source, flags)
    try:
        mode = os.fstat(descriptor).st_mode
        if not stat.S_ISREG(mode):
            raise OSError("input is not a regular file")
        with os.fdopen(descriptor, "rb", closefd=False) as handle:
            raw = handle.read(2 * 1024 * 1024 + 1)
    finally:
        os.close(descriptor)
except OSError as error:
    raise SystemExit(f"integration lock is unreadable or unsafe: {error}") from error
if len(raw) > 2 * 1024 * 1024:
    raise SystemExit("integration lock exceeds the 2 MiB stage bound")
try:
    lock = IntegrationLock.model_validate_json(raw, strict=True)
except (UnicodeError, ValueError) as error:
    raise SystemExit(f"integration lock is invalid: {error}") from error
if not is_supported_codex_cli_version(lock.codex_host.cli_version):
    raise SystemExit(
        "integration lock records an unsupported Codex CLI; "
        f"stable codex-cli {CODEX_CLI_VERSION_REQUIREMENT} evidence is required"
    )
if raw != integration_lock_bytes(lock):
    raise SystemExit("integration lock bytes are not canonical JSON")

lock_relative = "supply-chain/integration-lock.json"
lock_sha256 = hashlib.sha256(raw).hexdigest()
lock_destination = stage_root / lock_relative
lock_destination.parent.mkdir(parents=True, exist_ok=True)
lock_destination.write_bytes(raw)
lock_destination.chmod(0o644)

sbom_path = stage_root / "SBOM.cdx.json"
try:
    sbom = strict_json_loads(sbom_path.read_bytes())
except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as error:
    raise SystemExit(f"staged SBOM is not strict JSON: {error}") from error
if not isinstance(sbom, dict) or not isinstance(sbom.get("components"), list):
    raise SystemExit("staged SBOM components are malformed")
lock_ref = f"artifact:{lock_relative}"
component_refs = []
for component in sbom["components"]:
    if not isinstance(component, dict) or not isinstance(
        component.get("bom-ref"), str
    ):
        raise SystemExit("staged SBOM components are malformed")
    component_refs.append(component["bom-ref"])
if len(component_refs) != len(set(component_refs)):
    raise SystemExit("source SBOM contains duplicate component references")
if lock_ref in component_refs:
    raise SystemExit("source SBOM already contains the qualification lock component")
sbom["components"].append(
    {
        "bom-ref": lock_ref,
        "hashes": [{"alg": "SHA-256", "content": lock_sha256}],
        "name": lock_relative,
        "type": "file",
        "version": "1",
    }
)
sbom["components"].sort(key=lambda component: str(component.get("bom-ref", "")))
sbom_path.write_text(
    json.dumps(sbom, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY
fi

