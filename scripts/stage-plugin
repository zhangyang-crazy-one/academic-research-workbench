copy_file() {
  local relative="$1"
  local mode="${2:-0644}"
  local source="$PROJECT_ROOT/$relative"
  [[ -f "$source" && ! -L "$source" ]] || fail "allowlisted source is unsafe or missing: $relative" 66
  install -D -m "$mode" -- "$source" "$TEMP_STAGE/$relative"
}

copy_candidate_file() {
  local relative="$1"
  local source="$CANDIDATE_EVIDENCE_ROOT/$relative"
  [[ -f "$source" && ! -L "$source" ]] \
    || fail "candidate evidence is missing or unsafe: $relative" 66
  install -D -m 0644 -- "$source" "$TEMP_STAGE/$relative"
  [[ "$(sha256sum "$source" | cut -d ' ' -f 1)" == "$(sha256sum "$TEMP_STAGE/$relative" | cut -d ' ' -f 1)" ]] \
    || fail "candidate evidence changed during copy: $relative" 66
}

copy_candidate_as() {
  local source_relative="$1"
  local destination_relative="$2"
  local source="$CANDIDATE_EVIDENCE_ROOT/$source_relative"
  [[ -f "$source" && ! -L "$source" ]] \
    || fail "candidate evidence is missing or unsafe: $source_relative" 66
  install -D -m 0644 -- "$source" "$TEMP_STAGE/$destination_relative"
  [[ "$(sha256sum "$source" | cut -d ' ' -f 1)" == "$(sha256sum "$TEMP_STAGE/$destination_relative" | cut -d ' ' -f 1)" ]] \
    || fail "candidate evidence changed during copy: $source_relative" 66
}

copy_as() {
  local source_relative="$1"
  local destination_relative="$2"
  local mode="${3:-0644}"
  local source="$PROJECT_ROOT/$source_relative"
  [[ -f "$source" && ! -L "$source" ]] \
    || fail "allowlisted source is unsafe or missing: $source_relative" 66
  install -D -m "$mode" -- "$source" "$TEMP_STAGE/$destination_relative"
}

copy_tree() {
  local relative_root="$1"
  local source_root="$PROJECT_ROOT/$relative_root"
  [[ -d "$source_root" && ! -L "$source_root" ]] \
    || fail "allowlisted source tree is unsafe or missing: $relative_root" 66
  while IFS= read -r -d '' source; do
    local relative="${source#"$PROJECT_ROOT/"}"
    local mode=0644
    [[ -x "$source" ]] && mode=0755
    copy_file "$relative" "$mode"
  done < <(
    find "$source_root" -type f \
      ! -path '*/.pytest_cache/*' \
      ! -path '*/__pycache__/*' \
      ! -path '*/ars/evals/heldout/*/runs/*' \
      ! -name '*.pyc' \
      -print0 | sort -z
  )
}

