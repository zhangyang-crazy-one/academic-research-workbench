#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_NAME="academic-research-workbench"
STAGE_ROOT="$PROJECT_ROOT/build/stage/$PLUGIN_NAME"
CLEAN=0
CACHEBUSTER=""
VALIDATE_ONLY=0
EVIDENCE_ROOT="$PROJECT_ROOT/build/evidence/phase-01/stage"

usage() {
  cat <<'EOF'
Usage: stage-plugin [--clean] [--stage-root PATH] [--cachebuster TOKEN]
                    [--evidence-root PATH] [--validate-only]

Build the first-party wheel and assemble the exact positive-allowlist plugin stage.
EOF
}

fail() {
  printf 'stage-plugin: %s\n' "$1" >&2
  exit "${2:-1}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --clean)
      CLEAN=1
      shift
      ;;
    --stage-root)
      [[ $# -ge 2 ]] || fail "--stage-root requires a path" 64
      STAGE_ROOT="$2"
      shift 2
      ;;
    --cachebuster)
      [[ $# -ge 2 ]] || fail "--cachebuster requires a token" 64
      CACHEBUSTER="$2"
      shift 2
      ;;
    --evidence-root)
      [[ $# -ge 2 ]] || fail "--evidence-root requires a path" 64
      EVIDENCE_ROOT="$2"
      shift 2
      ;;
    --validate-only)
      VALIDATE_ONLY=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1" 64
      ;;
  esac
done

PYTHON="$PROJECT_ROOT/.venv/bin/python"
[[ -x "$PYTHON" ]] || fail "project environment missing; run uv sync --frozen first" 66

STAGE_ROOT="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$STAGE_ROOT")"
EVIDENCE_ROOT="$($PYTHON -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$EVIDENCE_ROOT")"
[[ "$STAGE_ROOT" != "/" && "$STAGE_ROOT" != "$PROJECT_ROOT" ]] \
  || fail "refusing unsafe stage root" 64
[[ "$EVIDENCE_ROOT" != "/" && "$EVIDENCE_ROOT" != "$PROJECT_ROOT" ]] \
  || fail "refusing unsafe evidence root" 64

if [[ "$VALIDATE_ONLY" -eq 1 ]]; then
  [[ "$CLEAN" -eq 0 ]] || fail "--clean and --validate-only are mutually exclusive" 64
  [[ -d "$STAGE_ROOT" && ! -L "$STAGE_ROOT" ]] || fail "stage root is unsafe or missing" 66
  "$PYTHON" - "$STAGE_ROOT" <<'PY'
from __future__ import annotations

import hashlib
import json
import re
import sys
from pathlib import Path


stage_root = Path(sys.argv[1]).resolve()
inventory_path = stage_root / "supply-chain/stage-inventory.json"
try:
    inventory = json.loads(inventory_path.read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError) as error:
    raise SystemExit(f"stage allowlist inventory is missing or invalid: {error}")

actual: set[str] = set()
for path in stage_root.rglob("*"):
    relative = path.relative_to(stage_root).as_posix()
    if path.is_symlink():
        raise SystemExit(f"symlink rejected from stage: {relative}")
    if path.is_file():
        actual.add(relative)

expected = set(inventory.get("files", []))
if actual != expected:
    missing = sorted(expected - actual)
    extra = sorted(actual - expected)
    raise SystemExit(f"stage allowlist mismatch; missing={missing}; extra={extra}")

private_path = re.compile(
    r"(^|/)(?:\.cache|\.git|extracted-text|papers?|runs?|indexes?|credentials?|private|undeclared)(?:/|$)|"
    r"\.(?:db|sqlite|pem|key)$",
    re.IGNORECASE,
)
for relative in actual:
    if private_path.search(relative):
        raise SystemExit(f"private path class rejected from stage: {relative}")

covered = {item["path"]: item for item in inventory.get("covered_files", [])}
if set(covered) != actual - {"supply-chain/stage-inventory.json"}:
    raise SystemExit("stage coverage inventory does not cover the exact allowlist")
for relative, record in covered.items():
    actual_digest = hashlib.sha256((stage_root / relative).read_bytes()).hexdigest()
    if actual_digest != record["sha256"]:
        raise SystemExit(f"stage coverage digest mismatch: {relative}")
PY
  printf 'stage valid: %s\n' "$STAGE_ROOT"
  exit 0
fi

if [[ -e "$STAGE_ROOT" ]]; then
  [[ "$CLEAN" -eq 1 ]] || fail "stage root exists; pass --clean" 73
  rm -rf -- "$STAGE_ROOT"
fi

WORK_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/arw-stage.XXXXXX")"
TEMP_STAGE="$STAGE_ROOT.tmp.$$"
cleanup() {
  rm -rf -- "$WORK_ROOT" "$TEMP_STAGE"
}
trap cleanup EXIT INT TERM
mkdir -p "$(dirname -- "$STAGE_ROOT")" "$TEMP_STAGE"

copy_file() {
  local relative="$1"
  local mode="${2:-0644}"
  local source="$PROJECT_ROOT/$relative"
  [[ -f "$source" && ! -L "$source" ]] || fail "allowlisted source is unsafe or missing: $relative" 66
  install -D -m "$mode" -- "$source" "$TEMP_STAGE/$relative"
}

copy_as() {
  local source_relative="$1"
  local destination_relative="$2"
  local mode="${3:-0644}"
  local source="$PROJECT_ROOT/$source_relative"
  [[ -f "$source" && ! -L "$source" ]] \
    || fail "allowlisted source is unsafe or missing: $source_relative" 66
  install -D -m "$mode" -- "$source" "$TEMP_STAGE/$destination_relative"
}

copy_file ".python-version"
copy_file "pyproject.toml"
copy_file "uv.lock"
copy_file ".codex-plugin/plugin.json"
copy_file ".mcp.json"
copy_file "skills/academic-research-workbench/SKILL.md"
copy_file "hooks/hooks.json"
copy_file "schemas/v1/route-result.schema.json"
copy_file "schemas/v1/source-manifest.schema.json"
copy_file "schemas/v1/mcp-read-request.schema.json"
copy_file "schemas/v1/mcp-read-result.schema.json"
copy_file "schemas/v1/build-identity.schema.json"
copy_file "schemas/v1/version-report.schema.json"
copy_as "schemas/v1/build-identity.schema.json" "share/arw/schemas/build-identity.schema.json"
copy_as "schemas/v1/event.schema.json" "share/arw/schemas/event.schema.json"
copy_as "schemas/v1/mcp-read-request.schema.json" "share/arw/schemas/mcp-read-request.schema.json"
copy_as "schemas/v1/mcp-read-result.schema.json" "share/arw/schemas/mcp-read-result.schema.json"
copy_as "schemas/v1/route-result.schema.json" "share/arw/schemas/route-result.schema.json"
copy_as "schemas/v1/run-manifest.schema.json" "share/arw/schemas/run-manifest.schema.json"
copy_as "schemas/v1/source-manifest.schema.json" "share/arw/schemas/source-manifest.schema.json"
copy_as "schemas/v1/version-report.schema.json" "share/arw/schemas/version-report.schema.json"
copy_file "bin/arw" 0755
copy_file "scripts/file-base-mcp" 0755
copy_as ".file-base/bin/file-base" "libexec/file-base-mcp" 0755
copy_file ".file-base/build-evidence.json"
copy_file "LICENSES/academic-research-skills-CC-BY-NC-4.0.txt"
copy_file "LICENSES/experiment-agent-CC-BY-NC-4.0.txt"
copy_file "LICENSES/file-base-MIT.txt"
copy_file "THIRD_PARTY_NOTICES.md"
copy_file "MODIFICATIONS.md"
copy_file "SBOM.cdx.json"
copy_file "supply-chain/use-distribution.json"
copy_file "supply-chain/license-verdict.json"
copy_file "vendor/source-manifest.json"
copy_file "vendor/python/wheelhouse.lock.json"
copy_file "vendor/python/wheelhouse/requirements-runtime.txt"

if [[ -n "$CACHEBUSTER" ]]; then
  "$PYTHON" - "$TEMP_STAGE/.codex-plugin/plugin.json" "$CACHEBUSTER" <<'PY'
from __future__ import annotations

import json
import re
import sys
from pathlib import Path


manifest_path = Path(sys.argv[1])
cachebuster = re.sub(r"[^a-z0-9-]+", "-", sys.argv[2].strip().lower())
cachebuster = re.sub(r"-{2,}", "-", cachebuster).strip("-")
if not cachebuster:
    raise SystemExit("cachebuster must contain at least one letter or digit")
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
base_version = manifest["version"].split("+", 1)[0]
manifest["version"] = f"{base_version}+codex.{cachebuster}"
manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
PY
fi

while IFS= read -r -d '' wheel; do
  relative="${wheel#"$PROJECT_ROOT/"}"
  copy_file "$relative"
done < <(find "$PROJECT_ROOT/vendor/python/wheelhouse" -maxdepth 1 -type f -name '*.whl' -print0 | sort -z)

DIST_ROOT="$WORK_ROOT/dist"
mkdir -p "$DIST_ROOT"
(
  cd "$PROJECT_ROOT"
  "$PYTHON" -m hatchling build --target wheel --directory "$DIST_ROOT"
)

mapfile -t first_party_wheels < <(find "$DIST_ROOT" -maxdepth 1 -type f -name "${PLUGIN_NAME//-/_}-*.whl" -print | sort)
[[ "${#first_party_wheels[@]}" -eq 1 ]] || fail "expected exactly one first-party wheel" 70
FIRST_PARTY_WHEEL="${first_party_wheels[0]}"
FIRST_PARTY_NAME="$(basename -- "$FIRST_PARTY_WHEEL")"
FIRST_PARTY_SHA256="$(sha256sum "$FIRST_PARTY_WHEEL" | awk '{print $1}')"
install -D -m 0644 -- "$FIRST_PARTY_WHEEL" "$TEMP_STAGE/vendor/python/wheelhouse/$FIRST_PARTY_NAME"

INSTALL_REQUIREMENTS_REL="vendor/python/wheelhouse/requirements-installed.txt"
cp -- "$TEMP_STAGE/vendor/python/wheelhouse/requirements-runtime.txt" "$TEMP_STAGE/$INSTALL_REQUIREMENTS_REL"
printf '\n%s==0.1.0 \\\n    --hash=sha256:%s\n' "$PLUGIN_NAME" "$FIRST_PARTY_SHA256" >> "$TEMP_STAGE/$INSTALL_REQUIREMENTS_REL"
INSTALL_REQUIREMENTS_SHA256="$(sha256sum "$TEMP_STAGE/$INSTALL_REQUIREMENTS_REL" | awk '{print $1}')"

"$PYTHON" - \
  "$TEMP_STAGE/vendor/python/wheelhouse.lock.json" \
  "$FIRST_PARTY_NAME" \
  "$FIRST_PARTY_SHA256" \
  "$INSTALL_REQUIREMENTS_REL" \
  "$INSTALL_REQUIREMENTS_SHA256" <<'PY'
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


lock_path = Path(sys.argv[1])
payload = json.loads(lock_path.read_text(encoding="utf-8"))
payload["first_party_wheel"] = {
    "file": sys.argv[2],
    "package": "academic-research-workbench",
    "registry": "first-party",
    "sha256": sys.argv[3],
    "source": "built-from-clean-stage-inputs",
    "version": "0.1.0",
}
payload["install_requirements"] = {
    "path": sys.argv[4],
    "sha256": sys.argv[5],
}
temporary = lock_path.with_suffix(".json.tmp")
temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
os.replace(temporary, lock_path)
PY

"$PYTHON" - "$PROJECT_ROOT" "$TEMP_STAGE" <<'PY'
from __future__ import annotations

import hashlib
import json
import platform
import sys
from pathlib import Path


project_root = Path(sys.argv[1]).resolve()
stage_root = Path(sys.argv[2]).resolve()
sys.path.insert(0, str(project_root / "src"))

from arw.schema_registry import (  # noqa: E402
    aggregate_schema_sha256,
    regenerate_schemas,
    validate_phase1_instance,
)


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def evidence(relative: str) -> dict[str, str]:
    path = project_root / relative
    payload = json.loads(path.read_text(encoding="utf-8"))
    if payload.get("technical_qualification") != "PASS":
        raise SystemExit(f"required technical PASS evidence missing: {relative}")
    return {"path": relative, "sha256": digest(path)}


manifest = json.loads((project_root / "vendor/source-manifest.json").read_text(encoding="utf-8"))
plugin = json.loads((stage_root / ".codex-plugin/plugin.json").read_text(encoding="utf-8"))
lock_path = stage_root / "vendor/python/wheelhouse.lock.json"
lock = json.loads(lock_path.read_text(encoding="utf-8"))
schema_dir = stage_root / "share/arw/schemas"
schema_entries = regenerate_schemas(schema_dir)
schema_entries = tuple(
    (f"share/arw/schemas/{Path(path).name}", digest(schema_dir / Path(path).name))
    for path, _ in schema_entries
)

payloads = [
    {"path": path.relative_to(stage_root).as_posix(), "sha256": digest(path)}
    for path in sorted(stage_root.rglob("*"))
    if path.is_file() and path.relative_to(stage_root).as_posix() != "share/arw/build-identity.json"
]
identity = {
    "schema_version": "1.0.0",
    "platform_claim": "linux",
    "plugin": {"name": plugin["name"], "version": plugin["version"]},
    "runtime": {
        "python_requires": ">=3.13,<3.15",
        "build_interpreter": platform.python_version(),
    },
    "components": [
        {key: component[key] for key in ("id", "version", "revision", "tree_sha256")}
        for component in manifest["components"]
    ],
    "patches": [
        {key: patch[key] for key in ("order", "path", "sha256")}
        for patch in manifest["patches"]
    ],
    "native": {
        "binary": {"path": "libexec/file-base-mcp", "sha256": digest(stage_root / "libexec/file-base-mcp")},
        "upstream_test_tree_sha256": manifest["native_test_suites"][0]["tree_sha256"],
    },
    "wheelhouse": {
        "lock": {"path": "vendor/python/wheelhouse.lock.json", "sha256": digest(lock_path)},
        "requirements": {
            "path": "vendor/python/wheelhouse/requirements-runtime.txt",
            "sha256": digest(stage_root / "vendor/python/wheelhouse/requirements-runtime.txt"),
        },
    },
    "schemas": {
        "aggregate_sha256": aggregate_schema_sha256(schema_entries),
        "files": [{"path": path, "sha256": value} for path, value in schema_entries],
    },
    "evidence": {
        "pre_vendor": evidence("build/evidence/phase-01/pre-vendor-license/receipt.json"),
        "legal": evidence("build/evidence/phase-01/license-0002/verdict.json"),
        "upstream": evidence("build/evidence/phase-01/native/upstream/verdict.json"),
        "asan_ubsan": evidence("build/evidence/phase-01/native/asan-ubsan/verdict.json"),
        "tsan": evidence("build/evidence/phase-01/native/tsan/verdict.json"),
    },
    "staged_payloads": payloads,
}
validate_phase1_instance("build-identity.schema.json", identity)
(stage_root / "share/arw/build-identity.json").write_text(
    json.dumps(identity, indent=2, sort_keys=True) + "\n", encoding="utf-8"
)
PY

"$PYTHON" - "$PROJECT_ROOT" "$TEMP_STAGE" "$FIRST_PARTY_NAME" <<'PY'
from __future__ import annotations

import hashlib
import json
import re
import sys
from pathlib import Path


project_root = Path(sys.argv[1]).resolve()
stage_root = Path(sys.argv[2]).resolve()
first_party_name = sys.argv[3]
source_lock = json.loads(
    (project_root / "vendor/python/wheelhouse.lock.json").read_text(encoding="utf-8")
)
stage_lock = json.loads(
    (stage_root / "vendor/python/wheelhouse.lock.json").read_text(encoding="utf-8")
)


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


if digest(project_root / source_lock["uv_lock"]["path"]) != source_lock["uv_lock"]["sha256"]:
    raise SystemExit("uv.lock does not match the wheelhouse lock")

for wheel in source_lock["wheels"]:
    source = project_root / "vendor/python/wheelhouse" / wheel["file"]
    if source.is_symlink() or digest(source) != wheel["sha256"]:
        raise SystemExit(f"source wheel mismatch: {wheel['file']}")

static_files = {
    ".python-version",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    ".file-base/build-evidence.json",
    "LICENSES/academic-research-skills-CC-BY-NC-4.0.txt",
    "LICENSES/experiment-agent-CC-BY-NC-4.0.txt",
    "LICENSES/file-base-MIT.txt",
    "MODIFICATIONS.md",
    "SBOM.cdx.json",
    "THIRD_PARTY_NOTICES.md",
    "bin/arw",
    "hooks/hooks.json",
    "libexec/file-base-mcp",
    "pyproject.toml",
    "schemas/v1/mcp-read-request.schema.json",
    "schemas/v1/mcp-read-result.schema.json",
    "schemas/v1/build-identity.schema.json",
    "schemas/v1/version-report.schema.json",
    "schemas/v1/route-result.schema.json",
    "schemas/v1/source-manifest.schema.json",
    "scripts/file-base-mcp",
    "share/arw/build-identity.json",
    "share/arw/schemas/artifact-manifest.schema.json",
    "share/arw/schemas/artifact-request.schema.json",
    "share/arw/schemas/build-identity.schema.json",
    "share/arw/schemas/checkpoint-request.schema.json",
    "share/arw/schemas/attempt-request.schema.json",
    "share/arw/schemas/event.schema.json",
    "share/arw/schemas/mcp-read-request.schema.json",
    "share/arw/schemas/mcp-read-result.schema.json",
    "share/arw/schemas/material-passport.schema.json",
    "share/arw/schemas/passport-pointer.schema.json",
    "share/arw/schemas/route-result.schema.json",
    "share/arw/schemas/run-manifest.schema.json",
    "share/arw/schemas/rejection.schema.json",
    "share/arw/schemas/resume-request.schema.json",
    "share/arw/schemas/source-manifest.schema.json",
    "share/arw/schemas/status.schema.json",
    "share/arw/schemas/transition-request.schema.json",
    "share/arw/schemas/version-report.schema.json",
    "skills/academic-research-workbench/SKILL.md",
    "supply-chain/license-verdict.json",
    "supply-chain/use-distribution.json",
    "uv.lock",
    "vendor/python/wheelhouse.lock.json",
    "vendor/python/wheelhouse/requirements-installed.txt",
    "vendor/python/wheelhouse/requirements-runtime.txt",
    "vendor/source-manifest.json",
}
expected = static_files | {
    f"vendor/python/wheelhouse/{wheel['file']}" for wheel in source_lock["wheels"]
} | {f"vendor/python/wheelhouse/{first_party_name}"}

actual: set[str] = set()
for path in stage_root.rglob("*"):
    if path.is_symlink():
        raise SystemExit(f"symlink rejected from stage: {path.relative_to(stage_root)}")
    if path.is_file():
        actual.add(path.relative_to(stage_root).as_posix())

if actual != expected:
    missing = sorted(expected - actual)
    extra = sorted(actual - expected)
    raise SystemExit(f"stage allowlist mismatch; missing={missing}; extra={extra}")

private_path = re.compile(
    r"(^|/)(?:\.env|\.git|papers?|runs?|indexes?|credentials?|private)(?:/|$)|"
    r"\.(?:db|sqlite|pem|key)$",
    re.IGNORECASE,
)
for relative in actual:
    if private_path.search(relative):
        raise SystemExit(f"private path class rejected from stage: {relative}")

first_party = stage_root / "vendor/python/wheelhouse" / stage_lock["first_party_wheel"]["file"]
if digest(first_party) != stage_lock["first_party_wheel"]["sha256"]:
    raise SystemExit("first-party wheel hash mismatch")


def inventory_source(relative: str) -> str:
    if relative == "vendor/source-manifest.json":
        return "source-manifest"
    if relative.startswith("vendor/python/wheelhouse/") or relative in {"uv.lock", ".python-version"}:
        return "wheelhouse"
    if relative.startswith("LICENSES/") or relative.startswith("supply-chain/") or relative in {
        "MODIFICATIONS.md",
        "SBOM.cdx.json",
        "THIRD_PARTY_NOTICES.md",
    }:
        return "legal"
    if (
        relative.startswith("schemas/")
        or relative.startswith(".file-base/")
        or relative.startswith("libexec/")
        or relative.startswith("share/arw/")
    ):
        return "build"
    return "runtime"


inventory_path = stage_root / "supply-chain/stage-inventory.json"
inventory_relative = inventory_path.relative_to(stage_root).as_posix()
covered_files = [
    {
        "inventory_source": inventory_source(relative),
        "path": relative,
        "sha256": digest(stage_root / relative),
    }
    for relative in sorted(actual)
]
inventory = {
    "schema_version": "1.0.0",
    "files": sorted(actual | {inventory_relative}),
    "symlinks": [],
    "covered_files": covered_files,
}
inventory_path.parent.mkdir(parents=True, exist_ok=True)
inventory_path.write_text(json.dumps(inventory, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY

mv "$TEMP_STAGE" "$STAGE_ROOT"
trap - EXIT INT TERM
rm -rf -- "$WORK_ROOT"

if [[ -e "$EVIDENCE_ROOT" ]]; then
  [[ -d "$EVIDENCE_ROOT" && ! -L "$EVIDENCE_ROOT" ]] \
    || fail "unsafe evidence root" 64
  rm -rf -- "$EVIDENCE_ROOT"
fi
mkdir -p "$EVIDENCE_ROOT"
"$PYTHON" - "$PROJECT_ROOT" "$STAGE_ROOT" "$EVIDENCE_ROOT" <<'PY'
from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path


project_root = Path(sys.argv[1]).resolve()
stage_root = Path(sys.argv[2]).resolve()
evidence_root = Path(sys.argv[3]).resolve()
inventory = json.loads(
    (stage_root / "supply-chain/stage-inventory.json").read_text(encoding="utf-8")
)
actual = {
    path.relative_to(stage_root).as_posix()
    for path in stage_root.rglob("*")
    if path.is_file()
}
expected = set(inventory["files"])
canary_payload = json.loads(
    (project_root / "tests/fixtures/private-canaries/canaries.json").read_text(encoding="utf-8")
)
stage_files = [path for path in stage_root.rglob("*") if path.is_file()]
canary_results = []
for canary in canary_payload["canaries"]:
    token = canary["token"].encode()
    present = any(token in path.read_bytes() for path in stage_files)
    canary_results.append(
        {
            "class": canary["class"],
            "fixture_path": canary["path"],
            "present": present,
            "token_sha256": hashlib.sha256(token).hexdigest(),
        }
    )
if any(item["present"] for item in canary_results):
    raise SystemExit("private canary detected in stage")

verdict = json.loads(
    (stage_root / "supply-chain/license-verdict.json").read_text(encoding="utf-8")
)
if verdict["technical_qualification"] != "PASS":
    raise SystemExit("stage legal technical qualification is not PASS")

(evidence_root / "inventory.json").write_text(
    json.dumps(inventory, indent=2, sort_keys=True) + "\n", encoding="utf-8"
)
(evidence_root / "inventory-diff.json").write_text(
    json.dumps(
        {"missing": sorted(expected - actual), "unexpected": sorted(actual - expected)},
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
(evidence_root / "canary-scan.json").write_text(
    json.dumps(
        {"technical_qualification": "PASS", "canaries": canary_results},
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
(evidence_root / "verdict.json").write_text(
    json.dumps(
        {
            "technical_qualification": verdict["technical_qualification"],
            "release_qualification": verdict["release_qualification"],
        },
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
PY
printf 'stage ready: %s\n' "$STAGE_ROOT"
