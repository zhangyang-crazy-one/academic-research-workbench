for path in ars_source.rglob("*"):
    if path.is_symlink():
        raise SystemExit(f"bundled ARS source contains a symlink: {path.relative_to(project_root)}")
    if path.is_file() and ".pytest_cache" not in path.parts and "__pycache__" not in path.parts and path.suffix not in {".pyc", ".pyo"}:
        relative = path.relative_to(project_root).as_posix()
        staged_relative = f"/{relative}"
        if "/ars/evals/heldout/" in staged_relative and "/runs/" in staged_relative:
            continue
        static_files.add(relative)
lock_relative = "supply-chain/integration-lock.json"
if (stage_root / lock_relative).is_file():
    static_files.add(lock_relative)
expected = static_files | {
    f"vendor/python/wheelhouse/{wheel['file']}" for wheel in source_lock["wheels"]
} | {f"vendor/python/wheelhouse/{first_party_name}"}

actual: set[str] = set()
for path in stage_root.rglob("*"):
    if path.is_symlink():
        raise SystemExit(f"symlink rejected from stage: {path.relative_to(stage_root)}")
    if path.is_file():
        actual.add(path.relative_to(stage_root).as_posix())

if actual != expected:
    missing = sorted(expected - actual)
    extra = sorted(actual - expected)
    raise SystemExit(f"stage allowlist mismatch; missing={missing}; extra={extra}")

private_path = re.compile(
    r"(^|/)(?:\.env|\.git|\.building[^/]*|barriers?|extractions?|generations?|receipts?|"
    r"papers?|runs?|indexes?|credentials?|private)(?:/|$)|"
    r"\.(?:db|sqlite3?|pem|key)$",
    re.IGNORECASE,
)
for relative in actual:
    if private_path.search(relative):
        raise SystemExit(f"private path class rejected from stage: {relative}")

first_party = stage_root / "vendor/python/wheelhouse" / stage_lock["first_party_wheel"]["file"]
if digest(first_party) != stage_lock["first_party_wheel"]["sha256"]:
    raise SystemExit("first-party wheel hash mismatch")

try:
    sbom = json.loads((stage_root / "SBOM.cdx.json").read_text(encoding="utf-8"))
    identity = json.loads(
        # pi-lens-ignore: jscpd:duplicate
        (stage_root / "share/arw/build-identity.json").read_text(encoding="utf-8")
    )
except (OSError, UnicodeError, json.JSONDecodeError) as error:
    raise SystemExit(f"stage binding metadata is invalid: {error}") from error
component_rows = sbom.get("components", [])
if not isinstance(component_rows, list) or not all(
    isinstance(item, dict) and isinstance(item.get("bom-ref"), str)
    for item in component_rows
):
    raise SystemExit("staged SBOM components are malformed")
component_refs = [item["bom-ref"] for item in component_rows]
if len(component_refs) != len(set(component_refs)):
    raise SystemExit("staged SBOM contains duplicate component references")
components = {item["bom-ref"]: item for item in component_rows}
lock_ref = f"artifact:{lock_relative}"
has_lock = lock_relative in actual
# pi-lens-ignore: jscpd:duplicate
if has_lock:
    lock_sha256 = digest(stage_root / lock_relative)
    if components.get(lock_ref) != {
        "bom-ref": lock_ref,
        "hashes": [{"alg": "SHA-256", "content": lock_sha256}],
        "name": lock_relative,
        "type": "file",
        "version": "1",
    }:
        raise SystemExit("staged SBOM does not bind the exact integration lock")
elif lock_ref in components:
    raise SystemExit("base staged SBOM unexpectedly claims an integration lock")
verify_technical_provenance(sbom, lock_ref if has_lock else None)
payload_rows = identity.get("staged_payloads", [])
if not isinstance(payload_rows, list) or not all(
    isinstance(item, dict) and isinstance(item.get("path"), str)
    for item in payload_rows
):
    raise SystemExit("build identity staged payloads are malformed")
payload_paths = [item["path"] for item in payload_rows]
if len(payload_paths) != len(set(payload_paths)):
    raise SystemExit("build identity contains duplicate staged payload paths")
payloads = {item["path"]: item for item in payload_rows}
payload_expected = actual - {"share/arw/build-identity.json"}
if set(payloads) != payload_expected:
    raise SystemExit("build identity does not bind the exact pre-inventory payload set")
for relative, record in payloads.items():
    if record.get("sha256") != digest(stage_root / relative):
        raise SystemExit(f"build identity payload digest mismatch: {relative}")


def inventory_source(relative: str) -> str:
    if relative in {"vendor/source-manifest.json", "vendor/mcp-manifest.json"}:
        return "source-manifest"
    if relative.startswith("vendor/python/wheelhouse/") or relative in {"uv.lock", ".python-version"}:
        return "wheelhouse"
    if relative.startswith("LICENSES/") or relative.startswith("supply-chain/") or relative in {
        "MODIFICATIONS.md",
        "SBOM.cdx.json",
        "THIRD_PARTY_NOTICES.md",
    }:
        return "legal"
    if (
        relative.startswith("schemas/")
        or relative.startswith(".file-base/")
        or relative.startswith("libexec/")
        or relative.startswith("share/arw/")
    ):
        return "build"
    return "runtime"


inventory_path = stage_root / "supply-chain/stage-inventory.json"
inventory_relative = inventory_path.relative_to(stage_root).as_posix()
covered_files = [
    {
        "inventory_source": inventory_source(relative),
        "path": relative,
        "sha256": digest(stage_root / relative),
    }
    for relative in sorted(actual)
]
inventory = {
    "schema_version": "1.0.0",
    "files": sorted(actual | {inventory_relative}),
    "symlinks": [],
    "covered_files": covered_files,
}
inventory_path.parent.mkdir(parents=True, exist_ok=True)
inventory_path.write_text(json.dumps(inventory, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY

mv "$TEMP_STAGE" "$STAGE_ROOT"
trap - EXIT INT TERM
rm -rf -- "$WORK_ROOT"

if [[ -e "$EVIDENCE_ROOT" ]]; then
  [[ -d "$EVIDENCE_ROOT" && ! -L "$EVIDENCE_ROOT" ]] \
    || fail "unsafe evidence root" 64
  [[ -f "$EVIDENCE_ROOT/.arw-stage-evidence" \
      || ( -f "$EVIDENCE_ROOT/inventory.json" \
           && -f "$EVIDENCE_ROOT/verdict.json" ) ]] \
    || fail "refusing to clean evidence root without an ownership marker" 64
  rm -rf -- "$EVIDENCE_ROOT"
fi
mkdir -p "$EVIDENCE_ROOT"
printf 'academic-research-workbench stage evidence v1\n' \
  > "$EVIDENCE_ROOT/.arw-stage-evidence"
"$PYTHON" - "$PROJECT_ROOT" "$STAGE_ROOT" "$EVIDENCE_ROOT" <<'PY'
from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path


project_root = Path(sys.argv[1]).resolve()
stage_root = Path(sys.argv[2]).resolve()
evidence_root = Path(sys.argv[3]).resolve()
inventory = json.loads(
    (stage_root / "supply-chain/stage-inventory.json").read_text(encoding="utf-8")
)
actual = {
    path.relative_to(stage_root).as_posix()
    for path in stage_root.rglob("*")
    if path.is_file()
}
expected = set(inventory["files"])
canary_payload = json.loads(
    (project_root / "tests/fixtures/private-canaries/canaries.json").read_text(encoding="utf-8")
)
stage_files = [path for path in stage_root.rglob("*") if path.is_file()]
canary_results = []
for canary in canary_payload["canaries"]:
    token = canary["token"].encode()
    present = any(token in path.read_bytes() for path in stage_files)
    canary_results.append(
        {
            "class": canary["class"],
            "fixture_path": canary["path"],
            "present": present,
            "token_sha256": hashlib.sha256(token).hexdigest(),
        }
    )
if any(item["present"] for item in canary_results):
    raise SystemExit("private canary detected in stage")

verdict = json.loads(
    (stage_root / "supply-chain/license-verdict.json").read_text(encoding="utf-8")
)
if verdict["technical_qualification"] != "PASS":
    raise SystemExit("stage legal technical qualification is not PASS")

(evidence_root / "inventory.json").write_text(
    json.dumps(inventory, indent=2, sort_keys=True) + "\n", encoding="utf-8"
)
(evidence_root / "inventory-diff.json").write_text(
    json.dumps(
        {"missing": sorted(expected - actual), "unexpected": sorted(actual - expected)},
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
(evidence_root / "canary-scan.json").write_text(
    json.dumps(
        {"technical_qualification": "PASS", "canaries": canary_results},
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
(evidence_root / "verdict.json").write_text(
    json.dumps(
        {
            "technical_qualification": verdict["technical_qualification"],
            "release_qualification": verdict["release_qualification"],
        },
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
PY
printf 'stage ready: %s\n' "$STAGE_ROOT"
