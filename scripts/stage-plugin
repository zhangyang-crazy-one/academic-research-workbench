from __future__ import annotations

import hashlib
import json
import re
# pi-lens-ignore: jscpd:duplicate
import sys
from pathlib import Path


project_root = Path(sys.argv[1]).resolve()
stage_root = Path(sys.argv[2]).resolve()
first_party_name = sys.argv[3]
first_party_sha256 = sys.argv[4]
sys.path.insert(0, str(project_root / "src"))

from arw.kernel.core.canonical import strict_json_loads  # noqa: E402
from arw.kernel.policy.schema_registry import (  # noqa: E402
    aggregate_schema_sha256,
    regenerate_schemas,
    validate_phase1_instance,
)
from arw.kernel.policy.integration_lock import (  # noqa: E402
    _verify_native_surface_bundle,
    IntegrationLockError,
    EXPECTED_PRE_VENDOR_RECEIPT_SHA256,
    NATIVE_EVIDENCE_KINDS,
    NATIVE_SURFACES,
    NATIVE_VERDICT_KIND,
    native_evidence_path,
    parse_file_contract_contract_sha256_from_bytes,
    verify_evidence_contract,
)
from arw.file_contracts import (  # noqa: E402
    FileContractError,
    render_native_contract_header,
)


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def staged_evidence(staged_relative: str, *, label: str) -> dict[str, str]:
    """Bind an evidence surface to its staged copy inside ``share/arw/evidence``.

    The producer MUST have copied the original phase-01 surface into the
    plugin stage at ``staged_relative`` so the installed verifier never
    has to read the original ``build/evidence/phase-01`` tree.  This
    delegates to the shared ``verify_evidence_contract`` helper from
    ``arw.integration_lock`` so the producer and the installed verifier
    cannot drift: both run the strict Pydantic contract, both perform
    the legal live-digest check and the pre-vendor manifest
    cross-binding, and both require the derived qualification to equal
    the declared ``technical_qualification``.  No self-asserted PASS is
    accepted: the producer must run the gate and derive the semantic
    result.
    """

    staged_path = stage_root / staged_relative
    if staged_path.is_symlink() or not staged_path.is_file():
        raise SystemExit(
            f"required staged evidence surface is missing: {staged_relative}"
        )
    if "." in label:
        return {"path": staged_relative, "sha256": digest(staged_path)}
    try:
        payload = strict_json_loads(staged_path.read_bytes())
    except (OSError, UnicodeError, ValueError) as error:
        raise SystemExit(
            f"staged evidence surface is not strict unambiguous JSON: "
            f"{staged_relative}: {error}"
        )
    basename = staged_path.name
    surface = {
        "pre_vendor.json": "pre_vendor",
        "legal.json": "legal",
        "upstream.json": "upstream",
        "asan_ubsan.json": "asan_ubsan",
        "tsan.json": "tsan",
    }.get(basename)
    if surface is None:
        raise SystemExit(
            f"no producer contract for staged evidence surface: {staged_relative}"
        )
    try:
        verify_evidence_contract(stage_root, payload, surface=surface)
    except IntegrationLockError as error:
        raise SystemExit(
            f"staged evidence surface {label} ({basename}) fails the "
            f"shared verifier contract: {error}"
        )
    staged_digest = digest(staged_path)
    if (
        surface == "pre_vendor"
        and staged_digest != EXPECTED_PRE_VENDOR_RECEIPT_SHA256
    ):
        raise SystemExit(
            "staged pre-vendor receipt raw bytes drift from canonical reviewed "
            f"evidence: observed={staged_digest} "
            f"expected={EXPECTED_PRE_VENDOR_RECEIPT_SHA256}"
        )
    return {"path": staged_relative, "sha256": staged_digest}


manifest = json.loads((project_root / "vendor/source-manifest.json").read_text(encoding="utf-8"))
plugin = json.loads((stage_root / ".codex-plugin/plugin.json").read_text(encoding="utf-8"))
contract_header_path = stage_root / "share/arw/file-contracts.h"
schema_dir = stage_root / "share/arw/schemas"
schema_entries = regenerate_schemas(schema_dir)
schema_entries = tuple(
    (f"share/arw/schemas/{Path(path).name}", digest(schema_dir / Path(path).name))
    for path, _ in schema_entries
)


# Regenerate the file-contract header FROM the staged checked schemas
# (NOT from the source ``generated/`` directory) so the embedded
# ``ARW_FILES_CONTRACT_SHA256`` reflects the *staged* schema digests.  The
# staged bytes are overwritten with the regeneration so the verifier's
# regenerated-bytes equality check is satisfied.  This MUST happen before
# ``payloads`` is captured so the regenerated header is in staged_payloads.
try:
    regenerated_header = render_native_contract_header(schema_dir)
except FileContractError as error:
    raise SystemExit(
        f"stage-plugin cannot regenerate file-contract header from staged "
        f"schemas: {error}"
    )
contract_header_path.write_bytes(regenerated_header)
embedded_contract_sha = parse_file_contract_contract_sha256_from_bytes(
    regenerated_header
)
payloads = [
    {"path": path.relative_to(stage_root).as_posix(), "sha256": digest(path)}
    for path in sorted(stage_root.rglob("*"))
    if path.is_file() and path.relative_to(stage_root).as_posix() != "share/arw/build-identity.json"
]

# The candidate build evidence, not the staging interpreter, identifies the builder.
build_evidence = strict_json_loads(
    (stage_root / "share/arw/evidence/candidate-build.json").read_bytes()
)
build_interpreter = build_evidence["build"]["python"]["version"]

# The producer regenerates the file-contract header FROM the staged
# checked schemas (NOT from the source ``generated/`` directory) so the
# The file-contract header is regenerated from the staged checked schemas
# above (before ``payloads`` is captured) so the regenerated header is
# already on disk and recorded in staged_payloads here.

identity = {
    "schema_version": "1.0.0",
    "platform_claim": "linux",
    "plugin": {"name": plugin["name"], "version": plugin["version"]},
    "runtime": {
        "python_requires": ">=3.13",
        "build_interpreter": build_interpreter,
    },
    "components": [
        {key: component[key] for key in ("id", "version", "revision", "tree_sha256")}
        for component in manifest["components"]
    ],
    "patches": [
        {key: patch[key] for key in ("order", "path", "sha256")}
        for patch in manifest["patches"]
    ],
    "native": {
        "binary": {"path": "libexec/file-base-mcp", "sha256": digest(stage_root / "libexec/file-base-mcp")},
        "build_evidence": {
            "path": ".file-base/build-evidence.json",
            "sha256": digest(stage_root / ".file-base/build-evidence.json"),
        },
        "compile_profile": "release-o2",
        "patched_source_tree_sha256": sorted(
            manifest["patches"], key=lambda item: item["order"]
        )[-1]["post_tree_sha256"],
        "upstream_test_tree_sha256": manifest["native_test_suites"][0]["tree_sha256"],
    },
    "projection": {
        "algorithm": "research-graph-projection-v1",
        "oracle": "research-graph-normalization-v1",
        "native_profile": "research-graph-builder-v1",
        "patch_set_sha256": hashlib.sha256(
            json.dumps(
                [{key: patch[key] for key in ("order", "path", "sha256")} for patch in manifest["patches"]],
                sort_keys=True,
                separators=(",", ":"),
            ).encode("utf-8")
        ).hexdigest(),
        "profile_patch_sha256": next(
            patch["sha256"] for patch in manifest["patches"] if patch["order"] == 4
        ),
        "query_profile": "arw-graph-mcp-v1",
        "query_launcher": {
            "path": "scripts/file-base-graph-mcp",
            "sha256": digest(stage_root / "scripts/file-base-graph-mcp"),
        },
    },
    "file_contract": {
        "header": {
            "path": "share/arw/file-contracts.h",
            "sha256": digest(contract_header_path),
        },
        "contract_sha256": embedded_contract_sha,
        "tokenizer_id": "unicode61-cjk-v1",
        "ranking_version": "files-rank-v1",
        "outline_versions": [
            "bibtex-outline-v1",
            "latex-outline-v1",
            "markdown-outline-v1",
            "source-outline-v1",
        ],
    },
    "runtime_artifact": {
        "first_party_wheel": {
            "path": f"share/arw/wheels/{first_party_name}",
            "sha256": first_party_sha256,
        },
    },
    "schemas": {
        "aggregate_sha256": aggregate_schema_sha256(schema_entries),
        "files": [{"path": path, "sha256": value} for path, value in schema_entries],
    },
    "evidence": {
        "pre_vendor": staged_evidence(
            "share/arw/evidence/pre_vendor.json", label="pre_vendor"
        ),
        "legal": staged_evidence(
            "share/arw/evidence/legal.json", label="legal"
        ),
    },
}

# The native surfaces are bundles of 5 digestPaths (verdict + command +
# sanitizer_verdict + test_suite_sha256 + status) so the verifier can
# distinguish them by argv, suite, and pinned bytes.  Emit each bundle
# into the existing ``evidence`` dict under the surface key.
for native_surface in NATIVE_SURFACES:
    bundle: dict[str, dict[str, str]] = {}
    bundle[NATIVE_VERDICT_KIND] = staged_evidence(
        native_evidence_path(native_surface, NATIVE_VERDICT_KIND),
        label=native_surface,
    )
    for kind in NATIVE_EVIDENCE_KINDS:
        bundle[kind] = staged_evidence(
            native_evidence_path(native_surface, kind),
            label=f"{native_surface}.{kind}",
        )
    try:
        _verify_native_surface_bundle(
            stage_root, surface=native_surface, label=f"evidence.{native_surface}"
        )
    except IntegrationLockError as error:
        raise SystemExit(
            f"native evidence bundle {native_surface} fails the shared "
            f"verifier contract: {error}"
        ) from error
    identity["evidence"][native_surface] = bundle


identity["staged_payloads"] = payloads
validate_phase1_instance("build-identity.schema.json", identity)
(stage_root / "share/arw/build-identity.json").write_text(
    json.dumps(identity, indent=2, sort_keys=True) + "\n", encoding="utf-8"
)
