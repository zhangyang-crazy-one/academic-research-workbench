copy_file "schemas/v1/review-finding-matrix.schema.json"
copy_file "schemas/v1/panel-manifest.schema.json"
copy_file "schemas/v1/role-catalog.schema.json"
copy_file "schemas/v1/worker-proposal.schema.json"
copy_file "schemas/v1/host-identity-receipt.schema.json"
