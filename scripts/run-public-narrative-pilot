#!/usr/bin/env python3
"""Replay pinned public dispositions through ARW; never infer scientific motives."""

from __future__ import annotations

import argparse
import csv
import json
import os
import re
import subprocess
import sys
from collections import Counter
from datetime import UTC, datetime
from pathlib import Path
from uuid import uuid4

REPO = Path(__file__).resolve().parent.parent
KIT = REPO / "examples/pilots/narrative-public-decisions"
SOURCE_PATHS = [str(REPO / "src"), *map(str, (REPO / "extensions").glob("*/src"))]
sys.path[:0] = SOURCE_PATHS

from arw_research_memory.service import ResearchMemoryService

from arw.kernel.core.canonical import canonical_json_bytes, sha256_hex
from arw.kernel.ledger.journal import replay_run
from arw.kernel.ledger.narrative import trail
from arw.kernel.ledger.source_locations import read_retained_bytes
from arw.kernel.ledger.workflows import CORE_WORKFLOW
from arw.kernel.state.research_memory import MemoryQuery


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(canonical_json_bytes(value))


def read(path):
    return json.loads(path.read_bytes())


def utc():
    return datetime.now(UTC).isoformat(timespec="seconds").replace("+00:00", "Z")


def environment():
    result = os.environ.copy()
    for name in ("ARW_PLUGIN_ROOT", "ARW_PLUGIN_MANIFEST"):
        result.pop(name, None)
    result.update(
        ARW_RUNTIME="local-dev",
        ARW_PYTHON=sys.executable,
        ARW_PLUGIN_MANIFEST=str(REPO / ".codex-plugin/plugin.json"),
        PYTHONPATH=os.pathsep.join(SOURCE_PATHS),
        PYTHONDONTWRITEBYTECODE="1",
    )
    return result


def invoke(project, label, *args):
    result = subprocess.run(
        [str(REPO / "bin/arw"), *map(str, args)],
        cwd=project,
        env=environment(),
        capture_output=True,
        timeout=90,
        check=False,
    )
    logs = project / "commands"
    logs.mkdir(exist_ok=True)
    (logs / f"{label}.stdout").write_bytes(result.stdout)
    (logs / f"{label}.stderr").write_bytes(result.stderr)
    write(
        logs / f"{label}.json",
        {
            "argv": list(map(str, args)),
            "exit_code": result.returncode,
            "recorded_at": utc(),
        },
    )
    value = json.loads(result.stdout)
    registration_pending = (
        args[:2] == ("narrative", "register")
        and result.returncode == 65
        and value.get("status") == "missing_selection"
    )
    if result.returncode and not registration_pending:
        raise RuntimeError(
            f"{project.name}/{label} failed ({result.returncode}); see retained logs"
        )
    return value


def frozen_protocol(protocol):
    return {
        key: protocol[key]
        for key in ("source_status_encoding", "source_reason_encoding", "comparison")
    }


def plan(material, role):
    return {
        "schema_version": "arw.narrative-plan.v1",
        "route": "custom",
        "rationale": f"Public disposition replay: {material['sample_id']}; role={role}; historical_reason=unknown; source_sha256={material['source_sha256']}",
        "problem_to_contribution": "Audit a pinned public numerical-research proposal's disposition.",
        "contribution_to_evidence": "Compare the retained public status with actual narrative lifecycle output.",
        "evidence_to_conclusion": "Conclude only what this source-bound operational replay demonstrates.",
        "scope_boundary": "Pilot scaffold only: not a NumPy author's ARW approval, original paper plan, or scientific finding.",
        "function_order": [
            "problem",
            "gap",
            "contribution",
            "argument",
            "evidence",
            "knowledge_boundary",
        ],
        "evidence_forms": ["annotation_validation"],
    }


def request(run, **extra):
    state = replay_run(run)
    return {
        "schema_version": "1.0.0",
        "run_id": state.run_id,
        "event_id": f"evt-{uuid4()}",
        "command_id": f"cmd-{uuid4()}",
        "expected_revision": state.revision,
        "occurred_at": utc(),
        "actor_id": "pilot.operator",
        "actor_role": "parent_control_plane",
        **extra,
    }


def handoff_rounds(project, material, current):
    run = project / "run"
    write(run / "input/source-identity.json", material)
    write(
        project / "init-request.json",
        {
            "schema_version": "1.0.0",
            "run_id": f"run-{uuid4()}",
            "occurred_at": utc(),
            "immutable_input": {
                "path": "input/source-identity.json",
                "sha256": sha256_hex((run / "input/source-identity.json").read_bytes()),
            },
            "workflow_family": "academic-pipeline",
            "workflow_mode": "inline-role-prompts",
            "workflow_definition_id": CORE_WORKFLOW.definition_id,
            "workflow_definition_sha256": CORE_WORKFLOW.sha256,
            "journal_layout": "segmented-v1",
            "capabilities": ["canonical-journal"],
            "event_id": f"evt-{uuid4()}",
            "command_id": f"cmd-{uuid4()}",
            "actor_id": "pilot.operator",
        },
    )
    invoke(
        project,
        "run-init",
        "init",
        "--run-root",
        "run",
        "--request",
        "init-request.json",
        "--task-kind",
        "paper",
        "--project-root",
        ".",
    )
    write(
        run / "target.json",
        {
            "objective": "Inspect retained public narrative comparison without silently reviving abandoned proposals",
            "sample_id": material["sample_id"],
            "source_sha256": material["source_sha256"],
        },
    )
    write(
        project / "target-request.json",
        request(
            run,
            artifact_id="artifact.pilot-target",
            artifact_kind="author-target",
            media_type="application/json",
            content_path="target.json",
            content_sha256=sha256_hex((run / "target.json").read_bytes()),
            base_revision=replay_run(run).revision,
            consumed_sha256=[replay_run(run).last_event_sha256],
        ),
    )
    invoke(
        project,
        "target-accept",
        "artifact-accept",
        "--run-root",
        "run",
        "--request",
        "target-request.json",
    )
    target = replay_run(run).events[-1]
    for round_number in (1, 2):
        label = f"round-{round_number}"
        value = {
            "memory_id": f"memory.pilot-round-{round_number}",
            "kind": "handoff",
            "title": "Public narrative pilot continuation",
            "body": "Inspect the comparison; imported abandoned proposals remain historical notices, not next actions.",
            "source_artifact_ids": ["artifact.pilot-target"],
            "source_ledger_event_ids": [target.event_id],
            "links": [
                {
                    "kind": "author_target",
                    "target_id": "artifact.pilot-target",
                    "event_id": target.event_id,
                    "sha256": target.payload.artifact_sha256,
                }
            ],
            "supersedes": ["memory.pilot-round-1"] if round_number == 2 else [],
            "handoff": {
                "objective": "Inspect the source-bound narrative comparison",
                "current_state": "The public abandoned disposition is recorded; scaffold baseline remains current",
                "completed_work": [
                    "Imported public status and exported narrative trail"
                ],
                "evidence_gathered": [material["source_url"]],
                "commands_evaluations_run": ["arw narrative trail --json"],
                "relevant_artifacts_issues_files": ["#120", "artifact.pilot-target"],
                "open_questions": ["Historical causal reason remains unknown"],
                "blockers": [],
                "risks": [
                    "Single-project assisted annotations; operational replay only"
                ],
                "next_concrete_action": "Inspect the retained comparison and unresolved questions",
                "source_run_harness": {
                    "run_id": replay_run(run).run_id,
                    "harness": "codex",
                },
                "intended_target_harness": "codex",
                "narrative_sha256": current,
            },
        }
        write(project / f"{label}-handoff.json", value)
        write(project / f"{label}-save-request.json", request(run))
        invoke(
            project,
            f"{label}-save",
            "memory",
            "handoff",
            "--project-root",
            ".",
            "--run-root",
            "run",
            "--input",
            f"{label}-handoff.json",
            "--request",
            f"{label}-save-request.json",
        )
        write(
            project / f"{label}-checkpoint-request.json",
            request(run, checkpoint_kind="explicit", fresh_until=None),
        )
        checkpoint = invoke(
            project,
            f"{label}-checkpoint",
            "checkpoint",
            "--run-root",
            "run",
            "--request",
            f"{label}-checkpoint-request.json",
        )
        write(
            project / f"{label}-resume-request.json",
            request(
                run,
                actor_role="operator",
                passport_sha256=checkpoint["state"]["current_passport_sha256"],
                narrative_sha256=current,
            ),
        )
        invoke(
            project,
            f"{label}-resume",
            "resume",
            "--run-root",
            "run",
            "--request",
            f"{label}-resume-request.json",
            "--memory-handoff",
            value["memory_id"],
            "--memory-project-root",
            ".",
            "--memory-max-tokens",
            "16384",
        )


def import_case(destination, material, protocol, raw):
    project = destination / material["sample_id"]
    project.mkdir()
    # Labels are deliberately not read by this importer.
    source_status = (
        re.search(rb"^:Status:\s*(\S+)\s*$", raw, re.MULTILINE).group(1).decode()
    )
    if source_status != material["source_status_observation"]:
        raise ValueError("pinned status differs from prepared source observation")
    disposition = protocol["source_status_encoding"][source_status]
    invoke(
        project,
        "project-init",
        "memory",
        "init-project",
        "--project-root",
        ".",
        "--project-id",
        f"pilot.{material['sample_id']}",
    )
    invoke(project, "register", "narrative", "register", "--project-root", ".")
    initial_role = (
        "sample" if disposition in ("kept", "superseded") else "scaffold-baseline"
    )
    write(project / "initial-plan.json", plan(material, initial_role))
    initial = invoke(
        project,
        "select",
        "narrative",
        "select",
        "--project-root",
        ".",
        "--plan",
        "initial-plan.json",
    )
    if disposition in ("unknown", "abandoned", "superseded"):
        role = "successor" if disposition == "superseded" else "sample"
        write(project / "proposal-plan.json", plan(material, role))
        pending = invoke(
            project,
            "propose",
            "narrative",
            "propose",
            "--project-root",
            ".",
            "--plan",
            "proposal-plan.json",
            "--expected-sha256",
            initial["sha256"],
            "--reason",
            f"Public-status import {source_status}; historical_reason=unknown; source_sha256={material['source_sha256']}. This is the pilot operator's replay statement, not an original author's causal explanation.",
        )
        if disposition == "abandoned":
            invoke(
                project,
                "withdraw",
                "narrative",
                "withdraw",
                "--project-root",
                ".",
                "--proposal-sha256",
                pending["proposal_sha256"],
                "--author-id",
                "pilot.source-replay",
                "--author-confirmed",
                "--reason",
                f"Pilot operator imports explicit public {source_status}; historical_reason=unknown; source_sha256={material['source_sha256']}",
            )
        elif disposition == "superseded":
            invoke(
                project,
                "approve-successor",
                "narrative",
                "approve",
                "--project-root",
                ".",
                "--proposal-sha256",
                pending["proposal_sha256"],
                "--author-id",
                "pilot.source-replay",
                "--author-confirmed",
            )
    exported = invoke(
        project, "trail", "narrative", "trail", "--project-root", ".", "--json"
    )
    selected = [
        c for c in exported["choices"] if "role=sample;" in c["plan"]["rationale"]
    ]
    if len(selected) != 1:
        raise ValueError("sample must bind exactly one real exported choice")
    write(
        project / "source-binding.json",
        {
            "sample_id": material["sample_id"],
            "source_url": material["source_url"],
            "source_sha256": material["source_sha256"],
            "source_status": source_status,
            "source_bytes_verified": True,
            "choice_id": selected[0]["choice_id"],
            "frozen_mapping_sha256": sha256_hex(
                canonical_json_bytes(frozen_protocol(protocol))
            ),
            "confirmation_scope": "Pilot operator imports public disposition; no original-author identity authentication or causal-reason inference",
        },
    )
    if disposition == "abandoned":
        handoff_rounds(project, material, exported["current_choice_ids"][0])
    print(
        f"{material['sample_id']}: source {source_status}, exported {selected[0]['disposition']}",
        flush=True,
    )


def compare(destination):
    """Recompute from canonical journals and actual retained CLI output, not input labels."""
    protocol = read(destination / "inputs/protocol.json")
    materials = read(destination / "inputs/materials.json")["materials"]
    with (destination / "inputs/annotations.csv").open(newline="") as stream:
        annotations = {r["sample_id"]: r for r in csv.DictReader(stream)}
    rows, counts, rounds = [], Counter(), []
    for material in materials:
        project = destination / material["sample_id"]
        binding = read(project / "source-binding.json")
        if binding["source_sha256"] != material["source_sha256"] or binding[
            "frozen_mapping_sha256"
        ] != sha256_hex(canonical_json_bytes(frozen_protocol(protocol))):
            raise ValueError("source/protocol binding differs")
        actual = trail(project)
        if actual != read(project / "commands/trail.stdout"):
            raise ValueError("retained CLI export differs from canonical trail")
        choices = [
            c
            for c in actual["choices"]
            if c["choice_id"] == binding["choice_id"]
            and "role=sample;" in c["plan"]["rationale"]
            and material["source_sha256"] in c["plan"]["rationale"]
        ]
        if len(choices) != 1:
            raise ValueError("source choice binding is unresolved")
        choice = choices[0]
        expected = protocol["source_status_encoding"][binding["source_status"]]
        if choice["disposition"] != expected:
            raise ValueError("actual trail failed the frozen disposition encoding")
        human = annotations[material["sample_id"]]
        if human["reason_status"] != "unknown" or human["human_reason"]:
            raise ValueError(
                "this pilot does not evaluate unconfirmed historical reasons"
            )
        category = (
            "explicit_unknown"
            if "unknown" in (human["human_status"], choice["disposition"])
            else "agreement"
            if human["human_status"] == choice["disposition"]
            else "disagreement"
        )
        counts[category] += 1
        rows.append(
            {
                "sample_id": material["sample_id"],
                "source_url": material["source_url"],
                "source_sha256": material["source_sha256"],
                "source_status": binding["source_status"],
                "human_status": human["human_status"],
                "human_annotation": human["human_annotation"],
                "machine_status": choice["disposition"],
                "comparison": category,
                "human_reason_status": "unknown",
                "historical_reason_evaluation": "not_evaluated",
                "choice_id": choice["choice_id"],
                "history_head_sha256": actual["history_head_sha256"],
                "difference_explanation": "Owner retained this proposal; pinned source records Superseded. Both inputs and frozen mapping preserved."
                if category == "disagreement"
                else None,
            }
        )
        if choice["disposition"] == "abandoned":
            state = replay_run(project / "run")
            if state.recovery_health != "healthy":
                raise ValueError("handoff run needs recovery")
            for number in (1, 2):
                saved = read(project / f"commands/round-{number}-save.stdout")
                resumed = read(project / f"commands/round-{number}-resume.stdout")
                memory_result = ResearchMemoryService(
                    project, run_root=project / "run"
                ).resume_handoff(
                    f"memory.pilot-round-{number}", query=MemoryQuery(max_tokens=16384)
                )
                if memory_result != resumed["memory_handoff"]:
                    raise ValueError(
                        "retained continuation differs from canonical memory"
                    )
                event = next(
                    e
                    for e in state.events
                    if e.event_id
                    == read(project / f"round-{number}-resume-request.json")["event_id"]
                )
                summary = resumed["narrative_trail"]
                if (
                    not resumed["accepted"]
                    or event.event_type != "resume.accepted"
                    or saved["narrative_trail"] != summary
                    or summary != resumed["memory_handoff"]["narrative_trail"]
                ):
                    raise ValueError(
                        "handoff/resume summaries or accepted event differ"
                    )
                if summary["current_choices"][0]["choice_id"] != actual[
                    "current_choice_ids"
                ][0] or choice["choice_id"] not in {
                    c["choice_id"] for c in summary["abandoned_routes"]
                }:
                    raise ValueError("current choice or abandoned notice was lost")
                if (
                    resumed["memory_handoff"]["next_concrete_action"]
                    != "Inspect the retained comparison and unresolved questions"
                    or resumed["memory_handoff"]["requires_reconciliation"]
                ):
                    raise ValueError(
                        "continuation action changed or needs reconciliation"
                    )
                rounds.append(
                    {
                        "sample_id": material["sample_id"],
                        "round": number,
                        "resume_event_sha256": event.event_sha256,
                        "current_choice_id": actual["current_choice_ids"][0],
                        "abandoned_choice_id": choice["choice_id"],
                        "summary_equal": True,
                        "abandoned_notice_present": True,
                        "continuation_scope": "Control-plane context and operator-authored next action; no model recommendation test",
                    }
                )
    return {
        "schema_version": "arw.public-narrative-pilot-report.v1",
        "status": "completed_with_disagreement",
        "sample_count": len(rows),
        "status_counts": {
            k: counts[k] for k in ("agreement", "disagreement", "explicit_unknown")
        },
        "unknown_inclusive_equal_count": sum(
            r["human_status"] == r["machine_status"] for r in rows
        ),
        "historical_reason_assessed_count": 0,
        "human_reason_unknown_count": len(rows),
        "annotation_method": "owner labels after assistant source explanation; not blind independent annotation",
        "scope": "One NumPy convenience sample, operational disposition replay through real ARW CLI; not original authors' research runs, scientific validation, or general accuracy",
        "rows": rows,
        "handoff_resume": rounds,
    }


def inventory(destination):
    return {
        p.relative_to(destination).as_posix(): sha256_hex(p.read_bytes())
        for p in sorted(destination.rglob("*"))
        if p.is_file() and p.name != "inventory.json" and ".sqlite3" not in p.name
    }


def verify(destination):
    for relative, digest in read(destination / "inventory.json").items():
        if (
            sha256_hex(read_retained_bytes(destination, relative, max_bytes=1_048_576))
            != digest
        ):
            raise ValueError(f"retained evidence bytes differ: {relative}")
    result = compare(destination)
    if result != read(destination / "report.json"):
        raise ValueError("report differs from canonical evidence recomputation")
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path)
    parser.add_argument(
        "--source-cache",
        type=Path,
        help="Ten previously downloaded pinned .rst files; hashes are rechecked",
    )
    parser.add_argument(
        "--verify-evidence",
        type=Path,
        help="Offline replay of retained journals, exports, report and byte inventory",
    )
    args = parser.parse_args()
    if args.verify_evidence:
        print(
            json.dumps(
                verify(args.verify_evidence.resolve()), ensure_ascii=False, indent=2
            )
        )
        return
    if not args.output or not args.source_cache:
        parser.error(
            "execution needs --output and --source-cache; verification needs --verify-evidence"
        )
    destination = args.output.absolute()
    if destination.exists():
        parser.error("refusing to overwrite an existing evidence directory")
    materials = read(KIT / "materials.json")["materials"]
    protocol = read(KIT / "protocol.json")
    sources = {}
    for material in materials:
        raw = (args.source_cache / f"{material['sample_id']}.rst").read_bytes()
        if sha256_hex(raw) != material["source_sha256"]:
            raise ValueError("pinned public source digest differs")
        sources[material["sample_id"]] = raw
    destination.mkdir(parents=True)
    for name in (
        "annotations.csv",
        "materials.json",
        "protocol.json",
        "owner-policy-responses.csv",
    ):
        path = destination / "inputs" / name
        path.parent.mkdir(exist_ok=True)
        path.write_bytes((KIT / name).read_bytes())
    write(
        destination / "execution.json",
        {
            "started_at": utc(),
            "python": sys.version,
            "launcher": "bin/arw (local-dev)",
            "plugin_manifest": ".codex-plugin/plugin.json explicitly bound for handoff resume",
            "model_calls": 0,
            "source_bytes_verified": 10,
            "source_files": {
                p: sha256_hex((REPO / p).read_bytes())
                for p in (
                    "scripts/run-public-narrative-pilot",
                    "bin/arw",
                    "src/arw/cli.py",
                    "src/arw/kernel/ledger/narrative.py",
                    "src/arw/kernel/execution/runtime.py",
                    "extensions/research-memory/src/arw_research_memory/service.py",
                )
            },
        },
    )
    for material in materials:
        import_case(destination, material, protocol, sources[material["sample_id"]])
    write(destination / "report.json", compare(destination))
    write(destination / "inventory.json", inventory(destination))
    result = verify(destination)
    print(
        json.dumps(
            {
                "status": result["status"],
                "status_counts": result["status_counts"],
                "handoff_resume_rounds": len(result["handoff_resume"]),
                "evidence": str(destination),
            },
            ensure_ascii=False,
            indent=2,
        )
    )


if __name__ == "__main__":
    main()
