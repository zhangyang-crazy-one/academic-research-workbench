#!/usr/bin/env python3
"""Fail-closed, parent-owned technical verifier for Phase 4.

The verifier deliberately treats command output as evidence, not authority.  The
only case verdicts it emits are computed by a small parent policy table and are
bound to the checked-in corpus and to the retained command/evidence digests.
Host qualification and the human packet are separate gates.
"""

from __future__ import annotations

