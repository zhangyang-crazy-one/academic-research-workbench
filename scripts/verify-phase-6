#!/usr/bin/env python3
"""Serial, fail-closed technical verifier for Phase 6.

The verifier owns one evidence directory and treats every subprocess result as
an input to a parent policy.  It never writes runtime state, runs experiments,
publishes a package, or turns the mixed-license release blocker into a green
release verdict.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


PROJECT_ROOT = Path(__file__).resolve().parents[1]
EVIDENCE_BASE = (PROJECT_ROOT / "build/evidence").resolve()
DEFAULT_EVIDENCE_ROOT = EVIDENCE_BASE / "phase-06"
PHASE_TMP = PROJECT_ROOT / "build/tmp/phase-06"
PYTHON = PROJECT_ROOT / ".venv/bin/python"
MAX_CAPTURE = 512 * 1024
MARKER = ".arw-phase6-evidence"
RELEASE_BLOCKERS = ("SUP-04", "P04-09", "permission_unresolved")
PHASE6_TESTS = (
    "tests/schema/test_phase6_contracts.py",
    "tests/schema/test_schema_drift.py",
    "tests/unit/test_integrity_receipts.py",
    "tests/unit/test_experiment_provenance.py",
    "tests/unit/test_evidence_access.py",
    "tests/unit/test_audit_dossier.py",
    "tests/integration/test_integrity_receipts.py",
    "tests/integration/test_experiment_provenance.py",
    "tests/integration/test_controlled_execution_blocked.py",
    "tests/integration/test_evidence_access_states.py",
    "tests/integration/test_scientific_claim_gates.py",
    "tests/integration/test_audit_dossier_blockers.py",
    "tests/integration/test_audit_dossier_replay.py",
    "tests/property/test_audit_dossier_replay.py",
)
PRIOR_TESTS = (
    "tests/integration/test_human_gates.py",
    "tests/integration/test_orchestration_panels.py",
    "tests/integration/test_graph_authority.py",
    "tests/integration/test_graph_rebuild.py",
    "tests/integration/test_orchestration_replay.py",
)


class VerificationError(RuntimeError):
    pass


def digest_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def digest_file(path: Path) -> str:
    return digest_bytes(path.read_bytes())


def canonical(value: object) -> bytes:
    return (json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(canonical(value))


def run_git(*args: str) -> bytes:
    return subprocess.check_output(["git", *args], cwd=PROJECT_ROOT)


def tree_digest() -> str:
    tracked = run_git("ls-files", "-s")
    status = run_git("status", "--porcelain=v1", "-z")
    return digest_bytes(tracked + b"\0" + status)


def owned_root(raw: Path, *, clean: bool) -> Path:
    candidate = raw.expanduser()
    if not candidate.is_absolute():
        candidate = PROJECT_ROOT / candidate
    candidate = candidate.absolute()
    if candidate == EVIDENCE_BASE or not candidate.is_relative_to(EVIDENCE_BASE):
        raise VerificationError(f"evidence root must be below {EVIDENCE_BASE}")
    current = EVIDENCE_BASE
    for part in candidate.relative_to(EVIDENCE_BASE).parts:
        current /= part
        if current.is_symlink():
            raise VerificationError("evidence root contains a symlink component")
    root = candidate.resolve(strict=False)
    if root == EVIDENCE_BASE or not root.is_relative_to(EVIDENCE_BASE):
        raise VerificationError("evidence root resolves outside evidence base")
    if root.exists():
        if root.is_symlink() or not root.is_dir():
            raise VerificationError("evidence root is unsafe")
        if not clean or not (root / MARKER).is_file():
            raise VerificationError("existing evidence root is not an owned clean root")
        shutil.rmtree(root)
    root.mkdir(parents=True)
    (root / MARKER).write_text("academic-research-workbench phase 6 evidence v1\n", encoding="ascii")
    return root


def command(root: Path, name: str, argv: list[str], *, env: dict[str, str] | None = None) -> dict[str, Any]:
    target = root / "commands" / name
    target.mkdir(parents=True, exist_ok=True)
    environment = os.environ.copy()
    temporary = PHASE_TMP.resolve()
    temporary.mkdir(parents=True, exist_ok=True)
    environment.update({"UV_OFFLINE": "1", "PYTHONNOUSERSITE": "1", "PIP_NO_INDEX": "1", "TMPDIR": str(temporary)})
    if env:
        environment.update(env)
    result = subprocess.run(argv, cwd=PROJECT_ROOT, env=environment, capture_output=True, check=False)
    stdout, stderr = result.stdout[:MAX_CAPTURE], result.stderr[:MAX_CAPTURE]
    (target / "stdout.log").write_bytes(stdout)
    (target / "stderr.log").write_bytes(stderr)
    payload: dict[str, Any] = {
        "argv": argv,
        "cwd": str(PROJECT_ROOT),
        "returncode": result.returncode,
        "stdout_sha256": digest_bytes(stdout),
        "stderr_sha256": digest_bytes(stderr),
        "stdout_truncated": len(result.stdout) > len(stdout),
        "stderr_truncated": len(result.stderr) > len(stderr),
    }
    write_json(target / "result.json", payload)
    if result.returncode != 0:
        raise VerificationError(f"{name} failed with exit {result.returncode}")
    text = (stdout + b"\n" + stderr).decode("utf-8", "replace").lower()
    # A green verifier must never launder skipped, xfailed, or xpassed tests.
    if re.search(r"\b(?:skipped|xfailed|xpassed)\b", text):
        raise VerificationError(f"{name} reported skipped/xfail evidence")
    return payload


def observed_identities(root: Path) -> dict[str, Any]:
    def optional(path: Path) -> dict[str, Any]:
        return {"path": str(path), "sha256": digest_file(path)} if path.is_file() else {"path": str(path), "missing": True}

    locks = sorted(EVIDENCE_BASE.glob("phase-04.1-host-canary-*/integration-lock.json"))
    lock = locks[-1] if locks else None
    identity = {
        "git_head": run_git("rev-parse", "HEAD").decode().strip(),
        "git_dirty": bool(run_git("status", "--porcelain=v1")),
        "tree_sha256": tree_digest(),
        "python": sys.version,
        "python_executable": str(PYTHON),
        "schema_registry": optional(PROJECT_ROOT / "src/arw/schema_registry.py"),
        "schema_tree_sha256": digest_bytes(b"".join(digest_file(p).encode() for p in sorted((PROJECT_ROOT / "schemas/v1").glob("*.json")))),
        "source_manifest": optional(PROJECT_ROOT / "vendor/source-manifest.json"),
        "sbom": optional(PROJECT_ROOT / "SBOM.cdx.json"),
        "wheelhouse_lock": optional(PROJECT_ROOT / "vendor/python/wheelhouse.lock.json"),
        "integration_lock": optional(lock) if lock else {"missing": True},
        "codex_cli": "unavailable",
        "observed_at": datetime.now(UTC).isoformat().replace("+00:00", "Z"),
    }
    try:
        identity["codex_cli"] = subprocess.check_output(["codex", "--version"], cwd=PROJECT_ROOT, stderr=subprocess.STDOUT, timeout=10).decode("utf-8", "replace").strip()[:256]
    except (OSError, subprocess.SubprocessError):
        pass
    write_json(root / "identities.json", identity)
    return identity


def stage_inventory(root: Path, stage: Path) -> dict[str, Any]:
    if not stage.is_dir() or stage.is_symlink():
        raise VerificationError("staged plugin is missing or unsafe")
    paths: list[dict[str, str]] = []
    for path in sorted(stage.rglob("*"), key=lambda p: p.relative_to(stage).as_posix()):
        if path.is_symlink():
            raise VerificationError(f"symlink in stage: {path.relative_to(stage)}")
        if path.is_file():
            relative = path.relative_to(stage).as_posix()
            if re.search(r"(^|/)(?:runs?|papers?|private|credentials?|receipts?|indexes?|generations?|extractions?)(?:/|$)|\.(?:db|sqlite3?|pem|key)$", relative, re.I):
                raise VerificationError(f"private/generated payload in stage: {relative}")
            paths.append({"path": relative, "sha256": digest_file(path)})
    required = {
        "scripts/verify-phase-6",
        "docs/runtime/scientific-integrity.md",
        "schemas/v1/audit-dossier.schema.json",
        "share/arw/schemas/audit-dossier.schema.json",
        "share/arw/build-identity.json",
        "supply-chain/stage-inventory.json",
    }
    actual = {item["path"] for item in paths}
    if not required <= actual:
        raise VerificationError(f"stage missing required artifacts: {sorted(required - actual)}")
    payload = {"stage": str(stage), "files": paths, "tree_sha256": digest_bytes(canonical(paths))}
    write_json(root / "stage-tree.json", payload)
    return payload


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--clean", action="store_true")
    parser.add_argument("--evidence-root", type=Path, default=DEFAULT_EVIDENCE_ROOT)
    args = parser.parse_args()
    root: Path | None = None
    try:
        root = owned_root(args.evidence_root, clean=args.clean)
        write_json(root / "preflight.json", {"schema_version": "1.0.0", "phase": "06", "started_at": datetime.now(UTC).isoformat().replace("+00:00", "Z"), "evidence_root": str(root)})
        identities = observed_identities(root)
        command(root, "source-verification", ["./scripts/verify-sources", "--inputs-only"])
        command(root, "phase6-tests", [str(PYTHON), "-m", "pytest", "-q", "-ra", *PHASE6_TESTS])
        command(root, "prior-phase-regressions", [str(PYTHON), "-m", "pytest", "-q", "-ra", *PRIOR_TESTS])
        stage = PROJECT_ROOT / "build/stage/academic-research-workbench"
        stage_evidence = root / "stage"
        command(root, "stage-build", ["./scripts/stage-plugin", "--clean", "--stage-root", str(stage), "--evidence-root", str(stage_evidence)], env={"ARW_STAGE_TMP_ROOT": str(PHASE_TMP / "stage")})
        command(root, "stage-validate", ["./scripts/stage-plugin", "--stage-root", str(stage), "--validate-only"], env={"ARW_STAGE_TMP_ROOT": str(PHASE_TMP / "stage")})
        stage_payload = stage_inventory(root, stage)
        requirements = {req: {"status": "PASS", "evidence": ["source-verification", "phase6-tests", "prior-phase-regressions", "stage-build", "stage-validate"]} for req in ("SCI-01", "SCI-04", "SCI-05", "SCI-06", "SCI-07", "VER-07")}
        verdict = {
            "schema_version": "1.0.0",
            "phase": "06",
            "technical_qualification": "PASS",
            "release_qualification": "BLOCKED",
            "release_blockers": list(RELEASE_BLOCKERS),
            "requirements": requirements,
            "identities": identities,
            "stage_tree_sha256": stage_payload["tree_sha256"],
            "evidence_root": str(root),
        }
        write_json(root / "requirements.json", requirements)
        write_json(root / "verdict.json", verdict)
        write_json(root / "summary.json", {"technical_qualification": "PASS", "release_qualification": "BLOCKED", "release_blockers": list(RELEASE_BLOCKERS), "stage_tree_sha256": stage_payload["tree_sha256"]})
        return 0
    except (OSError, subprocess.SubprocessError, VerificationError) as error:
        if root is not None:
            write_json(root / "verdict.json", {"schema_version": "1.0.0", "phase": "06", "technical_qualification": "BLOCKED", "release_qualification": "BLOCKED", "release_blockers": list(RELEASE_BLOCKERS), "error": str(error), "evidence_root": str(root)})
        print(f"verify-phase-6: {error}", file=sys.stderr)
        return 70


if __name__ == "__main__":
    raise SystemExit(main())
