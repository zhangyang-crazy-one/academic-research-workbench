#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ROOT="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CBM_BIN="$PLUGIN_ROOT/libexec/file-base-mcp"

if [[ -n "${ARW_FILES_CONTROL_ROOT:-}" || -n "${ARW_FILES_ROOT_ID:-}" ]]; then
  [[ -n "${ARW_FILES_CONTROL_ROOT:-}" && -n "${ARW_FILES_ROOT_ID:-}" ]] \
    || { printf 'file-base-mcp: ARW files mode requires control root and root ID\n' >&2; exit 64; }
  [[ "$ARW_FILES_CONTROL_ROOT" == /* ]] \
    || { printf 'file-base-mcp: ARW_FILES_CONTROL_ROOT must be absolute\n' >&2; exit 64; }
  [[ -d "$ARW_FILES_CONTROL_ROOT" && ! -L "$ARW_FILES_CONTROL_ROOT" ]] \
    || { printf 'file-base-mcp: ARW_FILES_CONTROL_ROOT must be a non-symlink directory\n' >&2; exit 66; }
  [[ "$ARW_FILES_ROOT_ID" =~ ^[a-z][a-z0-9._-]{2,127}$ ]] \
    || { printf 'file-base-mcp: ARW_FILES_ROOT_ID is invalid\n' >&2; exit 64; }
  unset PYTHONPATH PYTHONHOME VIRTUAL_ENV LD_PRELOAD
  export PYTHONDONTWRITEBYTECODE=1
  # Legacy compatibility is preserved ONLY when the operator explicitly
  # selects the v1 reader (ARW_FILES_LEGACY_READER=1); default dispatch
  # goes through the store-backed MCP, which is the production read path.
  # The store MCP is the single source of truth for capability gating,
  # root anchoring, and the store-absent signal (STORE_ABSENT, exit 69)
  # surfaced before stdin consumption; we do NOT fall back on generic
  # 78, capability denial, root mismatch, corruption, or after transport
  # has started.
  if [[ "${ARW_FILES_LEGACY_READER:-}" == "1" ]]; then
    exec "$PLUGIN_ROOT/bin/arw" _files-mcp \
      --control-root "$ARW_FILES_CONTROL_ROOT" --root-id "$ARW_FILES_ROOT_ID"
  fi
  # Dispatch into the store-backed MCP first.  When it returns
  # STORE_ABSENT (exit 69 — store file absent on disk, signaled
  # pre-stdin by the server itself) the shim falls back to the v1
  # reader so first-run deployments that have not yet populated a
  # projection keep working.  Any other non-zero exit is propagated
  # verbatim — those signal configuration/security failures and
  # must never silently route through an undeclared reader.
  store_args=(--control-root "$ARW_FILES_CONTROL_ROOT" --root-id "$ARW_FILES_ROOT_ID")
  if [[ -n "${ARW_FILES_STORE:-}" ]]; then
    # Operator-supplied explicit store path; otherwise the store MCP
    # resolves the per-user cache keyed by the registered canonical root.
    store_args+=(--store "$ARW_FILES_STORE")
  fi
  # ``set -e`` would otherwise exit the shim on the store MCP's
  # non-zero status before we can branch on STORE_ABSENT (69).  The
  # legacy-compatibility fallback path is the only place where a
  # non-zero exit is allowed to influence routing.
  set +e
  "$PLUGIN_ROOT/bin/arw" _files-store-mcp "${store_args[@]}" "$@"
  status=$?
  set -e
  if [[ $status -eq 69 ]]; then
    exec "$PLUGIN_ROOT/bin/arw" _files-mcp \
      --control-root "$ARW_FILES_CONTROL_ROOT" --root-id "$ARW_FILES_ROOT_ID" "$@"
  fi
  exit $status
fi

missing=()
for name in CBM_ALLOWED_ROOT CBM_ALLOWED_ROOT_ID CBM_CACHE_DIR; do
  if [[ -z "${!name:-}" ]]; then
    missing+=("$name")
  fi
done
if [[ "${#missing[@]}" -ne 0 ]]; then
  printf 'file-base-mcp: explicit configuration required: %s\n' "${missing[*]}" >&2
  exit 64
fi

[[ "$CBM_ALLOWED_ROOT" == /* ]] \
  || { printf 'file-base-mcp: CBM_ALLOWED_ROOT must be absolute\n' >&2; exit 64; }
[[ -d "$CBM_ALLOWED_ROOT" && ! -L "$CBM_ALLOWED_ROOT" ]] \
  || { printf 'file-base-mcp: CBM_ALLOWED_ROOT must be a non-symlink directory\n' >&2; exit 66; }
[[ "$CBM_ALLOWED_ROOT_ID" =~ ^[A-Za-z0-9._-]{1,64}$ ]] \
  || { printf 'file-base-mcp: CBM_ALLOWED_ROOT_ID is invalid\n' >&2; exit 64; }
[[ "$CBM_CACHE_DIR" == /* ]] \
  || { printf 'file-base-mcp: CBM_CACHE_DIR must be absolute\n' >&2; exit 64; }

mkdir -p -- "$CBM_CACHE_DIR"
[[ -d "$CBM_CACHE_DIR" && ! -L "$CBM_CACHE_DIR" ]] \
  || { printf 'file-base-mcp: CBM_CACHE_DIR must be a non-symlink directory\n' >&2; exit 66; }
[[ -x "$CBM_BIN" ]] \
  || { printf 'file-base-mcp: installed native executable is missing\n' >&2; exit 127; }

export CBM_DISABLE_UPDATE_CHECK="${CBM_DISABLE_UPDATE_CHECK:-1}"
export CBM_LOG_LEVEL="${CBM_LOG_LEVEL:-warn}"
unset PYTHONPATH
exec "$CBM_BIN" "$@"
