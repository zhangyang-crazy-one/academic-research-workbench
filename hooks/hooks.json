{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/arw_hook.py\"",
            "timeout": 10,
            "statusMessage": "Loading observational workbench routing context"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/arw_hook.py\"",
            "timeout": 10,
            "statusMessage": "Checking the bounded subagent observation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/arw_hook.py\"",
            "timeout": 10,
            "statusMessage": "Checking the bounded parent continuation"
          }
        ]
      }
    ]
  }
}
