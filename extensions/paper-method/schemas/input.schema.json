{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-research-workbench.local/schemas/paper-method/stable-matching-input.v1.json",
  "type": "object",
  "required": ["proposers", "receivers"],
  "additionalProperties": false,
  "properties": {
    "proposers": {"$ref": "#/$defs/rankings"},
    "receivers": {"$ref": "#/$defs/rankings"}
  },
  "$defs": {
    "rankings": {
      "type": "object", "minProperties": 1, "maxProperties": 64,
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]{0,31}$": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"}
        }
      },
      "additionalProperties": false
    }
  }
}
