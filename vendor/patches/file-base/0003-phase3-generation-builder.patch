+/* Parent-only immutable-generation publication gate. This command is not an
+ * MCP tool and opens the candidate database read-only. */
+static int files_build_error(const char *code, const char *message) {
+    (void)fprintf(stderr, "file-base: files-build: %s: %s\n", code, message);
+    return 65;
+}
+
+#ifndef _WIN32
+static bool files_build_real_directory(const char *path, char resolved[PATH_MAX]) {
+    struct stat metadata;
+    return path && lstat(path, &metadata) == 0 && S_ISDIR(metadata.st_mode) &&
+           !S_ISLNK(metadata.st_mode) && realpath(path, resolved) != NULL;
+}
+
+static bool files_build_regular_file(const char *path) {
+    struct stat metadata;
+    return lstat(path, &metadata) == 0 && S_ISREG(metadata.st_mode) &&
+           !S_ISLNK(metadata.st_mode);
+}
+
+static bool files_build_below(const char *child, const char *parent) {
+    size_t length = strlen(parent);
+    size_t child_length = strlen(child);
+    return child_length > length && strncmp(child, parent, length) == 0 && child[length] == '/';
+}
+
+static int files_build_check_database(const char *path) {
+    sqlite3 *database = NULL;
+    sqlite3_stmt *statement = NULL;
+    int status = sqlite3_open_v2(path, &database, SQLITE_OPEN_READONLY, NULL);
+    if (status != SQLITE_OK) {
+        if (database) {
+            sqlite3_close(database);
+        }
+        return files_build_error("database_open_failed", "candidate database is not readable");
+    }
+    status = sqlite3_prepare_v2(database, "PRAGMA integrity_check", -1, &statement, NULL);
+    if (status != SQLITE_OK || sqlite3_step(statement) != SQLITE_ROW ||
+        strcmp((const char *)sqlite3_column_text(statement, 0), "ok") != 0) {
+        sqlite3_finalize(statement);
+        sqlite3_close(database);
+        return files_build_error("database_integrity_failed", "SQLite integrity check failed");
+    }
+    sqlite3_finalize(statement);
+    statement = NULL;
+    status = sqlite3_prepare_v2(
+        database,
+        "SELECT count(*) FROM sqlite_master WHERE type='table' AND name IN ('files','files_fts')",
+        -1, &statement, NULL);
+    if (status != SQLITE_OK || sqlite3_step(statement) != SQLITE_ROW ||
+        sqlite3_column_int(statement, 0) != 2) {
+        sqlite3_finalize(statement);
+        sqlite3_close(database);
+        return files_build_error("database_contract_failed", "required files tables are absent");
+    }
+    sqlite3_finalize(statement);
+    if (sqlite3_close(database) != SQLITE_OK) {
+        return files_build_error("database_close_failed", "candidate database did not close cleanly");
+    }
+    return 0;
+}
+#endif
+
+static int run_files_build(int argc, char **argv) {
+#ifdef _WIN32
+    (void)argc;
+    (void)argv;
+    return files_build_error("unsupported_platform", "files-build requires POSIX no-follow checks");
+#else
+    const char *root = NULL;
+    const char *candidate = NULL;
+    for (int index = 0; index < argc; index += 2) {
+        if (index + 1 >= argc) {
+            return files_build_error("invalid_arguments", "options require values");
+        }
+        if (strcmp(argv[index], "--root") == 0 && !root) {
+            root = argv[index + 1];
+        } else if (strcmp(argv[index], "--candidate") == 0 && !candidate) {
+            candidate = argv[index + 1];
+        } else {
+            return files_build_error("invalid_arguments", "only one root and candidate are accepted");
+        }
+    }
+    if (argc != 4 || !root || !candidate) {
+        return files_build_error("invalid_arguments", "--root and --candidate are required exactly once");
+    }
+
+    char resolved_root[PATH_MAX];
+    char resolved_candidate[PATH_MAX];
+    if (!files_build_real_directory(root, resolved_root)) {
+        return files_build_error("root_unsafe", "root must be a real accessible directory");
+    }
+    if (!files_build_real_directory(candidate, resolved_candidate)) {
+        return files_build_error("candidate_unsafe", "candidate must be a real accessible directory");
+    }
+    if (files_build_below(resolved_candidate, resolved_root) ||
+        strcmp(resolved_candidate, resolved_root) == 0) {
+        return files_build_error("ownership_violation", "candidate cannot be inside the research root");
+    }
+
+    char database_path[PATH_MAX];
+    char identity_path[PATH_MAX];
+    char generation_path[PATH_MAX];
+    int database_length = snprintf(database_path, sizeof(database_path), "%s/files.sqlite3",
+                                   resolved_candidate);
+    int identity_length = snprintf(identity_path, sizeof(identity_path), "%s/identity-manifest.json",
+                                   resolved_candidate);
+    int generation_length = snprintf(generation_path, sizeof(generation_path),
+                                     "%s/generation-manifest.json", resolved_candidate);
+    if (database_length < 0 || (size_t)database_length >= sizeof(database_path) ||
+        identity_length < 0 || (size_t)identity_length >= sizeof(identity_path) ||
+        generation_length < 0 || (size_t)generation_length >= sizeof(generation_path)) {
+        return files_build_error("path_too_long", "candidate artifact path exceeds PATH_MAX");
+    }
+    if (!files_build_regular_file(database_path) || !files_build_regular_file(identity_path) ||
+        !files_build_regular_file(generation_path)) {
+        return files_build_error("candidate_incomplete", "closed candidate artifacts are absent or unsafe");
+    }
+    int database_status = files_build_check_database(database_path);
+    if (database_status != 0) {
+        return database_status;
+    }
+    (void)printf(
+        "{\"contract_sha256\":\"%s\",\"profile\":\"files-build\","
+        "\"schema_version\":\"%s\",\"status\":\"ok\"}\n",
+        ARW_FILES_CONTRACT_SHA256, ARW_FILES_CONTRACT_VERSION);
+    return 0;
+#endif
+}
