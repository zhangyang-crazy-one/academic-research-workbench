+/* Conservative, dependency-free PDF text test.
+ * This intentionally admits only PDFs whose content stream exposes direct text
+ * drawing operators. Image-only scans and compressed/opaque PDFs do not pass;
+ * a later optional pdftotext-backed path can broaden this without changing the
+ * file-only graph semantics. */
+static bool pdf_has_direct_text(const char *abs_path) {
+    enum {
+        PDF_SAMPLE_MAX = 1024 * 1024,
+        PDF_HEADER_SCAN = 1024,
+        PDF_MIN_TEXT_CHARS = 12,
+        PDF_MIN_TEXT_OPS = 1,
+    };
+    FILE *f = cbm_fopen(abs_path, "rb");
+    if (!f) {
+        return false;
+    }
+    unsigned char *buf = malloc(PDF_SAMPLE_MAX);
+    if (!buf) {
+        (void)fclose(f);
+        return false;
+    }
+    size_t n = fread(buf, SKIP_ONE, PDF_SAMPLE_MAX, f);
+    (void)fclose(f);
+    if (n < 5) {
+        free(buf);
+        return false;
+    }
+    bool has_pdf_header = false;
+    size_t header_limit = n < PDF_HEADER_SCAN ? n : PDF_HEADER_SCAN;
+    for (size_t i = 0; i + 5 <= header_limit; i++) {
+        if (memcmp(buf + i, "%PDF-", 5) == 0) {
+            has_pdf_header = true;
+            break;
+        }
+    }
+    if (!has_pdf_header) {
+        free(buf);
+        return false;
+    }
+
+    bool in_text_object = false;
+    size_t text_chars = 0;
+    int text_ops = 0;
+    for (size_t i = 0; i + SKIP_ONE < n; i++) {
+        if (!in_text_object && buf[i] == 'B' && buf[i + SKIP_ONE] == 'T') {
+            in_text_object = true;
+            i++;
+            continue;
+        }
+        if (in_text_object && buf[i] == 'E' && buf[i + SKIP_ONE] == 'T') {
+            in_text_object = false;
+            i++;
+            continue;
+        }
+        if (!in_text_object) {
+            continue;
+        }
+        if (buf[i] == '(') {
+            text_chars += pdf_count_literal_string(buf, n, &i);
+        } else if (buf[i] == 'T' && (buf[i + SKIP_ONE] == 'j' || buf[i + SKIP_ONE] == 'J')) {
+            text_ops++;
+            i++;
+        } else if (buf[i] == '\'' || buf[i] == '"') {
+            text_ops++;
+        }
+        if (text_chars >= PDF_MIN_TEXT_CHARS && text_ops >= PDF_MIN_TEXT_OPS) {
+            free(buf);
+            return true;
+        }
+    }
+    free(buf);
+    return false;
+}
