+static size_t pdf_count_literal_string(const unsigned char *buf, size_t n, size_t *idx) {
+    size_t i = *idx + SKIP_ONE;
+    size_t count = 0;
+    int depth = 1;
+    bool escaped = false;
+    while (i < n && depth > 0) {
+        unsigned char c = buf[i++];
+        if (escaped) {
+            if (c >= 0x20 && c < 0x7f) {
+                count++;
+            }
+            escaped = false;
+            continue;
+        }
+        if (c == '\\') {
+            escaped = true;
+            continue;
+        }
+        if (c == '(') {
+            depth++;
+            continue;
+        }
+        if (c == ')') {
+            depth--;
+            continue;
+        }
+        if (c >= 0x20 && c < 0x7f) {
+            count++;
+        }
+    }
+    *idx = i;
+    return count;
+}
