+static size_t pdf_count_literal_string(const unsigned char *buf, size_t n, size_t *idx) {
+    size_t i = *idx + SKIP_ONE;
+    size_t count = 0;
+    int depth = 1;
+    bool escaped = false;
+    while (i < n && depth > 0) {
+        unsigned char c = buf[i++];
+        if (escaped) {
+            if (c >= 0x20 && c < 0x7f) {
+                count++;
+            }
+            escaped = false;
+            continue;
+        }
+        if (c == '\\') {
+            escaped = true;
+            continue;
+        }
+        if (c == '(') {
+            depth++;
+            continue;
+        }
+        if (c == ')') {
+            depth--;
+            continue;
+        }
+        if (c >= 0x20 && c < 0x7f) {
+            count++;
+        }
+    }
+    *idx = i;
+    return count;
+}
+
+/* Conservative, dependency-free PDF text test.
+ * This intentionally admits only PDFs whose content stream exposes direct text
+ * drawing operators. Image-only scans and compressed/opaque PDFs do not pass;
+ * a later optional pdftotext-backed path can broaden this without changing the
+ * file-only graph semantics. */
+static bool pdf_has_direct_text(const char *abs_path) {
+    enum {
+        PDF_SAMPLE_MAX = 1024 * 1024,
+        PDF_HEADER_SCAN = 1024,
+        PDF_MIN_TEXT_CHARS = 12,
+        PDF_MIN_TEXT_OPS = 1,
+    };
+    FILE *f = cbm_fopen(abs_path, "rb");
+    if (!f) {
+        return false;
+    }
+    unsigned char *buf = malloc(PDF_SAMPLE_MAX);
+    if (!buf) {
+        (void)fclose(f);
+        return false;
+    }
+    size_t n = fread(buf, SKIP_ONE, PDF_SAMPLE_MAX, f);
+    (void)fclose(f);
+    if (n < 5) {
+        free(buf);
+        return false;
+    }
+    bool has_pdf_header = false;
+    size_t header_limit = n < PDF_HEADER_SCAN ? n : PDF_HEADER_SCAN;
+    for (size_t i = 0; i + 5 <= header_limit; i++) {
+        if (memcmp(buf + i, "%PDF-", 5) == 0) {
+            has_pdf_header = true;
+            break;
+        }
+    }
+    if (!has_pdf_header) {
+        free(buf);
+        return false;
+    }
+
+    bool in_text_object = false;
+    size_t text_chars = 0;
+    int text_ops = 0;
+    for (size_t i = 0; i + SKIP_ONE < n; i++) {
+        if (!in_text_object && buf[i] == 'B' && buf[i + SKIP_ONE] == 'T') {
+            in_text_object = true;
+            i++;
+            continue;
+        }
+        if (in_text_object && buf[i] == 'E' && buf[i + SKIP_ONE] == 'T') {
+            in_text_object = false;
+            i++;
+            continue;
+        }
+        if (!in_text_object) {
+            continue;
+        }
+        if (buf[i] == '(') {
+            text_chars += pdf_count_literal_string(buf, n, &i);
+        } else if (buf[i] == 'T' && (buf[i + SKIP_ONE] == 'j' || buf[i + SKIP_ONE] == 'J')) {
+            text_ops++;
+            i++;
+        } else if (buf[i] == '\'' || buf[i] == '"') {
+            text_ops++;
+        }
+        if (text_chars >= PDF_MIN_TEXT_CHARS && text_ops >= PDF_MIN_TEXT_OPS) {
+            free(buf);
+            return true;
+        }
+    }
+    free(buf);
+    return false;
+}
+
+static bool sample_contains(const unsigned char *buf, size_t n, const char *needle) {
+    size_t m = strlen(needle);
+    if (m == 0 || m > n) {
+        return false;
+    }
+    for (size_t i = 0; i + m <= n; i++) {
+        if (memcmp(buf + i, needle, m) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static CBMLanguage detect_text_fallback_language(const char *abs_path) {
+    enum { TEXT_SAMPLE_MAX = 4096, TEXT_RATIO_MIN = 85 };
+    FILE *f = cbm_fopen(abs_path, "rb");
+    if (!f) {
+        return CBM_LANG_COUNT;
+    }
+    unsigned char buf[TEXT_SAMPLE_MAX];
+    size_t n = fread(buf, SKIP_ONE, sizeof(buf), f);
+    (void)fclose(f);
+    if (n == 0) {
+        return CBM_LANG_COUNT;
+    }
+
+    size_t textish = 0;
+    for (size_t i = 0; i < n; i++) {
+        unsigned char c = buf[i];
+        if (c == '\0') {
+            return CBM_LANG_COUNT;
+        }
+        if (c == '\n' || c == '\r' || c == '\t' || c >= 0x20) {
+            textish++;
+        }
+    }
+    if (textish * 100 < n * TEXT_RATIO_MIN) {
+        return CBM_LANG_COUNT;
+    }
+    if (n >= PAIR_LEN && buf[0] == '#' && buf[SKIP_ONE] == '!' &&
+        (sample_contains(buf, n, "bash") || sample_contains(buf, n, "/sh") ||
+         sample_contains(buf, n, " zsh") || sample_contains(buf, n, "/zsh"))) {
+        return CBM_LANG_BASH;
+    }
+    return CBM_LANG_TEXT;
+}
+
