+static char *handle_read_file(cbm_mcp_server_t *srv, const char *args) {
+    (void)srv;
+    yyjson_doc *doc = args ? yyjson_read(args, strlen(args), 0) : NULL;
+    yyjson_val *root = doc ? yyjson_doc_get_root(doc) : NULL;
+    if (!root || !yyjson_is_obj(root)) {
+        if (doc) {
+            yyjson_doc_free(doc);
+        }
+        return mcp_read_denial(NULL, NULL, "invalid_request", "request must be a JSON object");
+    }
+
+    yyjson_val *schema_value = yyjson_obj_get(root, "schema_version");
+    yyjson_val *allowed_value = yyjson_obj_get(root, "allowed_root");
+    yyjson_val *path_value = yyjson_obj_get(root, "relative_path");
+    yyjson_val *bytes_value = yyjson_obj_get(root, "max_bytes");
+    yyjson_val *lines_value = yyjson_obj_get(root, "max_lines");
+    const char *allowed_root = yyjson_is_str(allowed_value) ? yyjson_get_str(allowed_value) : NULL;
+    const char *relative_path = yyjson_is_str(path_value) ? yyjson_get_str(path_value) : NULL;
+    bool valid_shape = yyjson_obj_size(root) == 5 && yyjson_is_str(schema_value) &&
+                       strcmp(yyjson_get_str(schema_value), "1.0.0") == 0 && allowed_root &&
+                       *allowed_root && strlen(allowed_root) <= 64 && relative_path &&
+                       *relative_path && strlen(relative_path) <= MCP_READ_PATH_MAX &&
+                       yyjson_is_int(bytes_value) && yyjson_is_int(lines_value);
+    if (!valid_shape) {
+        char *result = mcp_read_denial(allowed_root, relative_path, "invalid_request",
+                                       "request fields are missing, unknown, or invalid");
+        yyjson_doc_free(doc);
+        return result;
+    }
+
+    int64_t requested_bytes = yyjson_get_int(bytes_value);
+    int64_t requested_lines = yyjson_get_int(lines_value);
+    if (requested_bytes < 1 || requested_bytes > MCP_READ_MAX_BYTES || requested_lines < 1 ||
+        requested_lines > MCP_READ_MAX_LINES) {
+        char *result = mcp_read_denial(allowed_root, relative_path, "budget_exceeded",
+                                       "requested byte or line budget exceeds the Phase 1 ceiling");
+        yyjson_doc_free(doc);
+        return result;
+    }
+
+    const char *configured_id = getenv("CBM_ALLOWED_ROOT_ID");
+    const char *configured_path = getenv("CBM_ALLOWED_ROOT");
+    if (!configured_id || !*configured_id || !configured_path || configured_path[0] != '/' ||
+        strcmp(allowed_root, configured_id) != 0) {
+        char *result = mcp_read_denial(allowed_root, relative_path, "root_denied",
+                                       "allowed-root capability is not configured");
+        yyjson_doc_free(doc);
+        return result;
+    }
+
+#if !defined(__linux__)
+    char *unsupported = mcp_read_denial(allowed_root, relative_path, "unsupported_platform",
+                                        "Phase 1 confinement is proven only on Linux");
+    yyjson_doc_free(doc);
+    return unsupported;
+#else
+    if (relative_path[0] == '/' || relative_path[0] == '\\' ||
+        (strlen(relative_path) > 1 && relative_path[1] == ':')) {
+        char *result = mcp_read_denial(allowed_root, relative_path, "absolute_path",
+                                       "absolute paths are not permitted");
+        yyjson_doc_free(doc);
+        return result;
+    }
+
+    char path_copy[MCP_READ_PATH_MAX + 1];
+    memcpy(path_copy, relative_path, strlen(relative_path) + 1);
+    int directory_fd = open(configured_path, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (directory_fd < 0) {
+        char *result = mcp_read_denial(allowed_root, relative_path, "root_denied",
+                                       "configured allowed root cannot be opened safely");
+        yyjson_doc_free(doc);
+        return result;
+    }
+
+    char *save = NULL;
+    char *component = strtok_r(path_copy, "/", &save);
+    int file_fd = -1;
+    while (component) {
+        if (strcmp(component, "..") == 0) {
+            close(directory_fd);
+            char *result = mcp_read_denial(allowed_root, relative_path, "path_traversal",
+                                           "parent traversal is not permitted");
+            yyjson_doc_free(doc);
+            return result;
+        }
+        if (strcmp(component, ".") == 0 || *component == '\0') {
+            close(directory_fd);
+            char *result = mcp_read_denial(allowed_root, relative_path, "invalid_request",
+                                           "path components must name a file beneath the root");
+            yyjson_doc_free(doc);
+            return result;
+        }
+        if (mcp_read_sensitive_component(component)) {
+            close(directory_fd);
+            char *result = mcp_read_denial(allowed_root, relative_path, "sensitive_path",
+                                           "sensitive path names are not readable");
+            yyjson_doc_free(doc);
+            return result;
+        }
+
+        char *next_component = strtok_r(NULL, "/", &save);
+        struct stat entry_stat;
+        if (fstatat(directory_fd, component, &entry_stat, AT_SYMLINK_NOFOLLOW) != 0) {
+            const char *reason = errno == ELOOP ? "symlink_escape" : "not_found";
+            close(directory_fd);
+            char *result = mcp_read_denial(allowed_root, relative_path, reason,
+                                           "path cannot be resolved beneath the allowed root");
+            yyjson_doc_free(doc);
+            return result;
+        }
+        if (S_ISLNK(entry_stat.st_mode)) {
+            close(directory_fd);
+            char *result = mcp_read_denial(allowed_root, relative_path, "symlink_escape",
+                                           "symbolic links are not followed");
+            yyjson_doc_free(doc);
+            return result;
+        }
+
+        if (next_component) {
+            if (!S_ISDIR(entry_stat.st_mode)) {
+                close(directory_fd);
+                char *result = mcp_read_denial(allowed_root, relative_path, "not_regular_file",
+                                               "intermediate path component is not a directory");
+                yyjson_doc_free(doc);
+                return result;
+            }
+            int next_fd = openat(directory_fd, component,
+                                 O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+            if (next_fd < 0) {
+                close(directory_fd);
+                char *result = mcp_read_denial(allowed_root, relative_path, "symlink_escape",
+                                               "directory component changed during safe open");
+                yyjson_doc_free(doc);
+                return result;
+            }
+            close(directory_fd);
+            directory_fd = next_fd;
+        } else {
+            if (!S_ISREG(entry_stat.st_mode)) {
+                close(directory_fd);
+                char *result = mcp_read_denial(allowed_root, relative_path, "not_regular_file",
+                                               "final path is not a regular file");
+                yyjson_doc_free(doc);
+                return result;
+            }
+            file_fd = openat(directory_fd, component, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+            close(directory_fd);
+            directory_fd = -1;
+            if (file_fd < 0) {
+                char *result = mcp_read_denial(allowed_root, relative_path, "symlink_escape",
+                                               "file changed during safe open");
+                yyjson_doc_free(doc);
+                return result;
+            }
+            struct stat opened_stat;
+            if (fstat(file_fd, &opened_stat) != 0 || !S_ISREG(opened_stat.st_mode)) {
+                close(file_fd);
+                char *result = mcp_read_denial(allowed_root, relative_path, "not_regular_file",
+                                               "opened target is not a regular file");
+                yyjson_doc_free(doc);
+                return result;
+            }
+        }
+        component = next_component;
+    }
+
+    if (file_fd < 0) {
+        close(directory_fd);
+        char *result = mcp_read_denial(allowed_root, relative_path, "invalid_request",
+                                       "relative path does not name a file");
+        yyjson_doc_free(doc);
+        return result;
+    }
+
+    char content[MCP_READ_MAX_BYTES + 1];
+    size_t bytes_read = 0;
+    int complete_lines = 0;
+    bool read_failed = false;
+    while (bytes_read < (size_t)requested_bytes && complete_lines < (int)requested_lines) {
+        unsigned char byte = 0;
+        ssize_t count = read(file_fd, &byte, 1);
+        if (count == 0) {
+            break;
+        }
+        if (count < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            read_failed = true;
+            break;
+        }
+        content[bytes_read++] = (char)byte;
+        if (byte == '\n') {
+            complete_lines++;
+        }
+    }
+    unsigned char extra = 0;
+    ssize_t extra_count = read_failed ? -1 : read(file_fd, &extra, 1);
+    close(file_fd);
+    if (read_failed || extra_count < 0) {
+        char *result = mcp_read_denial(allowed_root, relative_path, "invalid_request",
+                                       "file read failed before content could be returned");
+        yyjson_doc_free(doc);
+        return result;
+    }
+    if (!mcp_read_valid_utf8((const unsigned char *)content, bytes_read)) {
+        char *result = mcp_read_denial(allowed_root, relative_path, "invalid_request",
+                                       "file content is not bounded UTF-8 text");
+        yyjson_doc_free(doc);
+        return result;
+    }
+    content[bytes_read] = '\0';
+    int lines_read = complete_lines;
+    if (bytes_read > 0 && content[bytes_read - 1] != '\n') {
+        lines_read++;
+    }
+    char *result = mcp_read_success(allowed_root, relative_path, content, bytes_read, lines_read,
+                                    extra_count > 0);
+    yyjson_doc_free(doc);
+    return result;
+#endif
+}
