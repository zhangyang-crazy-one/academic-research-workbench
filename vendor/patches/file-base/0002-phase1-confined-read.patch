+/* ── read_file (Phase 1 confined native read) ─────────────────── */
+
+static char *mcp_read_denial(const char *allowed_root, const char *relative_path,
+                             const char *reason, const char *message) {
+    yyjson_mut_doc *doc = yyjson_mut_doc_new(NULL);
+    yyjson_mut_val *root = yyjson_mut_obj(doc);
+    yyjson_mut_doc_set_root(doc, root);
+    yyjson_mut_obj_add_str(doc, root, "schema_version", "1.0.0");
+    yyjson_mut_obj_add_str(doc, root, "status", "denied");
+    yyjson_mut_obj_add_str(doc, root, "error_type", "access_denied");
+    yyjson_mut_obj_add_str(doc, root, "reason", reason);
+    yyjson_mut_obj_add_str(doc, root, "message", message);
+    yyjson_mut_obj_add_str(doc, root, "allowed_root",
+                           allowed_root && *allowed_root ? allowed_root : "<invalid>");
+    yyjson_mut_obj_add_str(doc, root, "relative_path",
+                           relative_path && *relative_path ? relative_path : "<invalid>");
+#if defined(__linux__)
+    yyjson_mut_obj_add_str(doc, root, "platform_claim", "linux");
+#else
+    yyjson_mut_obj_add_str(doc, root, "platform_claim", "unproven");
+#endif
+    char *json = yy_doc_to_str(doc);
+    yyjson_mut_doc_free(doc);
+    char *result = cbm_mcp_text_result(json, false);
+    free(json);
+    return result;
+}
+
+static bool mcp_read_ascii_equal(const char *left, const char *right) {
+    if (!left || !right) {
+        return false;
+    }
+    while (*left && *right) {
+        unsigned char l = (unsigned char)*left++;
+        unsigned char r = (unsigned char)*right++;
+        if (l >= 'A' && l <= 'Z') {
+            l = (unsigned char)(l - 'A' + 'a');
+        }
+        if (r >= 'A' && r <= 'Z') {
+            r = (unsigned char)(r - 'A' + 'a');
+        }
+        if (l != r) {
+            return false;
+        }
+    }
+    return *left == '\0' && *right == '\0';
+}
+
+static bool mcp_read_ascii_ends_with(const char *value, const char *suffix) {
+    size_t value_len = strlen(value);
+    size_t suffix_len = strlen(suffix);
+    return value_len >= suffix_len &&
+           mcp_read_ascii_equal(value + value_len - suffix_len, suffix);
+}
+
+static bool mcp_read_ascii_starts_with(const char *value, const char *prefix) {
+    size_t value_len = strlen(value);
+    size_t prefix_len = strlen(prefix);
+    if (value_len < prefix_len) {
+        return false;
+    }
+    for (size_t index = 0; index < prefix_len; index++) {
+        unsigned char left = (unsigned char)value[index];
+        unsigned char right = (unsigned char)prefix[index];
+        if (left >= 'A' && left <= 'Z') {
+            left = (unsigned char)(left - 'A' + 'a');
+        }
+        if (right >= 'A' && right <= 'Z') {
+            right = (unsigned char)(right - 'A' + 'a');
+        }
+        if (left != right) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool mcp_read_sensitive_component(const char *component) {
+    if (mcp_read_ascii_equal(component, ".env") ||
+        mcp_read_ascii_starts_with(component, ".env.") ||
+        mcp_read_ascii_equal(component, ".git") || mcp_read_ascii_equal(component, ".ssh") ||
+        mcp_read_ascii_equal(component, "credential") ||
+        mcp_read_ascii_equal(component, "credentials") ||
+        mcp_read_ascii_equal(component, "secret") || mcp_read_ascii_equal(component, "secrets")) {
+        return true;
+    }
+    return mcp_read_ascii_ends_with(component, ".key") ||
+           mcp_read_ascii_ends_with(component, ".pem") ||
+           mcp_read_ascii_ends_with(component, ".p12");
+}
+
+static bool mcp_read_valid_utf8(const unsigned char *value, size_t length) {
+    size_t i = 0;
+    while (i < length) {
+        unsigned char first = value[i++];
+        if (first == 0) {
+            return false;
+        }
+        if (first < 0x80) {
+            continue;
+        }
+        int continuation = 0;
+        uint32_t codepoint = 0;
+        uint32_t minimum = 0;
+        if (first >= 0xC2 && first <= 0xDF) {
+            continuation = 1;
+            codepoint = (uint32_t)(first & 0x1F);
+            minimum = 0x80;
+        } else if (first >= 0xE0 && first <= 0xEF) {
+            continuation = 2;
+            codepoint = (uint32_t)(first & 0x0F);
+            minimum = 0x800;
+        } else if (first >= 0xF0 && first <= 0xF4) {
+            continuation = 3;
+            codepoint = (uint32_t)(first & 0x07);
+            minimum = 0x10000;
+        } else {
+            return false;
+        }
+        if (i + (size_t)continuation > length) {
+            return false;
+        }
+        for (int index = 0; index < continuation; index++) {
+            unsigned char next = value[i++];
+            if ((next & 0xC0) != 0x80) {
+                return false;
+            }
+            codepoint = (codepoint << 6) | (uint32_t)(next & 0x3F);
+        }
+        if (codepoint < minimum || codepoint > 0x10FFFF ||
+            (codepoint >= 0xD800 && codepoint <= 0xDFFF)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static char *mcp_read_success(const char *allowed_root, const char *relative_path,
+                              const char *content, size_t bytes_read, int lines_read,
+                              bool truncated) {
+    yyjson_mut_doc *doc = yyjson_mut_doc_new(NULL);
+    yyjson_mut_val *root = yyjson_mut_obj(doc);
+    yyjson_mut_doc_set_root(doc, root);
+    yyjson_mut_obj_add_str(doc, root, "schema_version", "1.0.0");
+    yyjson_mut_obj_add_str(doc, root, "status", "ok");
+    yyjson_mut_obj_add_str(doc, root, "allowed_root", allowed_root);
+    yyjson_mut_obj_add_str(doc, root, "relative_path", relative_path);
+    yyjson_mut_obj_add_str(doc, root, "content", content);
+    yyjson_mut_obj_add_uint(doc, root, "bytes_read", bytes_read);
+    yyjson_mut_obj_add_int(doc, root, "lines_read", lines_read);
+    yyjson_mut_obj_add_bool(doc, root, "truncated", truncated);
+    yyjson_mut_obj_add_str(doc, root, "platform_claim", "linux");
+    char *json = yy_doc_to_str(doc);
+    yyjson_mut_doc_free(doc);
+    char *result = cbm_mcp_text_result(json, false);
+    free(json);
+    return result;
+}
